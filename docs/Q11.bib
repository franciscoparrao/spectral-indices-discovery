@article{ WOS:000085977700007,
Author = {Cloutis, EA and Bell, JF III},
Title = {Diaspores and related hydroxides: Spectral-compositional properties and
   implications for Mars},
Journal = {JOURNAL OF GEOPHYSICAL RESEARCH-PLANETS},
Year = {2000},
Volume = {105},
Number = {E3},
Pages = {7053-7070},
Month = {MAR 25},
Abstract = {Differences in spectral reflectance properties (0.3-26 mu m) of a suite
   of metal hydroxides (gibbsite, bohmite, diaspore, goethite, and
   manganite) have been found to be a function of both structural and
   compositional differences between these minerals. The properties of the
   O-H stretching fundamental bands in particular can be used to identify
   the presence of these minerals and to discriminate isostructural and
   heteromorphous species. This is due ro the fact that the O-H stretching
   fundamental bands are very intense in these minerals and occur at longer
   wavelengths than those of other minerals, and also due to the fact that
   these metal hydroxides lack strong absorption bands at shorter
   wavelengths. In the case of dimorphous minerals such as bohmite
   (gamma-AlO(OH)) and diaspore (alpha-AlO(OH)), differences in the
   wavelength positions of O-H stretching fundamental bands can be of the:
   order of 0.1-0.3 mu m. Reflectance spectra of metal hydroxide-bearing
   ``ores{''} (bauxites) and impure samples indicate that accessory phases,
   in particular iron-bearing minerals, have a more pronounced effect on
   spectral reflectance toward shorter wavelengths. Intimate mixtures of
   diaspore + orthopyroxene indicate that diaspore abundances as low as 5
   wt \% (or less) can be detected by the appearance of characteristic
   absorption bands at 3.33 and 3.41 mu m. This finding has particular
   relevance to the: study of near-infrared spectra of Mars, in that the
   conditions which favor diaspore formation un thr Earth may have also
   barn prevalent early in Mars history if diaspore did form on Mars in the
   past, it is likely to have persisted to the present.},
Type = {Review},
DOI = {10.1029/1999JE001188},
Keywords-Plus = {IRON-OXIDES; PHYSICOCHEMICAL PROPERTIES; ALTERATION MINERALS; HEMATITE;
   SURFACE; SOILS; SPECTROSCOPY; REFLECTANCE; MOSSBAUER; GOETHITE},
