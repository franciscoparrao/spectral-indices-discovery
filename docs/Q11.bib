@article{ WOS:000723102600002,
Author = {Crotteau, Molly A. and Greenberger, Rebecca N. and Ehlmann, Bethany L.
   and Rossman, George R. and Harris, Michelle and Kelemen, Peter B. and
   Teagle, Damon A. H. and Oman Drilling Project Phase 1 Sci},
Title = {Characterizing Hydration of the Ocean Crust Using Shortwave Infrared
   Microimaging Spectroscopy of ICDP Oman Drilling Project Cores},
Journal = {JOURNAL OF GEOPHYSICAL RESEARCH-SOLID EARTH},
Year = {2021},
Volume = {126},
Number = {11},
Month = {NOV},
Abstract = {Although ocean crust covers over 60\% of Earth's surface, the processes
   that form, cool, and alter the ocean crust are not completely
   understood. We utilize shortwave infrared micro-imaging spectroscopy of
   similar to 1.2 km of rock cored by the International Continental
   Scientific Drilling Program's Oman Drilling Project to quantify
   hydration of basaltic dikes and gabbros from the Samail ophiolite as a
   function of depth, mineralogy and deformation. We develop a regression
   (R-2 = 0.66) between area of the similar to 1,350-1,650 nm OH/H2O
   absorption and measurements of loss on ignition of samples and apply
   this relationship to generate quantitative similar to 250 mu m/pixel
   hydration maps for all cores. The lowest mean hydration is observed in
   the most pervasively altered dike-gabbro boundary (GT3A, H2Omean = 2.1
   +/- 1.6 wt\%), consistent with the low H2O content of the dominant
   alteration minerals, amphibole and epidote. The highest H2O content
   occurs in deeper foliated and layered gabbros (GT2A, H2Omean = 3.2 +/-
   3.0 wt\%) and layered gabbros (GT1A, H2Omean = 2.8 +/- 3.1 wt\%). The
   greater prevalence with depth of zeolite alteration as opposed to lower
   wt\% H2O amphibole at shallow stratigraphic depths, as well as the
   occurrence of zones of intensive hydration associated with fault zones
   (H2Omean = 5.7 +/- 4.0 wt\%) lead to greater hydration of the lower
   ocean crust. This new approach provides an objective quantification of
   hydration in these cores, enabling an improved understanding of
   quantities and characteristics of ocean crust hydration. It highlights
   the importance of specific phases and faulting in controlling hydration,
   which has implications for ocean crust cooling, rheological properties,
   and the role of alteration in global biogeochemical cycling.},
Type = {Article},
DOI = {10.1029/2021JB022676},
Article-Number = {e2021JB022676},
Keywords = {Oman Drilling Project; ocean crust; ophiolite; crustal hydration; water
   quantification; infrared imaging spectroscopy},
Keywords-Plus = {SAMAIL OPHIOLITE; REFLECTANCE SPECTROSCOPY; HYDROTHERMAL ALTERATION;
   WATER-CONTENT; ISOTOPE GEOCHEMISTRY; HESS DEEP; TRACE OH; MANTLE;
   MINERALS; ROCKS},
Research-Areas = {Geochemistry \& Geophysics},
Cited-References = {A'Shaikh D, 2006, RESOUR GEOL, V56, P167, DOI 10.1111/j.1751-3928.2006.tb00277.x.
