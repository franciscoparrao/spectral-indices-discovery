@article{ WOS:001134482700001,
Author = {Kraal, Kurt O. and Ayling, Bridget F. and Deoreo, Stephen and Calvin,
   Wendy M.},
Title = {Infrared spectroscopy as a tool for hydrothermal alteration mineral
   analysis to support geothermal reservoir characterization at The
   Geysers, California, USA},
Journal = {JOURNAL OF VOLCANOLOGY AND GEOTHERMAL RESEARCH},
Year = {2024},
Volume = {445},
Month = {JAN},
Abstract = {Infrared reflectance spectroscopy (IRS), an analytical method for
   characterizing geologic materials, is becoming more commonly applied to
   geothermal energy applications. However, few case studies are available
   in the literature and are restricted to relatively few volcanic/geologic
   environments. We present an interpretation of reservoir mineralogy using
   IRS on drill cuttings from an active magmatic-heat-sourced geothermal
   system hosted in metamorphic rocks known as ``The Geysers{''}, located
   in northern California and operated by Calpine Corp. Wavelength ranges
   investigated include the Short Wave Infrared (SWIR; 1000-2500 nm) and
   the Long Wave Infrared (LWIR; 2.5-20 mu m). We apply this technique to a
   2848 m-deep geothermal production well in the northwest Geysers,
   inferred to overlie a Holocene intrusion and zone of partial melt as
   indicated by geophysics. We utilized this non-destructive technique to
   analyze every drill-cuttings sample (3000+ measurements collected at-3.3
   m intervals). We identify a zonation in mineralogy that changes from
   illite + chlorite +/- kaolinite +/- smectite +/- calcite at shallow
   depths (0-1000 m), to illite + chlorite +/- calcite at intermediate
   depths (1000-2200 m), to actinolite + biotite + chlorite +/- tourmaline
   at greatest depths (2200-2848 m). We find the change at 2200 m is
   proximal to the inferred transition from the ``normal{''} temperature
   reservoir (-240 degrees C vapor-dominated convective zone) to the high
   temperature reservoir (up to 400 degrees C, conduction-dominated). We
   identify a possible association between 1900 nm H2O absorptions and
   current steam entry locations. The results of the SWIR and LWIR analysis
   are consistent with some caveats with newly collected bulk rock X-Ray
   Diffraction (XRD) data, and support and compliment previous work at the
   Geysers utilizing XRD and petrographic analysis.},
Type = {Article},
DOI = {10.1016/j.jvolgeores.2023.107968},
EarlyAccessDate = {DEC 2024},
Article-Number = {107968},
Keywords = {Geothermal; Infrared Spectroscopy; Hydrothermal Alteration; SWIR; LWIR},
