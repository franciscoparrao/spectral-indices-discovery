@article{ WOS:001024948400001,
Author = {Sudapalli, Aruna M. and Shimpi, Navinchandra G.},
Title = {Hydrothermal synthesis of α-FeOOH (1D) nanorods and their transition to
   α-Fe2O3 (0D): an efficient photocatalyst in
   neutralizing hazardous organic dyes},
Journal = {NEW JOURNAL OF CHEMISTRY},
Year = {2023},
Volume = {47},
Number = {30},
Pages = {14323-14334},
Month = {JUL 31},
Abstract = {\& alpha;-FeOOH (goethite) with a nanorod morphology has been
   synthesized successfully by a hydrothermal method, and further
   calcinated (6 h at 520 \& DEG;C) to obtain \& alpha;-Fe2O3 (hematite)
   nanoparticles of spherical shape morphology. The synthesized \&
   alpha;-FeOOH and \& alpha;-Fe2O3 nanoparticles were subjected to various
   characterization techniques (X-ray diffraction (XRD), Fourier transform
   infrared spectroscopy (FTIR), UV-Vis diffuse reflectance spectroscopy
   (UV-DRS), photoluminescence (PL) spectroscopy, liquid chromatography
   with mass spectrometry (LCMS), dynamic light scattering (DLS) and zeta
   potential (ZP), thermogravimetry analysis (TGA), differential thermal
   analysis (DTA), X-ray photoelectron spectrometer (XPS), N-2
   adsorption-desorption isotherms (BET), field emission scanning electron
   microscopy (FESEM), energy dispersive X-ray analysis (EDAX) and
   transmission electron microscopy (TEM)). Meanwhile, the as-synthesized
   \& alpha;-FeOOH and \& alpha;-Fe2O3 nanoparticles were used to degrade
   hazardous organic cationic dyes such as brilliant green (BG) and
   rhodamine B (RhB) under sunlight. It was observed from the study that BG
   (96\%, 110 min) and RhB (93\%,90 min) show responsive degradation in the
   presence of \& alpha;-FeOOH nanorods. Besides this, 99\% (100 min) and
   99.4\% (80 min) BG and RhB get degraded using \& alpha;-Fe2O3
   nanoparticles, respectively. Overall, \& alpha;-Fe2O3 nanoparticles were
   a more prominent photocatalyst for the degradation of BG and RhB than \&
   alpha;-FeOOH nanorods.},
Type = {Article},
DOI = {10.1039/d3nj00979c},
