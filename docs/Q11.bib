@article{ WOS:000507552400017,
Author = {Filiberto, Justin and Trang, David and Treiman, Allan H. and Gilmore,
   Martha S.},
Title = {Present-day volcanism on Venus as evidenced from weathering rates of
   olivine},
Journal = {SCIENCE ADVANCES},
Year = {2020},
Volume = {6},
Number = {1},
Month = {JAN},
Abstract = {At least some of Venus' lava flows are thought to be <2.5 million years
   old based on visible to near-infrared (VNIR) emissivity measured by the
   Venus Express spacecraft. However, the exact ages of these flows are
   poorly constrained because the rate at which olivine alters at Venus
   surface conditions, and how that alteration affects VNIR spectra,
   remains unknown. We obtained VNIR reflectance spectra of natural olivine
   that was altered and oxidized in the laboratory. We show that olivine
   becomes coated, within days, with alteration products, primarily
   hematite (Fe2O3). With increasing alteration, the VNIR 1000-nm
   absorption, characteristic of olivine, also weakens within days. Our
   results indicate that lava flows lacking VNIR features due to hematite
   are no more than several years old. Therefore, Venus is volcanically
   active now.},
Type = {Article},
DOI = {10.1126/sciadv.aax7445},
