@article{ WOS:000319641500041,
Author = {Boudjemaa, A. and Bachari, K. and Trari, M.},
Title = {Photo-electrochemical characterization of porous material Fe-FSM-16.
   Application for hydrogen production},
Journal = {MATERIALS SCIENCE IN SEMICONDUCTOR PROCESSING},
Year = {2013},
Volume = {16},
Number = {3},
Pages = {838-844},
Month = {JUN},
Abstract = {We describe in the present work the photo-electrochemical
   characterization of iron/folded-sheets mesoporous materials (Fe-FSM-16,
   Si/Fe=60) synthesized by microwave-assisted hydrothermal (M-H) method
   and its application for the hydrogen evolution upon visible light. The
   mesoporous catalyst consists of small Fe2O3 particles (2 nm) spread on
   SiO2 with specific surface area of similar to 800 m(2) g(-1). The
   capacitance measurements reveal an iron deficiency and the oxide exhibit
   p type conductivity with activation energy of 0.07 eV. The optical gap
   of the hematite (alpha-Fe2O3) is evaluated at 3.24 eV from the diffuse
   reflectance spectrum. The flat band potential V-fb(-0.54 V-SCE) and the
   holes density N-D (9.56 x 10(14) cm(-3)) of the hematite are obtained
   respectively by extrapolating the linear part to C-2=0 and the slope of
   the Mott Schottky plot. At pH =7, the conduction band (-0.47 V-SCE) is
   suitably positioned with respect to the H2O/H-2 level (-0.59 V-SCE)
   leading to a spontaneous water reduction. The oxide is stabilized by
   hole consumption involving SO32- and S2O32- species and spectacular
   improvement of the hydrogen evolution is reported with evolution rates
   of similar to 461 and 163 mu mol respectively. (C) 2013 Elsevier Ltd.
   All rights reserved.},
Type = {Article},
DOI = {10.1016/j.mssp.2013.01.008},
