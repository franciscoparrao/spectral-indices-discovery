@article{ WOS:000289745000006,
Author = {Tappert, Michelle and Rivard, Benoit and Giles, David and Tappert, Ralf
   and Mauger, Alan},
Title = {AUTOMATED DRILL CORE LOGGING USING VISIBLE AND NEAR-INFRARED REFLECTANCE
   SPECTROSCOPY: A CASE STUDY FROM THE OLYMPIC DAM IOCG DEPOSIT, SOUTH
   AUSTRALIA},
Journal = {ECONOMIC GEOLOGY},
Year = {2011},
Volume = {106},
Number = {2},
Pages = {289-296},
Month = {MAR-APR},
Abstract = {Reflectance spectrometers with automated scanning capabilities can
   gather compositional information directly from the surface of drill
   core. To showcase the usefulness of this analytical technique, 300 m of
   drill core from the Olympic Darn iron oxide copper-gold (IOCG) deposit,
   South Australia, were scanned using FlyLogger. The reflectance spectra
   (400-2,500 nm) were analyzed to identify hematite and phengite, which
   are the most important alteration minerals at Olympic Dam. The results
   were plotted as a function of depth to produce a log that accurately
   identified ore-bearing and barren rocks. The position of the most
   intense absorption feature between 850 and 970 nm was found to
   correspond to iron concentration, and the intensity of the most intense
   absorption feature between 2,190 and 2,230 nm was found to correspond to
   aluminum concentration. In addition, phengite located near the
   ore-bearing zone was found to contain more aluminum than phengite
   located in the barren rocks, and this difference in phengite mineral
   chemistry was observable in the reflectance spectra between 2,190 and
   2,230 nm.},
Type = {Article},
DOI = {10.2113/econgeo.106.2.289},
Keywords-Plus = {MICAS; SPECTRA},
