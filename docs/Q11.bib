@incollection{ WOS:000250473800122,
Author = {Behnia, Pouran},
Editor = {Zhao, P and Agterberg, F and Cheng, Q},
Title = {Applying mineral mapping on hyperspectral data using spectral feature
   fitting method case study: Abtorsh area, Iran},
Booktitle = {Proceedings of the IAMG `07: Geomathematics and GIS Analysis of
   Resources, Environment and Hazards},
Year = {2007},
Pages = {477-480},
Abstract = {Mineral mapping method was applied on airborne HyMap hyperspectral data
   to create maps of mineral distribution in Abtorsh area. HyMap sensor
   operates in spectral range of 0.45-2.5 mu m in 126 spectral bands with
   band width of 15-20 nm. Abtorsh area is the first area in the country in
   which hyperspectral imaging was applied. In order to remove instrumental
   and atmospheric effects from hyperspectral data, the raw data should
   first be changed into radiance at sensor and then to reflectance data,
   so that they can be compared with reference spectral data. The Spectral
   Feature Fitting (SFF) which is an absorption-feature-based methodology
   was used to compare the fit of image spectra to selected reference
   spectra (USGS spectral library). Identification of different alteration
   minerals such as kaolinite, dickite, alunite, pyrophillite,
   montmorillonite, and verification of the results by laboratory
   measurements from field samples indicates the high capability of
   hyperspectral remote sensing and efficiency of SSF algorithm in mapping
   of alteration minerals.},
Type = {Proceedings Paper},
Research-Areas = {Geology; Mathematics; Remote Sensing},
Cited-References = {BOARDMAN JW, 1996, 3 ANN JPN AIRB EARTH, V964, P1.
   Clark R. N., 1995, LUNAR PLANETARY SCI, VXXVI, P255.
   CLARK RN, 1993, 93592 US GEOL SURV O.
