@article{ WOS:A1996VU80200006,
Author = {Roush, TL and Orenberg, JB},
Title = {Estimated detectability limits of iron-substituted montmorillonite clay
   on Mars from thermal emission spectra of clay-palagonite physical
   mixtures},
Journal = {JOURNAL OF GEOPHYSICAL RESEARCH-PLANETS},
Year = {1996},
Volume = {101},
Number = {E11},
Pages = {26111-26118},
Month = {NOV 25},
Abstract = {The thermal emission properties of two Mars soil analogs, palagonite and
   iron-substituted montmorillonite clay, and their physical mixtures are
   presented in the 5 to 25 mu m (2000 to 400 cm(-1)) region. The clay
   spectrum has both a greater number of spectral features and higher
   emissivity contrast when compared to the palagonite spectrum. Emissivity
   peaks located near 8.9, 11.1, and 19.9 mu m (1120, 905, and 505 cm(-1))
   and troughs (restsrahlen features) located near 8.8, 9.7, 18.9, and 22.2
   mu m in the spectrum of the clay provide the ability to identify the
   presence of clay when it is physically mixed with the palagonite. In the
   mixtures studied, when 15 wt\% of clay is mixed with 85 wt\% palagonite,
   the 19.9 mu m emissivity peak and the 9.7 mu m reststrahlen trough are
   readily identifiable, but the 8.9 and 11.1 mu m peaks and the 8.8, 9.3,
   and 18.9 mu m troughs are only marginally identifiable. This indicates
   that identification of clays on Mars, using midinfrared data, should
   rely upon the sensitivity of the 19.9 and 9.7 mu m features to the
   clays' presence.},
Type = {Article},
DOI = {10.1029/96JE02863},
Keywords-Plus = {REMOTE-SENSING APPLICATIONS; REFLECTANCE SPECTROSCOPY; MU-M; RICH
   MONTMORILLONITE; SURFACE-COMPOSITION; PLANETARY SURFACES; AQUEOUS
