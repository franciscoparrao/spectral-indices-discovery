@article{ WOS:000452940800103,
Author = {Chen, Huajun and Tian, Wenjie and Ding, Wuxiu},
Title = {Preparation of meso-Ag/Al2O3 and synergistic water
   disinfection of metallic silver and ROS under visible light},
Journal = {SOLAR ENERGY},
Year = {2018},
Volume = {173},
Pages = {1065-1072},
Month = {OCT},
Abstract = {Metallic sliver-doped mesoporous Al2O3 fibers (meso-Ag/Al2O3) that can
   harvest visible light to speed up solar water purification, were
   synthesized by one-pot hydrothermal method. Insightful analyses of XRD,
   XRF and XPS of meso-Ag/Al2O3 verified that metallic silver occupied
   interstitial positions of Al2O3 lattice forming interstitial solid
   solution. N-2 adsorption/desorption illustrated that meso-Ag/Al2O3
   exhibited significantly increases in the specific surface area, pore
   volume and average pore diameter after doping with silver. The UV-Vis
   diffuse reflectance spectra and disinfection performance indicated that
   meso-Ag/Al2O3 can harvest visible light to promote the conversion of
   dioxygen to ROS for water disinfection compared with the widely used
   TiO2. With our approach, we achieved water disinfection of > 99.999\%
   inactivation of bacteria in 120 min with a small amount of material (8
   mg/L) under simulated visible light.},
Type = {Article},
DOI = {10.1016/j.solener.2018.08.047},
Keywords = {Silver; Al2O3; Doping; Mesoporous; Water; Disinfection},
