@article{ WOS:000595733300014,
Author = {McAdam, Amy C. and Sutter, Brad and Archer, P. Douglas and Franz,
   Heather B. and Wong, Gregory M. and Lewis, James M. T. and Eigenbrode,
   Jennifer L. and Stern, Jennifer C. and Knudson, Christine A. and Clark,
   V, Joanna and Andrejkovicova, Slavka and Ming, Douglas W. and Morris, V,
