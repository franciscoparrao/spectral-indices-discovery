@article{ WOS:001671378200008,
Author = {Kim, Chang Seong and Chang, Bongsu and Lee, Young Jae and Heo, Chul-Ho},
Title = {SWIR-Based Characterization of Illite as an Exploration Indicator for
   Au-Ag Mineralization in the Youngdong Region},
Journal = {ECONOMIC AND ENVIRONMENTAL GEOLOGY},
Year = {2025},
Volume = {58},
Number = {6},
Pages = {691-703},
Month = {DEC},
Abstract = {The Youngdong area is the only gold metallogenic province in Korea where
   mineralization associated with both the Jurassic and Cretaceous periods
   occurs, and it hosts numerous gold deposits, including Haksan,
   Yeongbogari, Samhwanghak, Daeil, and Yonghwa. These deposits exhibit
   wide geochemical variation in vein morphology, electrum composition, and
   fluid inclusion characteristics, suggesting that mineralization from the
   two periods possibly overlapped. To investigate the relationship between
   metallic mineralization and illite in the Yeongdong area, a total of 103
   samples were analyzed using short-wave infrared (SWIR) spectroscopy and
   classified into five groups based on spectral characteristics and
   mineralogical composition. Most samples show absorption features typical
   of illite in the 2,200-2,210 nm range. Samples dominated by illite
   display absorption minima at 2,205-2,210 nm, whereas samples containing
   kaolinite exhibit shorter-wavelength minima at 2,200-2,205 nm. This
   systematic shift toward shorter wavelengths is interpreted as reflecting
   increasing kaolinite content. In addition, samples collected closer to
   ore bodies tend to exhibit shorter absorption wavelengths, suggesting
   that SWIR spectral characteristics may serve as a useful indicator for
   exploration targeting in the Youngdong gold metallogenic belt.},
Type = {Article},
DOI = {10.9719/EEG.2025.58.6.691},
Keywords = {Youngdong area; gold mineralization; illite; SWIR spectroscopy;
   exploration indicator},
