@article{ WOS:001545007600007,
Author = {Abdullah, Haidi and Skidmore, Andrew K. and Siegenthaler, Andjin and
   Neinavaz, Elnaz},
Title = {High-Resolution prediction of soil pH in European temperate forests
   using Sentinel-2 and ancillary environmental data},
Journal = {SCIENTIFIC REPORTS},
Year = {2025},
Volume = {15},
Number = {1},
Month = {AUG 5},
Abstract = {Soil pH is a key indicator for understanding soil health status in
   forested ecosystems, yet high-resolution mapping of this variable,
   especially at a 30-m spatial resolution, remains limited. This study
   uses Sentinel-2 spectral data, in-situ soil pH measurements, topsoil
   physical properties from the Land Use/Cover Area Frame Survey (LUCAS)
   database, and elevation data to estimate soil pH across temperate
   forests in Europe using a Random Forest model. Despite challenges in
   signal penetration due to forest canopy cover, the model achieved high
   prediction accuracy (R-2 = 0.62) at 30 m resolution. Bulk density,
   available water capacity, and clay content were the most influential
   physical predictors, while Sentinel-2 bands, particularly SWIR (1.610
   and 2.190 mu m), NIR (0.842 mu m), and red-edge (0.705 and 0.783 mu m),
   captured key vegetation responses related to soil acidity. Spatial
   analysis showed higher model accuracy in central and southern Europe,
   with reduced performance in Scandinavia, likely due to more acidic soils
   and extreme seasonal variation. The model also revealed significant pH
   differences among forest types, with deciduous forests showing the
   highest values and coniferous the lowest. These findings demonstrate the
   potential of high-resolution remote sensing data for monitoring soil pH,
   supporting forest management, biodiversity conservation, and climate
   adaptation strategies.},
Type = {Article},
DOI = {10.1038/s41598-025-03942-4},
Article-Number = {28509},
Keywords = {Soil pH; Sentinel-2; Random forest; LUCAS topsoil database},
Keywords-Plus = {WATER-CONTENT; LEAF REFLECTANCE; ACIDIFICATION; COMMUNITIES; DEPOSITION;
