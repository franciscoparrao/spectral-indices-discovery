@article{ WOS:000792830500004,
Author = {Ren, Jiaolong and Zhang, Lin and Zhao, Hongbo and Zhao, Zedong and Wang,
   Siyuan},
Title = {Determination of the fatigue equation for the cement-stabilized cold
   recycled mixtures with road construction waste materials based on
   data-driven},
Journal = {INTERNATIONAL JOURNAL OF FATIGUE},
Year = {2022},
Volume = {158},
Month = {MAY},
Abstract = {The fatigue life is one of the essential design indexes of the
   cement-stabilized cold recycled mixtures (CSCRM) in China. However, it
   is challenging to determine the fatigue equation of the CSCRM. In this
   study, the symbolic regression method is adopted to automatically
   identify a closed-form equation by the data-driven model to establish
   the fatigue prediction equation with a unified and concise mathematical
   structure. The developed method was illustrated and compared with the
   test results. The results show that the developed equation has a
   satisfactory prediction effect and provides a good and helpful tool to
   determine the fatigue life for CSCRMs.},
Type = {Article},
DOI = {10.1016/j.ijfatigue.2022.106765},
