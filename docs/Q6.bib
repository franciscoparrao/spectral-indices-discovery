@article{ WOS:000230341100007,
Author = {Hafner, C},
Title = {Drude model replacement by symbolic regression},
Journal = {JOURNAL OF COMPUTATIONAL AND THEORETICAL NANOSCIENCE},
Year = {2005},
Volume = {2},
Number = {1},
Pages = {88-98},
Month = {MAR},
Abstract = {Within numerical codes for the simulation of electromagnetic fields, the
   frequency dependence of material properties should often be specified by
   an appropriate formula. Usually Drude models and similar formulations
   are derived from simple physical models that turn out to be not
   sufficiently accurate when the frequency range is not very small. After
   a short review of traditional methods for the formula approximation of
   measured data, methods for symbolic regression-based on a generalized
   Genetic Programming algorithm-are presented and applied for replacing
   Drude models by formulae that are still simple but have no physical
   background and are sufficiently accurate over a wide frequency range for
   being embedded in numerical codes.},
Type = {Article},
Keywords = {Drude models; symbolic regression; genetic programming},
Keywords-Plus = {NANOPARTICLES},
Research-Areas = {Chemistry; Science \& Technology - Other Topics; Materials Science;
   Physics},
Cited-References = {Gray SK, 2003, PHYS REV B, V68, DOI 10.1103/PhysRevB.68.045415.
