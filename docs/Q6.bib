@article{ WOS:001504014200004,
Author = {Jenkins, William and Gross, Hunter and Detwiler, Kaitlin and Morscher,
   Gregory and Przybyla, Craig and Hochhalter, Jacob},
Title = {Developing a continuum damage model for ceramic matrix composites using
   genetic programming based symbolic regression},
Journal = {COMPOSITE STRUCTURES},
Year = {2025},
Volume = {369},
Month = {OCT 1},
Abstract = {Modeling damage in continuous fiber reinforced ceramic matrix composites
   (CMCs) needs improvement before CMCs can be widely adopted in critical
   aerospace applications. While damage mechanisms in CMCs are dependent on
   the microstructure, we develop a continuum damage model (CDM) that
   homogenizes governing microstructural mechanisms for application at the
   engineering scale. The CDM operates on the ply-level, under 2D plane
   stress assumptions, derived using a thermodynamics-based approach. We
   employ genetic programming based symbolic regression (GPSR) to learn
   individual components of the unknown damage model tensor from SiC/SiC
   tensile testing data. Known elastic material behavior is separated such
   that GPSR specifically learns the corresponding damage tensor. Training
   constraints based on mechanics knowledge are enforced to promote the
   evolution of models that are physically valid and interpretable. The
   resulting damage model fits well to training data and provides physical
   insight into the laminate damage mechanisms and interactions.},
Type = {Article},
DOI = {10.1016/j.compstruct.2025.119274},
