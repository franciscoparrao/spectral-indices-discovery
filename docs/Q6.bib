@article{ WOS:001701342300001,
Author = {Bobbili, Ravindranadh},
Title = {Physics-informed and interpretable machine learning for elastic
   constants of RHEAs},
Journal = {MATERIALIA},
Year = {2026},
Volume = {45},
Month = {MAR},
Abstract = {The accelerated discovery of refractory high-entropy alloys (RHEAs)
   requires predictive frameworks that combine computational accuracy,
   physical transparency, and experimental reliability. We present an
   explainable framework that integrates ensemble learning, symbolic
   regression, and physics-informed neural networks (PINNs) to predict
   elastic constants of RHEAs. The model is trained on a curated set of 182
   compositions using six physically grounded descriptors: valence electron
   concentration (VEC), atomic size mismatch, mixing entropy, mixing
   enthalpy, melting temperature, and electronegativity variance. To our
   knowledge, this is the first systematic RHEA study that simultaneously
   reaches DFT-level accuracy, enforces elastic-stability physics during
   training, and validates predictions against a held-out experimental set.
   The framework achieves R2 above 0.95 on DFT data and above 0.92 on 25
   fully unseen experimental measurements. The PINN predicts the
   single-crystal elastic constants (C11, C12, C44) under Born-Huang
   stability constraints and maps them to polycrystalline Young's modulus,
   shear modulus, and bulk modulus using Voigt-Reuss-Hill (VRH) averaging
   for one-to-one comparison with experiments. SHAP and symbolic regression
   provide interpretability, consistently identifying VEC as the dominant
   stiffness driver and atomic size mismatch as the principal
   shear-softening factor. Mechanistically, increasing VEC fills bonding
   D-states and lowers the density of states at the Fermi level,
   strengthening metallic bonds and raising C11, bulk modulus, and shear
   modulus. Interaction analyses reveal a nonlinear coupling between
   configurational entropy and VEC, in which chemical randomness perturbs
   local crystal fields and reshapes the D-band, thereby modulating the
   VEC-driven stiffening. Bootstrap ensembling supplies calibrated
   prediction intervals, turning outputs into risk-aware design guidance.
   Overall, this experimentally validated, physics-constrained, and
   explainable framework provides trustworthy elasticity predictions and
   actionable insights for designing RHEAs for aerospace turbines, nuclear
   cladding, and energy systems. In addition, we benchmark the framework
   against a conventional rule-of-mixtures baseline and discuss its
   extension to plastic deformation properties, highlighting the benefits
   and limitations of the present elasticity-focused study.},
Type = {Article},
DOI = {10.1016/j.mtla.2026.102682},
