@article{ WOS:000955390800001,
Author = {Zhou, Shuwei and Yang, Bing and Xiao, Shoune and Yang, Guangwu and Zhu,
   Tao},
Title = {Crack Growth Rate Model Derived from Domain Knowledge-Guided Symbolic
   Regression},
Journal = {CHINESE JOURNAL OF MECHANICAL ENGINEERING},
Year = {2023},
Volume = {36},
Number = {1},
Month = {MAR 27},
Abstract = {Machine learning (ML) has powerful nonlinear processing and multivariate
   learning capabilities, so it has been widely utilised in the fatigue
   field. However, most ML methods are inexplicable black-box models that
   are difficult to apply in engineering practice. Symbolic regression (SR)
   is an interpretable machine learning method for determining the optimal
   fitting equation for datasets. In this study, domain knowledge-guided SR
   was used to determine a new fatigue crack growth (FCG) rate model. Three
