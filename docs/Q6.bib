@article{ WOS:001308263200006,
Author = {Bai, Guoli and Sun, Wei and Tian, Guangyao and Sun, Qingchao and Sun,
   Liang},
Title = {Efficient Strain Analysis of Radially Loaded Hollow Cylindrical Roller
   Using Symbolic Regression},
Journal = {IEEE TRANSACTIONS ON INSTRUMENTATION AND MEASUREMENT},
Year = {2024},
Volume = {73},
Abstract = {The development of digital twins and smart bearings in bearing industry
   demands efficient computational methods for factors, such as strain
   analysis. Symbolic regression (SR) offers a promising solution by
   efficiently deriving analytical expressions from limited data, offering
   low computational cost, rapid speed, high accuracy, and strong
   interpretability. In this article, SR is applied to the strain
   calculation problem of radially loaded hollow cylindrical rollers
   (HCRs). The resulting expressions are evaluated and selected based on
   physical insights obtained from theoretical analysis and physical
   experiments. Compared to other methods, the selected expression retains
   interpretability and generalization capabilities while achieving
   superior computational accuracy.},
Type = {Article},
DOI = {10.1109/TIM.2024.3449968},
