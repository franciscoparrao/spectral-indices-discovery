@article{ WOS:000988360000017,
Author = {Xiong, Jie and Lei, Tong-Xing and Fu, Da-Meng and Wu, Jun-Wei and Zhang,
   Tong-Yi},
Title = {Data driven discovery of an analytic formula for the life prediction of
   Lithium-ion batteries},
Journal = {PROGRESS IN NATURAL SCIENCE-MATERIALS INTERNATIONAL},
Year = {2022},
Volume = {32},
Number = {6},
Pages = {793-799},
Month = {DEC},
Abstract = {Predicting the cycle life of Lithium-Ion Batteries (LIBs) remains a
   great challenge due to their complicated degradation mechanisms. The
   present work employs an interpretative machine learning of symbolic
   regression (SR) to discover an analytic formula for LIB life prediction
   with newly defined features. The novel features are based on the
   discharging energies under the constant-current (CC) and
   constant-voltage (CV) modes at every five cycles alternately. The cycle
   life is affected by the CC-discharging energy at the 15th cycle
   (E15-CCD) and the difference between the CC-discharging energies at the
   45th cycle and 95th cycle (Delta(45-95)). The cycle life highly
   correlates with a simple indicator (E15-CCD -3)/Delta(45-95) with a
   Pearson correlation coefficient of 0.957. The machine learning tools
   provide a rapid and accurate prediction of cycle life at the early
   stage.},
Type = {Article},
DOI = {10.1016/j.pnsc.2022.12.002},
Keywords = {Symbolic regression; Machine learning; Cycle life prediction;
   Lithium-ion batteries},
Keywords-Plus = {HEALTH ESTIMATION; HIGH-POWER; DEGRADATION; DIAGNOSIS; STATE},
Research-Areas = {Materials Science; Science \& Technology - Other Topics},
Cited-References = {Anseán D, 2017, J POWER SOURCES, V356, P36, DOI 10.1016/j.jpowsour.2017.04.072.
   Anseán D, 2016, J POWER SOURCES, V321, P201, DOI 10.1016/j.jpowsour.2016.04.140.
