@article{ WOS:001577524300001,
Author = {Wu, Hongjing and Xie, Shangkang and Li, Xurui and Zhao, Yashuang and
   Guo, Lixia and Tu, Xinlei and Feng, Feiyu and Wang, Qingtao and Lyu,
   Jinghui and Feng, Feng and Lu, Chunshan and Fang, Rubo and Zhang,
   Qunfeng and Li, Xiaonian},
Title = {Machine learning for catalysis: Bridging data-driven discovery and
   physical insight},
Journal = {MATERIALS TODAY CHEMISTRY},
Year = {2025},
Volume = {49},
Month = {OCT},
Abstract = {Catalysis is undergoing a paradigm shift from traditional
   trial-and-error and theory-driven models toward a new era characterized
   by deep integration of data-driven approaches and physical insights. As
   a core technology of artificial intelligence, machine learning (ML) has
   emerged as a powerful engine transforming the landscape of catalysis
   research, owing to its capabilities in data mining, performance
   prediction, and mechanistic analysis. ML has been widely applied across
   photocatalysis, thermocatalysis, electrocatalysis, and heterogeneous
   catalysis. This review systematically outlines the three-stage evolution
   of ML in catalysis: from early high-throughput screening based on
   experimental and computational data, to performance modeling using
   physically meaningful descriptors, and ultimately to advanced symbolic
   regression aimed at uncovering general catalytic principles. Within this
   framework, we highlight recent advances and critical challenges in data
   acquisition and database construction, feature engineering and physical
   descriptor design, as well as model generalization and interpretability.
   Finally, we offer a forward-looking perspective on emerging directions
   including small-data learning, standardized catalyst databases,
   physically informed interpretable models, and large language
   model-augmented mechanistic modeling.},
Type = {Article},
DOI = {10.1016/j.mtchem.2025.103051},
