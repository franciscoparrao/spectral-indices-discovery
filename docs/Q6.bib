@incollection{ WOS:001282083300091,
Author = {Bagchi, Atish and Chandrasekaran, Siva},
Editor = {Abdelgawad, A and Jamil, A and Hameed, AA},
Title = {Forecasting of Winding and Oil Temperatures In Power Transformers Using
   a Hybrid Deep Learning Model with Attention Feedback},
Booktitle = {2024 IEEE 3RD INTERNATIONAL CONFERENCE ON COMPUTING AND MACHINE
   INTELLIGENCE, ICMI 2024},
Year = {2024},
Abstract = {Industrial time series forecasting in near real-time involving multiple
   covariates remains a challenge. Although machine learning models have
   been used to solve the problem, there are several challenges that
   require attention. Most of the machine learning models do not provide
   any interpretability and these models can lose their relevance over time
   as the underlying machine characteristics change due to wear and tear,
   upgrades, preventative maintenance etc. This paper presents a hybrid
   model based on feedforward deep neural network with attention feedback,
   1D convolutional layer and non-evolutionary deterministic symbolic
   regression, which transforms a multi-covariate forecasting into a
   univariate forecasting problem. In addition, the deterministic symbolic
   regression allows for the discovery of interpretable relationship
   between the predicted variable and the co-variates. The forecasting
   model is carefully managed over its entire life cycle by a
   self-exploratory orchestration mechanism which ensures that the models
   are always kept in synch with the changes happening to the underlying
   machine characteristics through continuous, autonomous monitoring,
   decision making and learning. This paper introduces the model and the
   orchestration framework and presents a case study using the model
   described here to predict winding temperature and oil temperature in
   power transformers by monitoring the basic transformer parameters of
   load current, active and reactive power, and ambient conditions. This
   paper demonstrates the effective use of the Deep Feedforward Learning
   model and how it outperforms the traditional sequence-oriented models
   e.g. LSTM.},
Type = {Proceedings Paper},
DOI = {10.1109/ICMI60790.2024.10585999},
Keywords = {Deep Learning; Power Transformer; Winding Temperature; Oil Temperature;
   Feedforward Deep Neural Network Self-Exploratory Hybrid Deep Learning;
