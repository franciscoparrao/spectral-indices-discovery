@incollection{ WOS:000326235303016,
Author = {Applegate, Douglas and Mayfield, Blayne},
Book-Group-Author = {IEEE},
Title = {An Analysis of Exchanging Fitness Cases with Population Size in Symbolic
   Regression Genetic Programming with Respect to the Computational Model},
Booktitle = {2013 IEEE CONGRESS ON EVOLUTIONARY COMPUTATION (CEC)},
Year = {2013},
Pages = {3111-3116},
Abstract = {Symbolic regression using genetic programming is an ideal algorithm for
   automatically determining an otherwise unknown functional relationship
   between a set of inputs and outputs. More complex problems in this area
   typically require a larger amount of training epochs to exemplify the
   relationship. Previous work has shown that using a strategy of trading
   off higher population sizes with lower data sample sizes in the early
   generations yields better results. In this paper we take a closer look
   at this tradeoff policy and how it applies to the computation model, as
   well as examine some of the parameter settings.},
Type = {Proceedings Paper},
Keywords = {Genetic Programming; Symbolic Regression; Population Size; Data
