@incollection{ WOS:001156141200010,
Author = {Bertschinger, Amanda and Davis, Q. Tyrell and Bagrow, James and Bongard,
   Joshua},
Editor = {Koutra, D and Plant, C and Rodriguez, MG and Baralis, E and Bonchi, F},
Title = {The Metric is the Message: Benchmarking Challenges for Neural Symbolic
   Regression},
Booktitle = {MACHINE LEARNING AND KNOWLEDGE DISCOVERY IN DATABASES: RESEARCH TRACK,
   ECML PKDD 2023, PT IV},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2023},
Volume = {14172},
Pages = {161-177},
Abstract = {The neural symbolic regression (NSR) literature has thus far been
   hindered by an over-reliance on individual, ad hoc evaluation metrics,
   producing seemingly favorable performance for the method using it but
   making comparison between methods difficult. Here we compare the
   performance of several NSR methods using diverse metrics reported in the
   literature, and some of our own devising. We show that reliance on a
   single metric can hide an NSR method's shortcomings, causing performance
   rankings between methods to change as the evaluation metric changes. We
   further show that metrics which consider the structure of equations
   generated after training can help reveal these shortcomings, and suggest
   ways to correct for them. Given our results, we suggest best practices
   on what metrics to use to best advance this new field.},
Type = {Proceedings Paper},
DOI = {10.1007/978-3-031-43421-1\_10},
Keywords = {Benchmarks; Interpretability and explainability; Symbolic regression;
   Deep learning},
