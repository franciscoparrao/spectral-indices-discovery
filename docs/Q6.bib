Title = {Analysis of Schema Frequencies in Genetic Programming},
Booktitle = {COMPUTER AIDED SYSTEMS THEORY - EUROCAST 2017, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2018},
Volume = {10671},
Pages = {432-438},
Abstract = {Genetic Programming (GP) schemas are structural templates equivalent to
   hyperplanes in the search space. Schema theories provide information
   about the properties of subsets of the population and the behavior of
   genetic operators. In this paper we propose a practical methodology to
   identify relevant schemas and measure their frequency in the population.
   We demonstrate our approach on an artificial symbolic regression
   benchmark where the parts of the formula are already known. Experimental
   results reveal how solutions are assembled within GP and explain
   diversity loss in GP populations through the proliferation of repeated
   patterns.},
Type = {Proceedings Paper},
DOI = {10.1007/978-3-319-74718-7\_52},
Keywords = {Genetic Programming; Schema analysis; Symbolic regression; Tree pattern
