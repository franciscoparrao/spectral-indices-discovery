@article{ WOS:001408590200001,
Author = {Gao, Zhiwei and Wu, Siwei and Li, Xin and Zhou, Xiaoguang and Cao,
   Guangming and Liu, Zhenyu},
Title = {Modelling strain-induced precipitation kinetics of Nb (C, N) by symbolic
   regression machine learning},
Journal = {JOURNAL OF MATERIALS RESEARCH AND TECHNOLOGY-JMR\&T},
Year = {2025},
Volume = {35},
Pages = {1712-1721},
Month = {MAR-APR},
Abstract = {Because strain-induced precipitation (SIP) behavior in Nb micro-alloyed
   steels directly affects recovery and recrystallization processes during
   hot rolling, it is crucial to establish high-precision models for SIP
   kinetics. In this work, based on experimental results with Nb
   micro-alloyed steels, symbolic regression machine learning (SRML) was
   used to construct the models for precipitation start (Ps) and finish
   times (Pf) with concentrations of Nb, C, N, Mn, and Si in solution,
   deformation temperature (Tdef), strain (epsilon), strain rate
   (epsilon(center dot)), Zener-Hollomon parameter (Z), and the
   supersaturation ratio (Ks) being the model inputs. Compared to the
   Pereda model for P s and Medina model for P f , root mean square errors
   ( RMSEs ) were reduced by about 89\% and 91\%, respectively.
   Furthermore, the effects of Si and Mn contents, strain, and strain rate
   on the SIP kinetics were analyzed, showing good consistency with the
   experimental results. The precipitated volume fractions were calculated
   based on the JMAK equation with the precipitation start times by using
   different models, which further demonstrates that the SRML model
   outperforms conventional models. Finally, the static recrystallization
   critical temperatures (SRCT) were determined for different Nb
   micro-alloyed steels, which can guide the designs for new
   thermomechanical processing routes.},
Type = {Article},
DOI = {10.1016/j.jmrt.2025.01.154},
EarlyAccessDate = {JAN 2025},
Keywords = {Nb micro-alloyed steels; Physical metallurgical principles; Data-driven
   modelling; Symbolic regression; Automated model construction},
