@article{ WOS:001234268300001,
Author = {Wang, Guanjie and Wang, Erpeng and Li, Zefeng and Zhou, Jian and Sun,
   Zhimei},
Title = {Exploring the mathematic equations behind the materials science data
   using interpretable symbolic regression},
Journal = {INTERDISCIPLINARY MATERIALS},
Year = {2024},
Volume = {3},
Number = {5},
Pages = {637-657},
Month = {SEP},
Abstract = {Symbolic regression (SR), exploring mathematical expressions from a
   given data set to construct an interpretable model, emerges as a
   powerful computational technique with the potential to transform the
   ``black box{''} machining learning methods into physical and chemistry
   interpretable expressions in material science research. In this review,
   the current advancements in SR are investigated, focusing on the
   underlying theories, fundamental flowcharts, various techniques,
   implemented codes, and application fields. More predominantly, the
   challenging issues and future opportunities in SR that should be
   overcome to unlock the full potential of SR in material design and
   research, including graphics processing unit acceleration and transfer
   learning algorithms, the trade-off between expression accuracy and
   complexity, physical or chemistry interpretable SR with generative large
   language models, and multimodal SR methods, are discussed.
   Symbolic regression (SR) transforms ``black box{''} machine learning
   into interpretable models by deriving mathematical expressions from data
   sets. The theoretical foundations, five categories of models,
   computational software, and benchmark data sets are reviewed. The paper
   also provides an overview of SR's applications in materials research,
   from feature selection to predicting material properties and atomic
   interactions, and concludes with a critical analysis of its limitations
   and future research topics. image},
Type = {Review},
DOI = {10.1002/idm2.12180},
EarlyAccessDate = {MAY 2024},
Keywords = {explainable machine learning; material database; materials science;
   representation learning; symbolic regression},
