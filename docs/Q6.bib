@article{ WOS:001716236400001,
Author = {Yin, Zegao and Li, Kesui and Wang, Risheng and Wang, Lu and Zhang,
   Xuecong and Yin, Dapeng and Jiang, Xiutao},
Title = {Solitary wave overtopping impact on a car at a sloped seawall crest},
Journal = {OCEAN ENGINEERING},
Year = {2026},
Volume = {354},
Number = {2},
Month = {MAY 1},
Abstract = {Extreme wave events have become more frequent mainly due to global
   climate change and human activities, posing threats to vehicles on
   sloped seawalls. This study investigated the impact characteristics of
   solitary wave overtopping on a car model at a sloped seawall crest
   experimentally and numerically. The results show that the dimensionless
   maximum horizontal wave force (HWF) on the car model increases with
   increasing relative wave height. Meanwhile, the dimensionless maximum
   HWF decreases as the distance between the seaside edge of seawall crest
   and the car model centroid increases. As car model location angle
   increases, the dimensionless maximum HWF generally shows a trend of
   first decreasing and then increasing, with a slight increase near 90
   degrees. A predictive formula for the dimensionless maximum HWF was
   developed using the symbolic regression method and validated against the
   related data, showing satisfactory performance. Such findings provide a
   useful reference for evaluating overtopping-induced wave forces on
   vehicles and safety of coastal infrastructure under extreme wave
   conditions.},
Type = {Article},
DOI = {10.1016/j.oceaneng.2026.124868},
