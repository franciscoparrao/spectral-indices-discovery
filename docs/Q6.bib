@incollection{ WOS:001084633402105,
Author = {Ozawa, Yuki and Zhao, Dafang and Watari, Daichi and Taniguchi, Ittetsu
   and Suzuki, Toshihiro and Shimoda, Yoshiyuki and Onoye, Takao},
Book-Group-Author = {IEEE},
Title = {Data-driven HVAC Control Using Symbolic Regression: Design and
   Implementation},
Booktitle = {2023 IEEE POWER \& ENERGY SOCIETY GENERAL MEETING, PESGM},
Series = {IEEE Power and Energy Society General Meeting PESGM},
Year = {2023},
Abstract = {The large amount of data collected in buildings makes energy management
   smarter and more energy efficient. This study proposes a design and
   implementation methodology of data-driven heating, ventilation, and air
   conditioning (HVAC) control. Building thermodynamics is modeled using a
   symbolic regression model (SRM) built from the collected data.
   Additionally, an HVAC system model is also developed with a data driven
   approach. A model predictive control (MPC) based HVAC scheduling is
