@incollection{ WOS:000380486700051,
Author = {Hansson, Erik and Kessler, Christoph},
Book-Group-Author = {IEEE},
Title = {Global optimization of execution mode selection for the reconfigurable
   PRAM-NUMA multicore architecture REPLICA},
Booktitle = {2014 SECOND INTERNATIONAL SYMPOSIUM ON COMPUTING AND NETWORKING (CANDAR)},
Year = {2014},
Pages = {322-328},
Abstract = {The REPLICA architecture is a massively hardware threaded very long
   instruction word (VLIW) architecture. REPLICA has two execution modes
   supported by the underlying on-chip memory; PRAM and NUMA which can be
   switched between at runtime. PRAM mode is considered the standard
   execution mode and targets mainly applications with very high thread
   level parallelism (TLP). In contrast, NUMA mode is for sequential legacy
   applications and applications with low amount of TLP, but for some cases
   very regular applications suits NUMA mode as well. However, there is a
   switching cost between the modes which is not neglectable. We combine
   machine-learning (symbolic regression) with shortest path problem to
   optimize software composition of parameterized stencil-like algorithms
   which have regular control flow and memory access pattern. Using the
   tool Eureqa Pro which is based on symbolic regression and training data
   we can create predictors for execution time for parameterized software
   components. We use the predictors and formulate an optimization problem
   based on shortest path to map component execution on the available modes
   (PRAM or NUMA). When composing for three randomly selected components
   from an evaluation set we get speedups up to 2.9 times including
   overhead and an average speedup of 1.4 also including overhead. Overhead
   costs which includes running predictors, solving shortest path and
   switching to the selected runtime modes are just a few percent.},
Type = {Proceedings Paper},
DOI = {10.1109/CANDAR.2014.72},
Keywords = {component; software composition; optimized composition;
   machine-learning; multicore; NUMA; PRAM},
Research-Areas = {Computer Science; Engineering; Telecommunications},
Cited-References = {Dastgeer U., 2014, MULTIPROG 2014 WORKS.
