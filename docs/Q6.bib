@article{ WOS:001166817900001,
Author = {Shirasawa, Raku and Takaki, Katsushi and Miyao, Tomoyuki},
Title = {Generalizability Improvement of Interpretable Symbolic Regression Models
   for Quantitative Structure-Activity Relationships},
Journal = {ACS OMEGA},
