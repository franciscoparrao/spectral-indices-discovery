@incollection{ WOS:000086116200016,
Author = {Davidson, JW and Savic, D and Walters, GA},
Editor = {John, R and Birkenhead, R},
Title = {Symbolic and numerical regression: A hybrid technique for polynomial
   approximators},
Booktitle = {SOFT COMPUTING TECHNIQUES AND APPLICATIONS},
Series = {ADVANCES IN SOFT COMPUTING},
Year = {2000},
Pages = {111-116},
Abstract = {Numerical and symbolic regression are combined in a single hybrid method
   for regression of polynomial expressions. The method uses genetic
   programming to find the form of polynomial expressions and least squares
   optimisation to find the values for all the constants in the
   expressions. The incorporation of least squares optimisation is made
   possible by a rule-based component that algebraically transforms
   expressions to equivalent forms that are suitable for least squares
   optimisation. The algebraic transformation of polynomial expressions
   generated through symbolic regression has led to the discovery that the
   technique is open to the possibility of generating under-determined
   functions. The traditional measures of the complexity of expressions,
   namely the length and depth, are inadequate to prevent underdetermined
   functions from occurring.},
Type = {Proceedings Paper},
Keywords = {genetic programming; least squares; polynomial expressions; symbolic
   algebra; symbolic regression},
Research-Areas = {Computer Science},
