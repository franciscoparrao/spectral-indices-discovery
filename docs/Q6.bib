Cited-References = {Agu CE, 2017, CHEM ENG J, V328, P997, DOI 10.1016/j.cej.2017.07.098.
   Alamri A, 2023, POWDER TECHNOL, V415, DOI 10.1016/j.powtec.2022.118192.
