@article{ WOS:001529376700001,
Author = {Zhang, Weijie and Zhang, Zhenyu and Hu, Jifeng and Lu, Bingnan and Pang,
   Jinyi and Wang, Qian},
Title = {Machine Learning Unveils the Power Law of Finite-Volume Energy Shifts},
Journal = {CHINESE PHYSICS LETTERS},
Year = {2025},
Volume = {42},
Number = {7},
Month = {JUL 1},
Abstract = {Finite-volume extrapolation is an important step for extracting physical
   observables from lattice calculations. However, it is a significant
   challenge for systems with long-range interactions. We employ symbolic
   regression to regress the finite-volume extrapolation formula for both
   short-range and long-range interactions. The regressed formula still
   holds the exponential form with a factor Ln in front of it. The power
   decreases with the decreasing range of the force. When the range of the
   force becomes sufficiently small, the power converges to -1, recovering
   the short-range formula as expected. Our work represents a significant
   advancement in leveraging machine learning to probe uncharted
   territories within particle physics.},
Type = {Article},
DOI = {10.1088/0256-307X/42/7/070202},
