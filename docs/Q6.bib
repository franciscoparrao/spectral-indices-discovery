@article{ WOS:001419546000001,
Author = {Cao, Weiwen and Sun, Xingyue and Li, Yajing and Chen, Xu},
Title = {Multiaxial damage parameter evaluation by neural network-based symbolic
   regression},
Journal = {ENGINEERING FRACTURE MECHANICS},
Year = {2025},
Volume = {315},
Month = {FEB 21},
Abstract = {The ubiquity and complexity of multiaxial loading necessitate the
   exploration of effective methods for evaluating multiaxial fatigue life.
   This work proposes a symbolic regression (SR) method to derive
   multiaxial fatigue damage parameters. An SR model based on neural
   network (NNSR) is developed with dimension consistency constraints.
   Through structural analysis, the optimal symbolic layer depth is
   determined, and the model is compared with other SR models based on
   formula tree structures. The proposed model demonstrates stable outputs
   with consistent physical dimensions. The formulas of damage value
   outputted by NNSR achieve predictions with up to 90.58\% of samples
   falling within the 2-factor band and 98.55\% within the 3-factor band,
   representing an improvement over the original models.},
