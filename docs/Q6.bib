   Franceschini G, 2008, CHEM ENG SCI, V63, P4846, DOI 10.1016/j.ces.2007.11.034.
   Servia MAD, 2023, Arxiv, DOI arXiv:2301.11356.},
Number-of-Cited-References = {7},
Times-Cited = {1},
Unique-ID = {WOS:001310822800022},
OA = {gold},
