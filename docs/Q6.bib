@article{ WOS:001507051300001,
Author = {Wang, Le-Rong and Liu, Qing-Feng and Wu, Bo and Zhao, Xin-Yu},
Title = {Explicit backbone curve prediction of corroded reinforced concrete
   columns using simulated annealing-optimized genetic programming},
Journal = {ENGINEERING STRUCTURES},
Year = {2025},
Volume = {335},
Month = {JUL 15},
Abstract = {Corrosion of reinforcement is a crucial factor contributing to the
   deterioration of seismic performance of aging reinforced concrete (RC)
   structures, as it directly compromises the mechanical capacity of
   materials, generates corrosion products that trigger concrete cracking
   and spalling due to rust expansion, and severely weakens the
   steel-concrete interfacial bond. The backbone curve, which encapsulates
   the nonlinear response behavior of RC components, serves as an essential
   basis for seismic analysis and performance assessment. In this study, a
   novel backbone curve model for corroded RC columns is proposed based on
   the genetic programming-based symbolic regression (GP-SR) method, which
   has become a go-to tool for digging up hidden knowledge and deriving
   explicit formulas. Unlike traditional machine learning models, often
   pegged as ``black boxes{''}, the GP-SR method delivers transparent,
   interpretable equations, making it highly accessible for researchers and
   practitioners alike. In particular, the GP-SR framework is optimized in
   this study by a simulated annealing (SA) algorithm, which enhances the
   framework's ability to escape local optima and greatly accelerates the
   search for optimal symbolic regression models. To ground our model, a
   comprehensive experimental database, comprising 130 corroded RC columns
   with flexural failure under cyclic loading, is compiled in this study.
   This dataset underpins feature selection, model training, and
   validation. The results demonstrate that the SA-optimized GP-SR method
   not only outperforms conventional approaches in predicting the
   post-corrosion strength of RC columns but also does so with high
   precision for lateral deformation predictions across a spectrum of
   levels of corrosion. Moreover, despite the constraints posed by the
   limited collected data, the SA-optimized GP-SR model demonstrates
   potential in extending its predictive scope to columns exhibiting
   flexural-shear failure. This broader generalizability enhances the
   model's usefulness, offering up an expedient approach for modeling and
   evaluating the residual seismic capacity of corroded RC columns.},
