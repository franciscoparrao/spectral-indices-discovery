@article{ WOS:001696209000001,
Author = {Wei, Dahai and Zeng, Fanlin and Cui, Jianzheng and Wang, Youshan},
Title = {Machine learning-based multiscale topology optimization framework for
   nonlinear materials},
Journal = {INTERNATIONAL JOURNAL OF MECHANICAL SCIENCES},
Year = {2026},
Volume = {314},
Month = {MAR 15},
Abstract = {With the comprehensive advancement of science, technology, and
   productivity, structural optimization design has been widely applied in
   various engineering fields. Among them, topology optimization, with its
   efficient and innovative structural design capabilities, has been
   particularly extensively adopted in the fields of aerospace, civil
   engineering, mechanical engineering, and biomedicine. Although existing
   topology optimization methods have achieved notable achievements, most
   studies are still confined to the assumption of linear elastic small
   deformation and homogenized continuous structures that adopt classical
   constitutive models. However, practical engineering applications often
   involve material nonlinearity and heterogeneous multi-scale material
   structures, for which the constitutive models have not yet been
   established. Therefore, developing multiscale topology optimization
   schemes for nonlinear materials faces significant challenges between
   computational efficiency and accuracy. This study proposes a machine
   learning-based multiscale topology optimization computational framework,
   aiming to obtain interpretable constitutive model expressions for
   composite materials through machine learning training, and to conduct
   nonlinear topology optimization on this basis, thereby achieving an
   effective transition between materials and structures. The research
   framework ensures the accuracy of physical information by integrating
   the ICNNs and symbolic regression methods, and incorporates neural
   network structures with physical constraints. Experimental results
   demonstrate that the proposed method can effectively optimize structures
   with nonlinear behaviors and exhibits significant advantages compared
   with the traditional homogenization-based topology optimization method.},
Type = {Article},
DOI = {10.1016/j.ijmecsci.2026.111380},
EarlyAccessDate = {FEB 2026},
Article-Number = {111380},
Keywords = {Machine learning; Topology optimization; Hyperelastic constitutive
   models; Multiscale SIMP optimization; Multiscale Topology Optimization
   Framework; Physics-informed machine learning methods},
Keywords-Plus = {STRESS; DESIGN; RUBBER; MODEL},
