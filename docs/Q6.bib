@article{ WOS:001710271400001,
Author = {El Hasadi, Yousef M. F. and Elghannay, Husam A.},
Title = {A physics aware symbolic regression formula for the wall effects on a
   sphere moving inside a cylindrical tube},
Journal = {INTERNATIONAL JOURNAL OF MULTIPHASE FLOW},
Year = {2026},
Volume = {198},
Month = {APR},
Abstract = {A physics-aware symbolic regression method is applied to model the wall
   correction factor fd for a sphere settling in an infinite cylinder.
   Experimental data from Fidleris and Whitmore (1961) are used for
   training. The resulting model expresses fd as quadratic polynomials with
   transcendental coefficients, covering the full spectrum of flow regimes
   from low Reynolds number creeping flow to fully turbulent flow. Model
   selection is guided by elements of statistical learning theory. High
   accuracy is achieved across Reynolds numbers and gap distances (1-b),
   where b is the ratio of sphere diameter to cylinder diameter. For Re ->
   0, the model reproduces the first two terms of Faxen's analytical
   solution (1921), demonstrating that physics-aware symbolic regression
   can extract closed-form solutions from experimental data. An analytical
   expression is also provided for the upper bound of fd in the turbulent
   regime. The non-dimensional viscous boundary layer governs transitions
   between flow regimes. In creeping flow, it is thicker for smaller b,
   while in the intermediate regime, it is thicker for larger b. A specific
   Reynolds number is identified at which the boundary layer equals the gap
   (1-b), yielding fd = (1-b). Comparisons with other machine learning
   methods are performed, and uncertainty quantification is provided for
   all models.},
Type = {Article},
DOI = {10.1016/j.ijmultiphaseflow.2026.105640},
EarlyAccessDate = {MAR 2026},
Article-Number = {105640},
