@article{ WOS:000604218100005,
Author = {Lu, Qiang and Tao, Fan and Zhou, Shuo and Wang, Zhiguang},
Title = {Incorporating Actor-Critic in Monte Carlo tree search for symbolic
   regression},
Journal = {NEURAL COMPUTING \& APPLICATIONS},
Year = {2021},
Volume = {33},
Number = {14, SI},
Pages = {8495-8511},
Month = {JUL},
Abstract = {Most traditional genetic programming methods that handle symbolic
   regression are random algorithms without memory and direction. They
   repeatedly search for the same or similar positions in the symbolic
   space, and easily fall into premature convergence. To overcome these
   shortcomings, we propose a new symbolic expression search algorithm
   based on the Monte Carlo tree search named SE-MCTS. It creates a tree to
   represent the symbolic space and remembers its visiting positions.
   Moreover, it incorporates two neural networks-Actor and Critic into the
   upper confidence bound to direct its search based on the given dataset
   features and decide when to use particle swarm optimization to find
   fitted constants in a mathematical expression. The experiment results
   show that SE-MCTS can discover more proper mathematical expressions than
   canonical genetic programming methods.},
Type = {Article},
DOI = {10.1007/s00521-020-05602-2},
EarlyAccessDate = {JAN 2021},
Keywords = {Symbolic regression; Monte Carlo tree search; Deep reinforcement
