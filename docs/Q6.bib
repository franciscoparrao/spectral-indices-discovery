@article{ WOS:001503389300008,
Author = {Zhang, Guiyong and Wang, Zihao and Shi, Chongbin and Sun, Tiezhi},
Title = {Manifold-embedded network dynamics for fluid flow prediction},
Journal = {PHYSICS OF FLUIDS},
Year = {2025},
Volume = {37},
Number = {6},
Month = {JUN},
Abstract = {In nonlinear fluid dynamics, identifying and predicting system behavior
   often requires dimensionality reduction to a low-dimensional manifold
   that preserves essential geometric and topological properties. This
   study combines Takens' delay embedding theorem for phase space
   reconstruction with manifold learning techniques to achieve an invariant
   representation of flow field dynamics. Additionally, complex network
   theory is employed to abstract system dynamics into a network structure,
   capturing community evolution over time. Using Isometric Mapping for
   nonlinear dimensionality reduction minimizes reconstruction error,
   facilitating accurate decoding and simplification of system complexity.
   Clustering algorithms further categorize flow field states into
   interpretable second-order states. For modeling and prediction, a Markov
   model-based random walk method is applied, demonstrating high-precision
   temporal predictions for first-order flow field states and steady-state
   predictions for second-order states. Unlike traditional symbolic
   regression, this approach leverages complex network mapping to establish
   probability transition matrices instead of explicit system equations,
   ensuring robustness across higher dimensions without sacrificing
   accuracy. The method proves efficient, unsupervised, and adaptable,
   promising advancements in nonlinear fluid system modeling and
   prediction.},
