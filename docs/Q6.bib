@article{ WOS:000317537200003,
Author = {Ulke-Winter, Lars and Klaerner, Matthias and Kroll, Lothar},
Title = {Determining the damping behavior of fiber reinforced composites A new
   approach to find mathematical relationships in data sets},
Journal = {COMPOSITE STRUCTURES},
Year = {2013},
Volume = {100},
Pages = {34-39},
Month = {JUN},
Abstract = {In this work a novel approach for the automatic development of closed
   mathematical models for measured or simulated data sets is introduced.
   For this purpose, a class library in the object-oriented programming
   language Python was implemented. This class library allows the
   identification of suitable mathematical expression for arbitrary
   dimensional point clouds using simultaneous numerical and symbolic
   regression. The corresponding computer program will be used to determine
   a damping model of a 0 degrees/90 degrees fiber-reinforced plastic
   layered structure based on a few measurements. The results are compared
   with an established damping model of FRP composites by Adams and Bacon.
   After a summary instructions follow for useful applications and basic
   procedures in the search of mathematical functions with the help of this
   algorithm. (C) 2013 Elsevier Ltd. All rights reserved.},
