@article{ WOS:001310822800022,
Author = {Rogers, Alexander W. and Lane, Amanda and Mendoza, Cesar and Watson,
   Simon and Kowalski, Adam and Martin, Philip and Zhang, Dongda},
Title = {Integrating Knowledge-Guided Symbolic Regression and Model-Based Design
   of Experiments to Accelerate Process Flow Diagram Development},
Journal = {IFAC PAPERSONLINE},
Year = {2024},
Volume = {58},
Number = {14},
Pages = {127-132},
Abstract = {New products must be formulated rapidly to succeed in the global
   formulated product market; however, key product indicators (KPIs) can be
   complex, poorly understood functions of the chemical composition and
   processing history. Consequently, process scale-up must currently
   undergo expensive trial-and-error campaigns. To accelerate process flow
   diagram (PFD) optimization and knowledge discovery, this work proposes a
   novel digital framework to automatically quantify process mechanisms by
   integrating symbolic regression (SR) within model based design of
   experiments (MBDoE). Each iteration, SR proposed a Pareto front of
   interpretable mechanistic expressions, and then MBDoE designs a new
   experiment to discriminate between them while automatically balancing
   the objective of PFD optimization. To investigate the framework's
   performance, a new process model capable of simulating general
   formulated product synthesis was constructed to generate in-silico data
   for different case studies. The framework could effectively discover
   ground-truth process mechanisms within a few iterations, indicating its
   great potential within the general chemical industry for digital
   manufacturing and product innovation. Copyright (C)2024 The Authors.
   This is an open access article under the CC BY-NC-ND license
   (htips://creativecommons.org/licenses/by-nc-nd/4.0/)},
Type = {Proceedings Paper},
DOI = {10.1016/j.ifacol.2024.08.325},
EarlyAccessDate = {SEP 2024},
Keywords = {knowledge discovery; symbolic regression; model-based design of
   experiments; interpretable machine learning; process flow diagram
   optimization},
Research-Areas = {Automation \& Control Systems},
Cited-References = {Angelis D, 2023, ARCH COMPUT METHOD E, V30, P3845, DOI 10.1007/s11831-023-09922-z.
   Brunton SL, 2016, P NATL ACAD SCI USA, V113, P3932, DOI 10.1073/pnas.1517384113.
   Cranmer M, 2023, Arxiv, DOI {[}arXiv:2305.01582, DOI 10.48550/ARXIV.2305.01582].
   de Franca FO, 2023, Arxiv, DOI arXiv:2304.01117.
