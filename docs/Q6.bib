@article{ WOS:001437958100001,
Author = {Wu, Ronghai and Zhang, Yuxin and Peng, Zichao and Song, Di and Li, Heng},
Title = {Predicting multiple fatigue properties of twinning-induced plasticity
   steels by black-box and white-box machine learning},
Journal = {MECHANICS OF MATERIALS},
Year = {2025},
Volume = {205},
Month = {JUN},
Abstract = {Predicting multiple fatigue properties of metals under a wide range of
   conditions is still a challenge, as massive high-dimension inputs and
   multiple outputs are involved. We systematically conduct fatigue
   experiments on TWIP steel under various conditions, including different
   preloading methods, temperatures, strain amplitudes and mean strains.
   Using experimental data, we propose both black-box and white-box machine
   learning models to predict the fatigue performance of TWIP steel. The
   black-box model employs dimensionality reduction, clustering and
   regression techniques to achieve simultaneous predictions for fatigue
   life and maximum stress amplitude. The predicted fatigue lives are 100\%
   within 3x error band and 88.31\% within 2x error band. The predicted
   maximum stress amplitudes are all within 1.51x error band. The white-box
   model utilizes symbolic regression and matching analysis to
   automatically discover several predictive formulas for fatigue life and
   maximum stress amplitude, without any predefined equations. The three
   optimal fatigue life prediction formulas yield 100\% predicted values
   within 3x error band and 98\% within 2x error band. The two optimal
   maximum stress amplitude prediction formulas yield predicted values all
   within 1.09x error band. Based on the results, we discuss the
   applicability of our models and propose suggestions for future
   developments in machine learning fatigue performance predictions.},
Type = {Article},
DOI = {10.1016/j.mechmat.2025.105307},
EarlyAccessDate = {MAR 2025},
