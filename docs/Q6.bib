@article{ WOS:001713018400001,
Author = {Gupta, Hemant and Seth, Hemang and Kaushik, Sunny and Mogli, Rohit and
   Mahalanabis, Riddhika and Ashok, Balakrishnan},
Title = {Predicting glass transition temperature using molecular structure
   factors: Organic molecular compounds \& polymers},
Journal = {JOURNAL OF COMPUTATIONAL SCIENCE},
Year = {2026},
Volume = {96},
Month = {MAY},
Abstract = {The glass transition temperature (Tg) is a critical property determining
   the performance and processability of organic compounds and amorphous
   polymers. Often, Tg for a material is obtained by using the melting
   point temperature, Tm, using the Boyer-Beaman relation. We demonstrate
   that Tg can instead be accurately predicted from molecular structure
   alone by combining structural descriptors, such as molecular branching
   and atomic composition ratios extracted from SMILES, with machine
   learning and symbolic regression. In our earlier work (Kaushik et al.,
   2025), we established a melting-point-independent, interpretable
   framework for Tg prediction in organic molecular glasses. Building on
   that, the present work studies polymer-solvent interactions to develop a
   unified, data-driven approach for predicting Tg in both organic
   molecular glasses and solvent-plasticized systems. We incorporate
   polymer conformational property descriptors and solvent physicochemical
   features, including molar refractivity and radius of gyration computed
   using RDKit. Twelve machine-learning models are benchmarked, with
   XGBoost delivering the highest accuracy, while Gaussian Process
   Regression provides uncertainty-aware predictions. We find that both the
   molecular mass and the number of branches in the molecular structure of
   the compound, play important roles in determining Tg for both organic
   molecular glasses, as well as macromolecules. The molar refractivity is
   additionally found to be a very important descriptor in determining Tg
   for polymers. This extended study unifies Tg prediction in organic
   molecular glasses and polymer-solvent composite systems within a single
   data-driven framework, substantially broadening the scope of our earlier
   work and offering insights for inverse materials design. This paper is
   an extension of our earlier work, Kaushik et al. (2025) published at
   ICCS-2025.},
Type = {Article},
DOI = {10.1016/j.jocs.2026.102822},
Article-Number = {102822},
Keywords = {Glass transition temperature prediction; Inverse design of materials;
   Machine learning; Materials design; Molecular structural features},
