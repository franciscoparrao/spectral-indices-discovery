@article{ WOS:001231008100019,
Author = {Beckers, Sam J. and Poppelaars, Colin M. and Ulibarrena, Veronica S. and
   Boekholt, Tjarda C. N. and Zwart, Simon F. Portegies},
Title = {Individual chaotic behaviour of the S-stars in the Galactic centre},
Journal = {ASTRONOMY \& ASTROPHYSICS},
Year = {2024},
Volume = {685},
Month = {APR 30},
Abstract = {Located at the core of the Galactic centre, the S-star cluster serves as
   a remarkable illustration of chaos in dynamical systems. The long-term
   chaotic behaviour of this system can be studied with gravitational
   N-body simulations. By applying a small perturbation to the initial
   position of star S5, we can compare the evolution of this system to its
   unperturbed evolution. This results in two solutions that diverge
   exponentially, defined by the separation in position space delta(r),
   with an average Lyapunov timescale of similar to 420 yr, corresponding
   to the largest positive Lyapunov exponent. Even though the general trend
   of the chaotic evolution is governed in part by the supermassive black
   hole Sagittarius A{*} (Sgr A{*}), individual di fferences between the
   stars can be noted in the behaviour of their phase-space curves. We
   present an analysis of the individual behaviour of the stars in this
   Newtonian chaotic dynamical system. The individuality of their behaviour
   is evident from o ffsets in the position space separation curves of the
   S-stars and the black hole. We propose that the o ffsets originate from
   the initial orbital elements of the S-stars, where Sgr A{*} is
   considered in one of the focal points of the Keplerian orbits. Methods
   were considered to find a relation between these elements and the
   separation in position space. Symbolic regression provides the clearest
   diagnostics for finding an interpretable expression for the problem. Our
   symbolic regression model indicates that <delta(r)> proportional to /
   e(2.3), implying that the time-averaged individual separation in
   position space increases rapidly with the initial eccentricity of the
   S-stars.},
Type = {Article},
DOI = {10.1051/0004-6361/202348361},
Article-Number = {A12},
Keywords = {chaos; methods: numerical; celestial mechanics; stars: black holes;
   stars: fundamental parameters; Galaxy: center},
Research-Areas = {Astronomy \& Astrophysics},
Cited-References = {Boekholt TCN, 2023, INT J MOD PHYS D, V32, DOI 10.1142/S0218271823420038.
   Cranmer M, 2023, Arxiv, DOI {[}arXiv:2305.01582, DOI 10.48550/ARXIV.2305.01582].
   Gillessen S, 2009, ASTROPHYS J, V692, P1075, DOI 10.1088/0004-637X/692/2/1075.
   Matchev KT, 2022, ASTROPHYS J, V930, DOI 10.3847/1538-4357/ac610c.
   Zwart SFP, 2023, MON NOT R ASTRON SOC, V526, P5791, DOI 10.1093/mnras/stad2654.},
Number-of-Cited-References = {5},
Times-Cited = {2},
Unique-ID = {WOS:001231008100019},
OA = {Green Submitted, gold},
