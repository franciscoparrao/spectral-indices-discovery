@article{ WOS:001564622100003,
Author = {Zhao, Wenbin and Liu, Baoyin and Zhang, Kun and Yuan, Haosen and Zhao,
   Yi and Li, Jian and Tan, Changlong and Li, Bing},
Title = {Giant barocaloric effect in Ni-Cu-Mn-Sn shape memory alloys via physical
   descriptors driven design},
Journal = {ACTA MATERIALIA},
Year = {2025},
Volume = {299},
Month = {OCT 15},
Abstract = {The urgent global demand for energy-efficient, solid-state refrigeration
   has spurred the search for advanced cooling materials. Ni-Mn-based
   memory alloys offer a unique promise for barocaloric effect (BCE)
   cooling. However, achieving both a large isothermal entropy change
   (Delta S) and low thermal hysteresis (Delta Thys) near room temperature
   remains a major challenge. In this work, we establish a physical
   descriptors driven computational-experimental framework for BCE
   performance design within the Ni-Mn-Sn-based system. We evaluate key
   physical descriptors, including martensitic transformation temperature,
   the lattice volume change, and magnetic moment difference, to identify
   promising compositions. After systematic screening of multiple elemental
   dopants, experimental validation confirms that the optimized
   Ni26Cu22Mn46Sn6 alloy exhibits a giant Delta S of -40.47 J kg-1 K-1 and
   a low Delta Thys of 5.3 K under a moderate pressure of 1 kbar. A
   constitutive relation between temperature and pressure-induced Delta S
   is further derived using symbolic regression, providing thermodynamic
   insight into BCE. These results demonstrate the potential of this
   strategy to accelerate discovery of efficient BCE alloys.},
Type = {Article},
DOI = {10.1016/j.actamat.2025.121471},
EarlyAccessDate = {AUG 2025},
Article-Number = {121471},
Keywords = {Barocaloric effect; Shape memory alloys; Martensitic transformation;
   First-principles calculation; Symbolic regression},
Keywords-Plus = {INITIO MOLECULAR-DYNAMICS; MARTENSITIC-TRANSFORMATION;
