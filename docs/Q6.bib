@article{ WOS:000371842300002,
Author = {Golafshani, Emadaldin Mohammadi and Ashour, Ashraf},
Title = {Prediction of self-compacting concrete elastic modulus using two
   symbolic regression techniques},
Journal = {AUTOMATION IN CONSTRUCTION},
Year = {2016},
Volume = {64},
Pages = {7-19},
Month = {APR},
Abstract = {This paper introduces a novel symbolic regression approach, namely
   biogeographical-based programming (BBP), for the prediction of elastic
   modulus of self-compacting concrete (SCC). The BBP model was constructed
   directly from a comprehensive dataset of experimental results of SCC
   available in the literature. For comparison purposes, another new
   symbolic regression model, namely artificial bee colony programming
   (ABCP), was also developed. Furthermore, several available formulas for
   predicting the elastic modulus of SCC were assessed using the collected
   database.
   The results show that the proposed BBP model provides slightly closer
   results to experiments than ABCP model and existing available formulas.
   A sensitivity analysis of BBP parameters also shows that the prediction
   by BBP model improves with the increase of habitat size, colony size,
   and maximum tree depth. In addition, among all considered empirical and
   design code equations, Leemann and Hoffmann and ACI 318-08's equations
   exhibit a reasonable performance but Persson and Felekoglu et al.'s
   equations are highly inaccurate for the prediction of SCC elastic
   modulus. (C) 2016 Elsevier B.V. All rights reserved.},
