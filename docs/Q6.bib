@article{ WOS:001585569400001,
Author = {Li, Cheng and Liang, Qingkai and Zhou, Yumei and Xue, Dezhen},
Title = {A knowledge-based materials descriptor for compositional dependence of
   phase transformation in NiTi shape memory alloys},
Journal = {MATERIALS GENOME ENGINEERING ADVANCES},
Year = {2025},
Volume = {3},
Number = {1},
Month = {MAR},
Abstract = {This study presents triangle tau, a novel descriptor that captures the
   compositional dependence of phase transformation temperature (Ap) in
   NiTi-based shape memory alloys (SMAs). Designed to address the
   complexity of multicomponent SMAs, triangle tau was integrated into
   symbolic regression (SR) and kernel ridge regression (KRR) models,
   yielding substantial improvements in predicting key functional
   properties: transformation temperature, enthalpy, and thermal
   hysteresis. Using the KRR model with triangle tau, we explored the
   NiTiHfZrCu compositional space, identifying six promising alloys with
   high Ap (>250 degrees C), large enthalpy (>27 J/g), and low thermal
   hysteresis. Experimental validation confirmed the model's accuracy with
   the alloys showing high-temperature transformation behavior and low
   hysteresis, suitable for high-performance applications in aerospace and
   nuclear industries. These findings underscore the power of
   domain-informed descriptors like triangle tau in enhancing machine
   learning-driven materials design.},
Type = {Article},
DOI = {10.1002/mgea.72},
Article-Number = {e72},
Keywords = {feature engineering; machine learning; materials descriptor; materials
   informatics; shape memory alloys},
Keywords-Plus = {HIGH ENTROPY ALLOYS; MARTENSITIC-TRANSFORMATION; MICROSTRUCTURE;
