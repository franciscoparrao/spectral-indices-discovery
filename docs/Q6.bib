@article{ WOS:001428151500001,
Author = {Maraschin, Mikael and Lanzanova, Thompson Diordinis Metzka and Salau,
   Nina Paula Goncalves},
Title = {Predictions of heat of combustion and formation by interpretable machine
   learning algorithms},
Journal = {FUEL},
Year = {2025},
Volume = {390},
Month = {JUN 15},
Abstract = {The prediction of heat of combustion and formation for chemical
   substances is essential for improving energy efficiency, optimizing
   equipment design, and evaluating reaction spontaneity. This study
   evaluates black box models, including Artificial Neural Networks (ANN),
   Gradient Boosting (GB), and Support Vector Machines (SVM), alongside
   white box models, such as multivariable linear regression (MLR) and
   Symbolic Regression (SR). A dataset of 2,694 substances, described using
   atom-based features (C, H, O, N, and S counts) and bond-based features
   (28 bond types, including single, double, aromatic, and triple bonds),
   was analyzed. GB demonstrated the most consistent performance across
   tasks and feature sets. For heat of combustion, GB achieved a test MSE
   of 2956.01 kcal/mol with atom-based features, outperforming MLR and SR
   by over 50 \%, while ANN excelled with bond-based features (MSE =
   2414.70 kcal/mol). For heat of formation, GB was the top model in both
   feature sets, with bond-based features yielding an MSE of 618.79
   kcal/mol. SHapley Additive exPlanations (SHAP) analysis identified key
   predictors, such as carbon-hydrogen and aromatic carbon-carbon bonds,
   demonstrating GB's interpretability. Although ANN excelled in specific
   cases, GB's overall reliability and ease of interpretation make it the
   preferred model for predicting thermodynamic properties. SHAP analysis
   enhanced the interpretability of black-box models by identifying key
   predictors such as carbon-hydrogen and aromatic carbon-carbon bonds,
   bridging the gap between predictive accuracy and model explainability.
   These results emphasize the importance of feature selection and
   interpretable machine learning in advancing chemical engineering
   applications.},
Type = {Article},
DOI = {10.1016/j.fuel.2025.134699},
EarlyAccessDate = {FEB 2025},
Article-Number = {134699},
Keywords = {Multivariable linear regression model; Symbolic regression; Artificial
   Neural Networks; Gradient Boosting; Support Vector Machine; SHapley
   Additive exPlanations},
