@article{ WOS:001637015300001,
Author = {Lou, Jinhua and Chen, Rongqian and Wu, Hao and Bao, Yue and Zhou, Shupei
   and Lin, Yuqiao and You, Yancheng},
Title = {A framework for flight vehicle aerodynamic data fusion based on
   generative models and interpretability methods},
Journal = {AEROSPACE SCIENCE AND TECHNOLOGY},
Year = {2026},
Volume = {169},
Month = {FEB},
Abstract = {The acquisition of high-fidelity aerodynamic data for flight vehicles
   through wind tunnel experiments often incurs substantial costs and
   resource demands. To enable the effective integration of low-fidelity
   computational fluid dynamics (CFD) simulation data with limited
   experimental measurements, we propose a guided diffusion model for
   aerodynamic data fusion (GDFuse) in this work. This model integrates a
   guided mechanism with a denoising diffusion probabilistic model (DDPM),
   where constraints applied to both the forward and backward diffusion
   processes enhance generation stability and correction accuracy. Using an
   axisymmetric flight vehicle configuration from a NASA report as a case
   study, GDFuse learns the noise distribution during the forward diffusion
   process and gradually removes noise in the backward process to
   approximate wind tunnel results. To overcome the challenge of
   insufficient experimental coverage across diverse geometries, transfer
   learning is incorporated to extend the learned fusion knowledge to new
   axisymmetric flight vehicle configurations. This strategy improves
   prediction accuracy in small-scale datasets while significantly reducing
   training costs. GDFuse supports both direct error correction and
   residual-based correction strategies. Experimental results show relative
   errors of 5.11 \%, 1.52 \%, and 7.69 \% for three aerodynamic
   coefficients, outperforming conventional fusion approaches that include
   guided models, random forests, and multi-fidelity neural networks. To
   address the limited interpretability of GDFuse, we further incorporate
   symbolic regression and sensitivity analysis to derive physically
   interpretable expressions and to assess the influence of flow conditions
   and fin deflection on aerodynamic responses. These methods enhance the
   interpretability of the model, making GDFuse a high-accuracy and
   generalizable solution for aerodynamic data fusion.},
Type = {Article},
DOI = {10.1016/j.ast.2025.111346},
