@article{ WOS:001555948000034,
Author = {Guo, Wenjian and Wang, Fenglin and Zhang, Zhenzhao and Liu, Zhuofeng and
   Zhang, Weijun and Bai, Shuxin},
Title = {Accelerated design of high thermal conductivity
   Si3N4 ceramics based on machine learning},
Journal = {CERAMICS INTERNATIONAL},
Year = {2025},
Volume = {51},
Number = {21, A},
Pages = {33145-33154},
Month = {SEP},
Abstract = {This study leverages machine learning approaches to accelerate the
   design of silicon nitride (Si3N4) ceramics and to elucidate thermal
   conduction mechanisms through comprehensive data analysis. Using
   sintering additive content and processing parameters (8-dimension) as
   input features, multiple machine learning models were evaluated, with
   the Random Forest model demonstrating superior predictive accuracy (R-2
   = 0.85). SHAP (SHapley Additive exPlanations) analysis revealed that
   elevated sintering temperature and extended duration significantly
   enhance thermal conductivity, while Y2O3 emerged as the most crucial
   sintering additive. Symbolic regression analysis indicated that thermal
   conductivity exhibits linear correlation with sintering time but
   exponential dependence on temperature, particularly pronounced at higher
   Si3N4 content (>90 wt\%). Active learning-recommended formulations
   incorporating Y2O3-MgSiN2 additives, processed via spark plasma
   sintering (1800 degrees C, 0.5 h), yielded densified ceramics with
   thermal conductivity reaching 67.5 W m(-1) K-1. Microstructural analysis
   revealed rod-like Si3N4 grains with optimized grain boundary phases,
   facilitating enhanced thermal conduction.},
