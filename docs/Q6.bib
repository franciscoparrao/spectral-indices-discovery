@article{ WOS:000322616900006,
Author = {Faris, Hossam and Sheta, Alaa and Oznergiz, Ertan},
Title = {Modelling hot rolling manufacturing process using soft computing
   techniques},
Journal = {INTERNATIONAL JOURNAL OF COMPUTER INTEGRATED MANUFACTURING},
Year = {2013},
