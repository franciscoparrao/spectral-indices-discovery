DOI = {10.1016/j.jmrt.2023.09.135},
EarlyAccessDate = {SEP 2023},
Keywords = {Ductile-to-brittle transition; Intermetallic compounds; Machine
   learning; Symbolic regression},
Keywords-Plus = {MECHANICAL-PROPERTIES; DISLOCATION GENERATION; DEFORMATION-BEHAVIOR;
   OXIDATION BEHAVIOR; IRON ALUMINIDES; ALLOYS; MICROSTRUCTURE; DEPENDENCE;
