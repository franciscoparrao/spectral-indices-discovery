@article{ WOS:000633151000001,
Author = {Lucena-Sanchez, Estrella and Sciavicco, Guido and Stan, Ionel Eduard},
Title = {Feature and Language Selection in Temporal Symbolic Regression for
   Interpretable Air Quality Modelling},
Journal = {ALGORITHMS},
Year = {2021},
Volume = {14},
Number = {3},
Month = {MAR},
Abstract = {Air quality modelling that relates meteorological, car traffic, and
   pollution data is a fundamental problem, approached in several different
   ways in the recent literature. In particular, a set of such data sampled
   at a specific location and during a specific period of time can be seen
   as a multivariate time series, and modelling the values of the pollutant
   concentrations can be seen as a multivariate temporal regression
   problem. In this paper, we propose a new method for symbolic
   multivariate temporal regression, and we apply it to several data sets
   that contain real air quality data from the city of Wroclaw (Poland).
   Our experiments show that our approach is superior to classical,
   especially symbolic, ones, both in statistical performances and the
   interpretability of the results.},
Type = {Article},
DOI = {10.3390/a14030076},
Article-Number = {76},
Keywords = {temporal regression; symbolic regression; air quality modelling},
