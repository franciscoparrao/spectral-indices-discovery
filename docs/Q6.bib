@article{ WOS:001339951900001,
Author = {Ko, Taeseo and Park, Taehyun and Kim, Minseon and Min, Kyoungmin},
Title = {Enhancing predictions of experimental band gap using machine learning
   and knowledge transfer},
Journal = {MATERIALS TODAY COMMUNICATIONS},
Year = {2024},
Volume = {41},
Month = {DEC},
Abstract = {Density functional theory (DFT) calculations using the generalized
   gradient approximation (GGA) functional are known to underestimate the
   bandgap (Eg) compared with experimental values. Although hybrid
   functionals can address this issue, they are limited by their high
   computational costs. This paper presents a novel and efficient method to
   predict experimental Eg more accurately using machine learning (ML)
   models enhanced with knowledge transfer learning. We developed surrogate
   models based on the Eg calculated using the GGA functional and easily
   obtainable features from chemical formulas. These models exhibited
   superior prediction accuracy, with a coefficient of determination (R2)
   of 0.817 and a mean absolute error (MAE) of 0.289 eV. We further
   performed feature importance analysis and symbolic regression to provide
   a detailed interpretation of the ML models. It was verified that various
   features, such as the potential to form ionic compounds and the number
   of elements in a material, have a major influence on experimental Eg
   predictions. Based on these results, an interpretable formula for
   experimental Eg was derived, which can be used in future studies.
   Consequently, we developed a platform for predicting the experimental Eg
   values of inorganic materials, effectively narrowing the gap between
   theoretical calculations and experiments, which can be used to screen
   novel materials with promising properties.},
Type = {Article},
DOI = {10.1016/j.mtcomm.2024.110717},
Article-Number = {110717},
Keywords = {Bandgap; Machine learning; Transfer learning; Feature importance
   analysis; Symbolic regression},
