@article{ WOS:001570519100006,
Author = {Zhang, Yuzhuo and Xi, Meng and Liu, Jinlong and Wang, Weiwei and Lyu,
   Xuetao},
Title = {Axial compressive capacity prediction of coal gangue concrete-filled
   steel tube stub columns: Genetic programming-augmented code calibration
   and Bayesian-optimized machine learning},
Journal = {STRUCTURES},
Year = {2025},
Volume = {80},
Month = {OCT},
Abstract = {The growing demand for green construction materials in building
   engineering has driven innovations in sustainable structural design.
   This demand has further intensified the urgency of coal gangue (CG)
   recycling, propelling the development of coal gangue concrete-filled
   steel tube (CGCFST) columns. However, existing design codes for
   predicting axial compressive capacity suffer from limited accuracy and
   applicability, and they fail to adequately account for the effects of CG
   aggregate replacement ratios. To address the aforementioned limitations,
   this study develops a genetic programming-augmented code calibration
   approach combined with Bayesian-optimized machine learning (ML).
   Leveraging experimental data from 96 circular CGCFST specimens, we
   establish a comprehensive database incorporating seven critical
   parameters-including CG aggregate replacement ratios for both coarse and
   fine aggregates. Systematic evaluation of 18 existing models through
   TOPSIS analysis exposes significant underestimation (up to 40 \% errors)
   in conventional code formulations, particularly in accounting for CG
   substitution effects. Through genetic programming-symbolic regression
   (GPSR), we enhance four design codes, achieving a 63.61 \% RMSE
   reduction in the AIJ-optimized model via evolutionary algorithm-driven
   code calibration. Parallel development of eight Bayesian-optimized
   machine learning models identifies CatBoost as the superior predictor
   (R2=0.988), with SHapley Additive exPlanations (SHAP) interpretability
   analysis quantifying how CG replacement ratios dynamically alter feature
   importance hierarchies through nonlinear interactions. The GP-SR
   calibrated codes provide physics-informed equations compatible with
   engineering practice, while the Bayesian-optimized ML models establish
   new accuracy benchmarks. This dual approach combines theoretical
   interpretability and data-driven prediction, offering effective
   solutions to boost CG aggregate applications in building engineering and
   sustainable structural design.},
Type = {Article},
DOI = {10.1016/j.istruc.2025.110119},
EarlyAccessDate = {SEP 2025},
Article-Number = {110119},
