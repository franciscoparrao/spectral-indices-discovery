@incollection{ WOS:000683104600086,
Author = {Biggio, Luca and Bendinelli, Tommaso and Neitz, Alexander and Lucchi,
   Aurelien and Parascandolo, Giambattista},
Editor = {Meila, M and Zhang, T},
Title = {Neural Symbolic Regression that Scales},
Booktitle = {INTERNATIONAL CONFERENCE ON MACHINE LEARNING, VOL 139},
Series = {Proceedings of Machine Learning Research},
Year = {2021},
Volume = {139},
Abstract = {Symbolic equations are at the core of scientific discovery. The task of
   discovering the underlying equation from a set of input-output pairs is
   called symbolic regression. Traditionally, symbolic regression methods
   use hand-designed strategies that do not improve with experience. In
   this paper, we introduce the first symbolic regression method that
   leverages large scale pre-training We procedurally generate an unbounded
   set of equations, and simultaneously pre-train a Transformer to predict
   the symbolic equation from a corresponding set of input-output-pairs. At
   test time, we query the model on a new set of points and use its output
   to guide the search for the equation. We show empirically that this
   approach can re-discover a set of well-known physical equations, and
   that it improves over time with more data and compute.},
