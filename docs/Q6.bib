@article{ WOS:000795071700005,
Author = {Jiang, Lei and Fu, Huadong and Zhang, Hongtao and Xie, Jianxin},
Title = {Physical mechanism interpretation of polycrystalline metals' yield
   strength via a data-driven method: A novel Hall-Petch relationship},
Journal = {ACTA MATERIALIA},
Year = {2022},
Volume = {231},
Month = {JUN 1},
Abstract = {The Hall-Petch relationship sigma(y) = sigma(0) + k(y)d(-0. 5) is widely
   used to describe the relationship between yield strength and grain size
   of polycrystalline metals, and the material constants sigma(0) and k(y)
   fitted by experimental data are interpreted as lattice friction
   resistance and coefficient of grain boundary resistance, respectively.
   The frequent deviations from the Hall-Petch relationship between ay and
   d in coarser or finer grains, as well as the physical essence of
   sigma(0) and k(y), have always been the focus of material scientists. In
   this study, intrinsic factors of the fitted constants sigma(0) and k(y)
   in the traditional Hall-Petch relationship are mined via a data-driven
   machine learning method, which reveals that the key physical quantities
   affecting a0 are valence electron distance (S), cohesive energy (W), and
   coefficient of linear thermal expansion (l(t)); meanwhile, the key
   physical quantities affecting k(y) are grain boundary interface energy
   (gamma), Young's modulus ( E ) and coefficient of linear thermal
   expansion (l(t)). Then, a novel Hall-Petch model sigma(y) = 79W/(S-3
   root l(t)) + 1. 2 root gamma E/l(t)d(-0. 5) with satisfying prediction
   accuracy is constructed by symbolic regression methods. There is no
   experimental fitting constant term in the novel model, which can
   directly predict the yield strength of polycrystalline metals by key
   physical quantities. The novel Hall-Petch model has an excellent
   generalization ability and can be extended to the correlation
   calculation between the composition, grain structure and mechanical
   properties of single-phase alloys, which provides a theoretical method
   for the trans-scale calculation of metallic materials. (C) 2022 Acta
   Materialia Inc. Published by Elsevier Ltd. All rights reserved.},
Type = {Article},
DOI = {10.1016/j.actamat.2022.117868},
EarlyAccessDate = {MAR 2022},
Article-Number = {117868},
Keywords = {Machine learning; Hall-Petch relationship; Symbolic regression; Grain
