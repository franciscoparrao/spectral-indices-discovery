@article{ WOS:000860842100021,
Author = {Roland, Wolfgang and Stritzinger, Ursula and Albrecht, Hanny and
   Low-Baselli, Bernhard and Berger-Weber, Gerald},
Title = {A Hybrid Approach to Model the Drag-Flow Capacity of Co-Rotating Twin
   Screw Extruder Kneading Blocks},
Journal = {IFAC PAPERSONLINE},
Year = {2022},
Volume = {55},
Number = {20},
Pages = {121-126},
Abstract = {Co-rotating twin-screw extruders are one of the most important
   processing machines in the polymer industry, and in many related such as
   pharmaceutical, chemical, and food industry. Modelling the processing
   behaviour is commonly based on analytical approaches building on
   significant simplifications, such as approximating kneading blocks by
   conveying elements and considering a flat channel approximation. The
   most important conveying parameter is the drag-flow capacity, which
   mainly influences the degree of filling and the distribution of the
   processed material inside the extruder. In this work, we present a novel
   generalized regression model, with which it is for the first time
   possible to analytically predict the drag-flow rate of
   fully-intermeshing co-rotating twin-screw extruder kneading blocks
   considering the accurate three-dimensional flow geometry. Therefore, we
   first analysed the problem and governing equations, then applied the
   theory of similarity to identify the characteristic influencing
   parameters and reduce the parameter space, next conducted a
   parametrically driven numerical design study, and finally developed the
   symbolic regression models based on the simulated data. The highly
   accurate model allows fast, stable, and accurate prediction of the
   drag-flow capacity, thus contributing to optimal design of extruder
   screws without the need for numerical simulations. Copyright (C) 2022
   The Authors.},
Type = {Proceedings Paper},
DOI = {10.1016/j.ifacol.2022.09.082},
Keywords = {process modelling; extrusion; model reduction; statistical data
   analysis; knowledge discovery; data mining},
Keywords-Plus = {LIQUIDS},
