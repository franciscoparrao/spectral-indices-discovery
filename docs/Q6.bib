Booktitle = {GENETIC PROGRAMMING THEORY AND PRACTICE IV},
Series = {Genetic and Evolutionary Computation},
Year = {2007},
Volume = {4},
Pages = {219+},
Abstract = {We discuss the difficulties of circuit sizing and describe manual and
   automatic approaches to it. These approaches make use of blackbox
   optimization techniques such as evolutionary algorithms or convex
   optimization techniques such as geometric programming. Geometric
   programming requires posynomial expressions for a circuit's performance
   measurements. We show how a genetic algorithm can be exploited to evolve
   a posynomial expression (i.e. model) of transistor (i.e. mosfet)
   behavior more accurately than statistical techniques in the literature.},
