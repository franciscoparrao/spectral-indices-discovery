@article{ WOS:001632731800012,
Author = {Huang, Xinyu and Tang, Jun and Shen, Yongming and Yi, Honglin and Zhang,
   Chenhao},
Title = {Formula for irregular wave overtopping on vegetated seawall derived from
   physics-guided deep symbolic regression},
Journal = {ADVANCED ENGINEERING INFORMATICS},
Year = {2026},
Volume = {70},
Month = {MAR},
Abstract = {Accurate prediction of wave overtopping for vegetated seawalls remains a
   critical challenge in coastal engineering, with no established empirical
   formulas currently available. This study bridges this gap by pioneering
   the application of deep physical symbolic regression (PhySO) to derive,
   for the first time, governing equations for irregular wave overtopping
   on these eco-friendly hybrid structures, providing a robust and
   interpretable tool for their design and safety assessment. Physical
   experiments simulating wave climates generated irregular wave
   overtopping data, establishing a foundational dataset for leveraging the
   deep physical symbolic regression algorithm to decode governing physical
   laws. The results show that PhySO was able to efficiently and accurately
   derive a spectrum of expressions relating overtopping to wave, seawall,
   and vegetation parameters, spanning mathematically parsimonious to
   physically interpretable forms. Through multi-criteria evaluation
   balancing simplicity, practicality, and accuracy, a robust predictive
   expression was established with R-Square of 0.74, Mean Absolute Error of
   14.28, Root Mean Square Error of 14.52, representing complex
   vegetation-wave-structure interactions through dimensionless groupings.
   The applicable scope covering critical hydraulic regimes was
   systematically defined using experimental parameter extrema. Meanwhile,
   the physical significance of the derived formula is elucidated,
   revealing a reformulated freeboard dependence and a nonlinear vegetation
   attenuation mechanism.},
Type = {Article},
DOI = {10.1016/j.aei.2025.104128},
EarlyAccessDate = {NOV 2025},
Article-Number = {104128},
Keywords = {Vegetated seawall; Wave overtopping; Deep physical symbolic regression;
