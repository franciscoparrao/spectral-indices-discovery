DOI = {10.1016/j.spc.2021.12.025},
EarlyAccessDate = {JAN 2022},
Keywords = {Surrogate model; Symbolic regression; Stochastic impacts by regression
   on; population; Affluence and technology (STIRPAT); Greenhouse gas (GHG)
   emissions; Eora environmentally extended multi-region; input-output
   database},
