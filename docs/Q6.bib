@article{ WOS:001700440500003,
Author = {Cheng, Zhang and Wei, Zhongwang and Wei, Shangguan and Fan, Bai and
   Dong, Wenzong and Xiao, Qiyun and Zhao, Hongwei and Liu, Pingping and
   Li, Qingliang and Dai, Yongjiu},
Title = {Soil hydraulic pedotransfer functions for estimating saturated hydraulic
   conductivity: a deep symbolic regression approach with mean shift
   clustering},
Journal = {JOURNAL OF HYDROLOGY},
Year = {2026},
Volume = {669},
Number = {B},
Month = {APR},
Abstract = {Soil saturated hydraulic conductivity (Ks) is a critical parameter in
   hydrology and land surface modeling, yet its accurate estimation remains
   challenging. Pedotransfer functions (PTFs) offer a practical solution
   but face a persistent trilemma: balancing predictive accuracy,
   interpretability, and model integrability. Classical PTFs are integrable
   but often simplistic, while advanced machine learning models are
   accurate but operate as non-analytic ``black boxes,{''} which prevents
   their formulation as explicit functions that can be readily embedded
   within the computational structure of process-based models. To bridge
   this gap, we propose a novel two-step framework: Deep Symbolic
   Regression coupled with Mean Shift clustering (DSR-MS). This method
   first partitions a global soil dataset into homogeneous clusters based
   on intrinsic properties. It then applies symbolic regression within each
   cluster to derive explicit, interpretable mathematical formulas for Ks.
   Evaluated against a global database, DSRMS achieved a Concordance
   Correlation Coefficient (CCC) of 0.695, significantly outperforming
   classical PTFs and a median-based ensemble benchmark (CCC = 0.448),
   while closely approaching the accuracy of a state-ofthe-art Random
   Forest model (CCC = 0.725). Crucially, unlike machine learning models,
   DSR-MS directly yields transparent, ready-to-integrate equations.
   Applied to SoilGrids 2.0 data, the explicit functions generated a
   global, physically plausible Ks map that demonstrated a 25.9\%
   improvement in concordance over the median-based scheme when validated
   against independent field measurements. The DSR-MS framework provides a
   promising pathway to reconcile the
   accuracy-interpretability-integrability trade-off, offering a powerful,
   nextgeneration tool for parameterizing soil hydraulic properties in
   Earth system models.},
Type = {Article},
DOI = {10.1016/j.jhydrol.2026.135173},
Article-Number = {135173},
Keywords = {Associate Editor; Pedotransfer functions; Ksat estimation; Symbolic
   regression; Unsupervised clustering; Soil hydraulic properties},
