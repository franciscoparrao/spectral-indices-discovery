@article{ WOS:001696086000001,
Author = {Zhang, Leilei and Huang, Shiping and Wei, Yaru and Zhang, Ziyin and Gu,
   Zhengyan and Yang, Baochen},
Title = {Unraveling the phase transition mechanism of 1:1 stoichiometric AlCu
   alloy under high pressure: a combined DFT and machine learning study},
Journal = {COMPUTATIONAL AND THEORETICAL CHEMISTRY},
Year = {2026},
Volume = {1258},
Month = {APR},
Abstract = {Understanding structural phase transition in alloy is of fundamental
   importance for both material science and industrial applications. In
   this study, density functional theory calculations determined the phase
   transition sequence of AlCu alloy with 1:1 stoichiometry under 0-200 GPa
   as I2/m -> Pmma (similar to 8.56 GPa)-> Pm (3) over barm((similar to
   184.85 GPa). Interpretable machine learning techniques revealed that the
   structural phase transition is predominantly driven by significant
   charge transfer from aluminum (Al) atoms to their coordinated copper
   (Cu) atoms. The relatively simple set of the equation derived from
   symbolic regression demonstrates high accuracy in predicting the
   enthalpy (H) of AlCu alloy. Analysis of the generated equations
   indicates that the first term in the equations is positively correlated
   with the target variable, achieving a correlation coefficient (R-2) of
   up to 0.98. We also designed two AlCu alloy models that were not
   included in the training data, and the symbolic regression equations fit
   very well, accurately reproducing the enthalpy. These findings offer
   fundamental insights into the structural evolution of AlCu alloys under
   pressure and highlight the potential of using machine learning to
   identify precise and physically meaningful models in Al-Cu based shape
   memory alloys.},
Type = {Article},
DOI = {10.1016/j.comptc.2026.115713},
EarlyAccessDate = {FEB 2026},
Article-Number = {115713},
Keywords = {AlCu alloy; Phase transition; High pressure; First-principles
   calculations; Interpretable machine learning},
