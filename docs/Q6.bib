@article{ WOS:001601276300001,
Author = {Huang, Tao and Wang, Xuesong and Wang, Liangting and Ning, Lixin},
Title = {Hierarchical symbolic regression modeling and physical mechanism study
   of Stokes shift of Cr3+-activated double perovskite phosphors},
Journal = {JOURNAL OF LUMINESCENCE},
Year = {2026},
Volume = {289},
Month = {JAN},
Abstract = {The design of high-performance near-infrared (NIR) phosphors is often
   hindered by the complex interplay of structural and electronic factors.
   Here, we present an interpretable machine learning framework combining
   random forest, SISSO-based symbolic regression, and PySR equation
   discovery to model Stokes shifts with minimal data. Unlike traditional
   black-box models, this approach incorporates physical domain knowledge,
   revealing that an inductive effect rooted in electronegativity mismatch
   and covalent bonding changes is the dominant structural descriptor. When
   applied to Cr3+-doped double perovskites, the model achieves high
   accuracy (RMSE = 0.0421 eV) through repeated five-fold cross-validation.
   It also demonstrates excellent generalizability across diverse material
   systems, including perovskites and garnets. This method not only
   outperforms existing black-box models but also provides mechanistic
   insights, enabling a generalizable, data-efficient pathway for rational
   design of NIR phosphors.},
Type = {Article},
DOI = {10.1016/j.jlumin.2025.121607},
