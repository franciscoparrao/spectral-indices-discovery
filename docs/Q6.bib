@article{ WOS:001455337600001,
Author = {Yaqub, Muhammad Waqas and Chen, Xizhong},
Title = {Interpretable machine learning for three-phase flow pressure drop
   prediction: A comparative study with CFD and empirical models☆},
Journal = {CHEMICAL ENGINEERING SCIENCE},
Year = {2025},
Volume = {310},
Month = {MAY 15},
Abstract = {Excessive pressure drop in chemical process industry is a common
   problem, and its accurate predictions are critical for design and
   operation of sustainable flow systems. Traditional methods, including
   Computational Fluid Dynamics (CFD) and empirical correlations, are often
   limited by computational cost or lack of generalization across flow
   patterns. This study explores the use of interpretable machine learning,
   specifically Symbolic Regression (SR), for predicting three-phase flow
   pressure drop in 90 degrees bends, commonly found in upstream oil and
   gas pipelines. It is shown that the unified mathematical model
   discovered from SR is effective for three-phase flow pressure drop
   prediction across varying flow patterns, offering significantly improved
   accuracy and universality compared to previous empirical and CFD models.
   The developed SR model captures essential parameters such as Froude
   number, liquid-to-gas viscosity, and density ratios, providing a
   computationally robust and interpretable tool for process design
   engineers to develop energy efficient flow systems.},
Type = {Article},
DOI = {10.1016/j.ces.2025.121542},
EarlyAccessDate = {MAR 2025},
