Title = {Use case of Symbolic Regression in Moire patterns using simulated data},
Booktitle = {PROCEEDINGS OF THE 13TH HELLENIC CONFERENCE ON ARTIFICIAL INTELLIGENCE,
   SETN 2024},
Year = {2024},
Abstract = {This study investigates the potential application of symbolic regression
   to elucidate the relationship between the shadow coefficient, a
   parameter quantifying material porosity, and the geometric parameters of
   Moire materials, specifically the number of overlaid meshes, edge
   length, width, and rotation angle. Utilizing symbolic regression on
   simulated data, we aim to derive an interpretable mathematical model
   that captures the underlying physics governing these relationships. We
   propose to compare the results with an analytically derived approximate
   formula to assess the efficacy of symbolic regression in this context.
   This use case demonstrates a unique opportunity to correlate between
   derived analytical formulae and simulated data, suggesting that symbolic
   regression is a powerful tool for modeling complex material properties.},
Type = {Proceedings Paper},
DOI = {10.1145/3688671.3688750},
