@incollection{ WOS:000530095200122,
Author = {Liskowski, Pawel and Krawiec, Krzysztof},
Book-Group-Author = {ACM},
Title = {Discovery of Search Objectives in Continuous Domains},
Booktitle = {PROCEEDINGS OF THE 2017 GENETIC AND EVOLUTIONARY COMPUTATION CONFERENCE
   (GECCO'17)},
Year = {2017},
Pages = {969-976},
Abstract = {In genetic programming (GP), the outcomes of the evaluation phase can be
   represented as an interaction matrix, with rows corresponding to
   programs in a population and columns corresponding to tests that define
   a program synthesis task. Recent contributions on Discovery of
   Objectives via Clustering (DOC) and Discovery of Objectives by
   Factorization of interaction matrix (DOF) show that informative
   characterizations of programs can be automatically derived from
   interaction matrices in discrete domains and used as search objectives
   in multidimensional setting. In this paper, we propose analogous methods
   for continuous domains and compare them with conventional GP that uses
   tournament selection, Age-Fitness Pareto Optimization, and GP with
   epsilon-lexicase selection. Experiments show that the proposed methods
   are effective for symbolic regression, systematically producing
   better-fitting models than the two former baselines, and surpassing
   epsilon-lexicase selection on some problems. We also investigate the
   hybrids of the proposed approach with the baselines, concluding that
   hybridization of DOC with epsilon-lexicase leads to the best overall
   results.},
Type = {Proceedings Paper},
DOI = {10.1145/3071178.3071344},
Keywords = {Genetic Programming; Machine Learning; Nonnegative Matrix Factorization;
   Multiobjective optimization},
Research-Areas = {Computer Science},
Cited-References = {{[}Anonymous], 2006, 100 STAT TESTS, DOI DOI 10.4135/9781849208499.
   {[}Anonymous], 2013, Nonparametric StatisticalMethods.
   Bob) McKay R I, 2000, P GEN EV COMP C GECC, P435.
   Bucci A, 2004, LECT NOTES COMPUT SC, V3102, P501.
   Burden R., 1989, TECHNICAL REPORT.
