@incollection{ WOS:000262623200010,
Author = {Kotanchek, Mark and Smits, Guido and Vladislavleva, Ekaterina},
Editor = {Riolo, R and Soule, T and Worzel, B},
Title = {EXPLOITING TRUSTABLE MODELS VIA PARETO GP FOR TARGETED DATA COLLECTION},
Booktitle = {GENETIC PROGRAMMING THEORY AND PRACTICE VI},
Series = {Genetic and Evolutionary Computation},
Year = {2009},
Pages = {145+},
Abstract = {Multi-objective symbolic regression has some unique capabilities in that
   it can focus on driving variables in the supplied data, produce
   white-box expressions which are human interpretable and can produce
   trust metrics on model quality via the assembly of ensembles of diverse
   but high-quality models. Exploiting these features allows adaptive data
   collection and iterative modeling. This is effectively an adaptive DOE
   (design-of-experiments) approach which is useful in a variety of
   scenarios: (1) optimization of an operating chemical plant whose
   production cannot be interrupted, (2) high-throughput empirical research
   wherein many variables of unknown significance are present, (3) emulator
   development wherein accurate surrogates for complex systems can be
   deployed for on-line optimization and human understanding and, even, (4)
   maximizing model validity for model-based decision making (e.g.,
   development of models to assist in choosing which law school candidates
   should be admitted). In each of these scenarios we desire quality
   models; however, data collection needs to be carefully targeted for
   maximum efficiency.
   The approach presented involves developing model, ensembles from a
   baseline data set. These model ensembles can be used to (a) identify
   potential optima in the system response and (b) identify regions of
   parameter space where the predictions are suspect (since in these
   regions the constituent models diverge). Collecting data in each of
   these regions helps to ensure that the target system is accurately
   modeled and the system optimum is accurately located.
   The proposed concepts are demonstrated against a variety of systems to
   illustrate the key concepts and efficacy in systems ranging from
   low-dimensional to high-dimensional.},
Type = {Proceedings Paper},
Keywords = {symbolic regression; white box; active learning; model ensembles; trust
   metrics},
Research-Areas = {Computer Science},
Cited-References = {Box G.E.P., 1986, Empirical model-building and response surface.
