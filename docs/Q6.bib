@article{ WOS:001578802300002,
Author = {Chen, Xinchen and Zhong, Jingyu and Wu, Mingjie and Yao, Baiming and Ma,
   Xianfeng and Jiang, Jishen},
Title = {Data-driven feature engineering and machine learning: Predicting the
   ductile-to-brittle transition temperature of pure chromium at the
   macroscale},
Journal = {PHYSICS LETTERS A},
Year = {2025},
Volume = {558},
Month = {OCT 28},
Abstract = {This study investigates the ductile-to-brittle transition temperature
   (DBTT) of pure chromium, focusing on how grain size and processing
   parameters affect it across macro and mesoscopic scales. A machine
   learning model was developed after dataset construction and feature
   selection. Key variables-grain size, rolling amount, annealing
   temperature, and elongation-were identified. SHAP (Shapley Additive
   Explanations) values quantified each feature's influence. Symbolic
   regression produced an interpretable formula, offering insights into
   DBTTcontrolling factors. Results show that combined control of grain
   size, rolling, and annealing significantly enhances low-temperature
   toughness. Feature heatmaps helped visualize prediction patterns. The
   CatBoost model further improved accuracy, providing guidance for tuning
   processing parameters and improving chromium performance.},
Type = {Article},
DOI = {10.1016/j.physleta.2025.130874},
