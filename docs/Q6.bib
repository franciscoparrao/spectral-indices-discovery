@incollection{ WOS:000476913800001,
Author = {Diveev, Askhat and Shmalko, Elizaveta and Sofronova, Elena},
Editor = {Nikulchev, E and Bubnov, G},
Title = {Multipoint Numerical Criterion for Manifolds to Guarantee Attractor
   Properties in the Problem of Synergetic Control Design},
Booktitle = {7TH SEMINAR ON INDUSTRIAL CONTROL SYSTEMS: ANALYSIS, MODELING AND
   COMPUTING (ICS 2018)},
Series = {ITM Web of Conferences},
Year = {2018},
Volume = {18},
Abstract = {The paper presents the results of our research on the application of
   symbolic regression methods for the numerical solution of the problem of
   synthesis of synergetic control. Synergetic control is characterized by
   the presence of manifolds in the state space that must have the
   properties of an attractor, in particular terminal manifolds, as well as
   the existence of regions of state space through which system solutions
   do not pass, for example, phase constraints, that must have the
   properties of repellers. In the present paper we formulate a numerical
   criterion for ensuring the property of an attractor for a terminal
   manifold of arbitrary dimension, taking into account the dynamic
   behavior of the system in a neighborhood of a given manifold. The
   results of computational experiments on the effective application of the
   proposed criterion are presented. It is shown that the proposed approach
   makes it possible to automate the synthesis of synergistic control using
   the methods of symbolic regression.},
Type = {Proceedings Paper},
DOI = {10.1051/itmconf/20181801001},
