@incollection{ WOS:000824464300189,
Author = {Abbasi, Muhammad Shabbir and Al-Sahaf, Harith and Welch, Ian},
Book-Group-Author = {IEEE},
Title = {Automated Behavior-based Malice Scoring of Ransomware Using Genetic
   Programming},
Booktitle = {2021 IEEE SYMPOSIUM SERIES ON COMPUTATIONAL INTELLIGENCE (IEEE SSCI
   2021)},
Year = {2021},
Abstract = {Malice or severity scoring models are a technique for detection of
   maliciousness. A few ransomware detection studies utilise malice scoring
   models for detection of ransomware-like behavior. These models rely on
   the weighted sum of some manually chosen features and their weights by a
   domain expert. To automate the modelling of malice scoring for
   ransomware detection, we propose a method based on Genetic Programming
   (GP) that automatically evolves a behavior-based malice scoring model by
   selecting appropriate features and functions from the input feature and
   operator sets. The experimental results show that the best-evolved model
   correctly assigned a malice score, below the threshold value to over
   85\% of the unseen goodware instances, and over the threshold value to
   more than 99\% of the unseen ransomware instances.},
Type = {Proceedings Paper},
DOI = {10.1109/SSCI50451.2021.9660009},
Keywords = {GP; Symbolic regression; ransomware; malice scoring},
Research-Areas = {Computer Science; Engineering; Operations Research \& Management
   Science; Mathematics},
