@article{ WOS:000693521000001,
Author = {Garbrecht, Karl and Aguilo, Miguel and Sanderson, Allen and Rollett,
   Anthony and Kirby, Robert M. and Hochhalter, Jacob},
Title = {Interpretable Machine Learning for Texture-Dependent Constitutive Models
