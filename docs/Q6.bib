@article{ WOS:001529338000001,
Author = {Yu, Hui and Zhang, Huibo and Feng, Chi},
Title = {Wind-driven rain under typhoon conditions: distribution analysis,
   semi-empirical model optimization, and predictive model development},
Journal = {BUILDING AND ENVIRONMENT},
Year = {2025},
Volume = {283},
Month = {SEP 1},
Abstract = {In recent years, global climate change has intensified extreme weather
   events, such as typhoons, exacerbating wind-driven rain (WDR) induced
   damage to building envelopes. This study establishes a comprehensive
   framework integrating computational fluid dynamics (CFD) simulations
   with symbolic regression to analyze WDR distribution characteristics on
   high-rise buildings. Focusing on a residential complex in Shanghai,
   China, we developed typhoon-specific boundary conditions based on
   historical meteorological data spanning 2014-2024. Numerical simulations
   revealed significant spatiotemporal heterogeneity in WDR catch ratios,
   with maximum values at the upper parts of the wall increasing
   exponentially with height. Under extreme typhoon conditions, WDR
   intensities reached up to 8 times normal levels, demonstrating strong
   coupling effects between wind velocity profiles and rainfall intensity
   gradients. Comparative analysis with semi-empirical models identified
   systematic deviations: ISO 15,927-3 underestimated WDR loads while
   ASHRAE 160 overestimated. We proposed height-independent correction
   factors (alpha\_ISO=2.17 (1.92 for top 3 m area), alpha\_ASHRAE=0.29
   (0.59 for top 3 m area)) that improved prediction accuracy. The
   developed symbolic regression model achieved superior performance
   (R2=0.998, RMSE=0.09) in capturing interactions of wind speed, building
   height, and rainfall intensity. These findings advance the theoretical
   understanding of WDR mechanisms under extreme climates and provide
   actionable insights for performance-based facade design,
   climate-resilient material selection, and typhoon-adaptive building
   codes formulation.},
Type = {Article},
DOI = {10.1016/j.buildenv.2025.113394},
EarlyAccessDate = {JUL 2025},
Article-Number = {113394},
Keywords = {Typhoon; Wind-driven rain catch ratio; High-rise; Semi-empirical model;
   Symbolic regression},
