@article{ WOS:001253719100001,
Author = {Bajadi, A. and El Azzab, D. and Ouchchen, M. and Mamouch, Y. and
   Achkouch, L. and Dadi, B. and El Moutaouakkil, N. and Sadeghi, B.},
Title = {Assessment of potential cobalt zones by modeling radiometric and ASTER
   data using the AHP method: A case of the Bou Azzer El Grara inlier,
   Central Anti-Atlas, Morocco},
Journal = {GEOCHEMISTRY},
Year = {2024},
Volume = {84},
Number = {2},
Month = {MAY},
Abstract = {The Bou Azzer El Grara inlier belongs to the Central Anti -Atlas range,
   renowned for its mineral deposits. The study carried out on the inlier
   aims to identify potential areas of cobalt mineralization based on a
   multi -source methodology of radiometric and remote sensing data
   processing. The data used includes hydrothermal alteration minerals
   (argillic, phyllic, propylitic, iron oxides) mapped with Advanced
   Spaceborne Thermal Emission and Reflection Radiometer (ASTER) imagery
   using band ratio and principal component analysis (PCA) techniques,
   potassium enrichment zones through K/eTh and K/eU ratios calculated from
   radiometric data, as well as geological data (serpentinite outcrops and
   geological faults). The analytic hierarchy process (AHP) was used to
   combine the various thematic layers. Validation was carried out through
   the field studies in several anomalous zones. The mineral prospectivity
   map generated highlights nine major zones that appear the most favorable
   for mineralization, some of which coincide with zones in production and
   others requiring further exploration.},
Type = {Article},
DOI = {10.1016/j.chemer.2024.126105},
EarlyAccessDate = {JUN 2024},
