@article{ WOS:000719753300002,
Author = {Badr, Yasser Salah},
Title = {Integrated spectral analysis of ASTER and gamma-ray spectrometric data
   to delineate alteration minerals for uranium exploration in Gabal Khashm
   El-Risha area, North Eastern Desert, Egypt},
Journal = {REMOTE SENSING APPLICATIONS-SOCIETY AND ENVIRONMENT},
Year = {2021},
Volume = {24},
Month = {NOV},
Abstract = {The main topic of this study is to integrate the spectral analyses of
   ASTER (VNIR-SWIR) with gamma-ray spectrometric data for mapping the
   alteration zones that affect in the distribution of the radioactive
   elements in Gabal Khashm El-Risha area, North Eastern Desert, Egypt. The
   spectral transformation techniques such as band ratios and minimum noise
   fraction in addition to mixture tuned matched filtering applicable to
   ASTER data are used to identify these altered zones. The applied
   techniques revealed approximately rapprochement between specific
   alteration minerals (i.e. hematite, goethite, muscovite, epidote,
   kaolinite and alunite) and the high potentiality of radioelements. The
   present work utilizes gamma ray spectrometric data (colored
   radioelements, contour maps, ratio maps and F-parameter) and correlated
   with the interpreted ASTER maps to allocate the possible zones of
   uranium mineralization. The associated abnormal level of radioactivity
   exhibits 10.5 and 24.2 ppm for eU and eTh respectively and mainly
   restricted to the syenogranites, which significantly have higher
   hematite content rather than the other exposures. Field-work and
   laboratory analysis validated the results obtained from ASTER data
   combined with gamma-ray spectrometric data.},
Type = {Article},
DOI = {10.1016/j.rsase.2021.100632},
EarlyAccessDate = {OCT 2021},
