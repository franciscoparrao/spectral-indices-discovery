@article{ WOS:001053916200001,
Author = {Zhou, Yarong and Zheng, Shuo and An, Yanfei and Lai, Chunkit},
Title = {ASTER VNIR-SWIR Based Lithological Mapping of Granitoids in the Western
   Junggar Orogen (NW Xinjiang): Improved Inputs to Random Forest Method},
Journal = {EARTH AND SPACE SCIENCE},
Year = {2023},
Volume = {10},
Number = {8},
Month = {AUG},
Abstract = {Although advanced spaceborne thermal emission and reflection radiometer
   multispectral analysis for lithological mapping has been widely applied,
   traditional methods such as band ratios (BR) and principal component
   analysis (PCA) are still hampered by cumbersome data processing and poor
   classification performance. In this study, we utilize improved data
   inputs for random forest (RF) to extract lithological information of
   granitoids, which are the predominant rock type for intrusion-related
   polymetallic ore deposits in the western Junggar Orogen (NW Xinjiang).
   Based on spectral absorption features of minerals (e.g., orthoclase,
   K-feldspar, hornblende, biotite, plagioclase, and oligoclase), image
   statistical information and textural features, we tested different
   combinations of bands, BR, PCA, and texture using RF method, and found
   that the combination of B13678 + T1 (Mean texture) achieved the highest
   weighted-F1 score for granitoids, with an accuracy of 87.32\%. Compared
   to the support vector machine, RF effectively distinguishes lithological
   differences between different types of granitoid and wallrocks,
   especially the granite, granodiorite, and alkali granite in the
   Akebasito intrusion, as well as the alkali granite, plagiogranite and
   biotite granite in the Karamay intrusions. Moreover, the large number of
   rare metal deposits (including Cu, Au, Mo, etc.) distributed near the
   granitoid intrusions in the western Junggar, our result facilitates the
   analysis of regional tectonic evolution and mineralization controlling.},
Type = {Article},
DOI = {10.1029/2023EA002877},
Article-Number = {e2023EA002877},
Keywords = {lithological mapping; band combination; mean texture; random forest;
   granitoids},
Keywords-Plus = {PORPHYRY CU DEPOSIT; ORE-FORMING FLUID; ACCRETIONARY OROGENESIS;
   ALTERATION MINERALS; TECTONIC EVOLUTION; METALLOGENIC BELT; MO DEPOSIT;
   CHINA; AREA; GEOCHRONOLOGY},
