@incollection{ WOS:001669853200101,
Author = {Ankut, Zeynep and Duzgun, Sebnem},
Editor = {Anderson, E and Graham, G},
Title = {Integrated Remote Sensing and Machine Learning for Copper Exploration in
   Copper Triangle, Arizona},
Booktitle = {18TH SGA BIENNIAL MEETING, 2025, VOL 3},
Year = {2025},
Pages = {1204-1207},
Abstract = {This study explores the application of remote sensing technologies
   combined with machine learning to enhance the detection and
   characterization of porphyry copper deposits in the Copper Triangle,
   Arizona. The research uses data from ASTER sensors to identify surface
   alterations indicative of copper mineralization. The study employs
   several target detection algorithms, including Spectral Angle Mapper
   (SAM), Adaptive Coherence Estimator (ACE), Matched Filtering (MF), and
   Constrained Energy Minimization (CEM), to map alteration minerals. These
   techniques are integrated with machine learning algorithms to improve
   the accuracy of identifying key alteration minerals typically associated
   with porphyry copper systems, such as hydromica (montmorillonite and
   illite), propylitic, phyllic, and advanced argillic alterations. The
   findings demonstrate the efficacy of the presented approach in mapping
   hydrothermal alterations and contributing to more efficient and targeted
   exploration strategies. The effectiveness of this approach is shown
   through the accurate delineation of alteration zones crucial for
   pinpointing potential mining sites. The outcome underscores the
   potential of these technologies to revolutionize how natural resources
   are explored, providing a complementary approach to traditional mineral
   exploration techniques. This study enhances the understanding of
   porphyry copper systems and showcases the significant role of innovative
   technological integrations in economic geology.},
Type = {Proceedings Paper},
Keywords-Plus = {DEPOSITS},
Research-Areas = {Geochemistry \& Geophysics; Geology; Mineralogy},
