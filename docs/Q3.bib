@incollection{ WOS:000426954606053,
Author = {Mezned, Nouha and Bouzidi, Wejdane and Dkhala, Belgacem and Abdeljaouad,
   Saadi},
Book-Group-Author = {IEEE},
Title = {CASCADE SUB-PIXEL UNMIXING OF ASTER SWIR DATA FOR MAPPING ALTERATION
   MINERALS IN TAMRA SIDI-DRISS SITE, NW TUNISIA},
Booktitle = {2017 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING SYMPOSIUM (IGARSS)},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2017},
Pages = {6267-6270},
Abstract = {Remote sensing is widely used for alteration mineral recognition and
   mapping. Since it covers spectral features of hydroxyl-bearing minerals
   as well as C-O bearing minerals like phylosilicates, sulfates, and
   carbonates, ASTER SWIR region allows detailed spectral characterization
   of alteration minerals. This study focuses on investigating the ability
   of ASTER SWIR data for mapping alteration minerals in western Nefza
   farmer in the northwest of Tunisia, an area with hight vegetation. Our
   contribution consists on a cascade classification based on partial
   sub-pixel mapping of alteration minerals. The classification method was
   implemented using the mixture tuned matched filtering (MTMF) method, on
   two steps away, with respect to ASD data field truth and XRD laboratory
   analyses.},
Type = {Proceedings Paper},
Keywords = {ASTER SWIR; MTMF method; ASD data; XRD analysis},
Keywords-Plus = {DEPOSITS},
Research-Areas = {Geology; Remote Sensing},
