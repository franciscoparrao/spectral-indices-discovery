@article{ WOS:000850974300001,
Author = {Kakavand, Mahnaz and Bonyadi, Zahra},
Title = {Evaluation of alteration zones around Parmagasu copper indication, Kuh
   Zar, Damghan, Iran, using ASTER satellite data},
Journal = {GEOCARTO INTERNATIONAL},
Year = {2022},
Volume = {37},
Number = {27},
Pages = {16827-16845},
Month = {DEC 13},
Abstract = {Parmagasu copper indication is located 100 km southeast of Damghan city,
   Iran. Copper, gold, Pb, and Fe mineralizations have occurred in the
   region, in the Eocene trachyandesite-andesite porphyry host rocks. This
   study attempts to identify alteration zones and their expansions to
   comprehend the origin of mineralizations and their distribution pattern
   in the area. The phyllic alteration zone is surrounded by more extensive
   propylitic alteration. The argillic zone is less widespread than the
   other alteration zones and overlaps with the phyllic zone. The Band
   Ratio, Principal Component Analysis, Independent Component Analysis, and
   Spectral Angle Mapper remarkably identified the alteration zones among
   the employed methodologies. The validity of the results was proved by
   field observations, microscopic investigations, and the computed overall
   accuracy for the outcomes of supervised classification. This
   investigation confirms the importance of faults in the occurrence of
   alteration in the Kuh Zar area.},
