@incollection{ WOS:000365173400001,
Author = {Ananyev, Yu S. and Maskov, A. A. and Abramova, R. N.},
Book-Group-Author = {IOP},
Title = {Hydrothermal alteration mapping of Siberian gold-ore fields based on
   satellite spectroscopy data},
Booktitle = {XIX INTERNATIONAL SCIENTIFIC SYMPOSIUM IN HONOR OF ACADEMICIAN M.A. USOV
   PROBLEMS OF GEOLOGY AND SUBSURFACE DEVELOPMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2015},
Volume = {27},
Abstract = {The mapping of the hydrothermal alterations in Urjahskoe and
   Fedorov-Kedrov gold-ore fields was conducted by applying channel
   relationship method (band ratio) based on ASTER spectral-zonal satellite
   image data. It was determined that the calculated mineral indices in
   ore-bearing structures are zonal. Outer ore-bearing structures revealed
   increased ferric mineral index values, while inner - high
   epidote-chlorite-calcite and muscovite-siderite mineral index values.
   Detected regularities could be used in identifying potential gold-ore
   bearing areas within identical fields based on remote sensing survey
   data.},
