@incollection{ WOS:000281054100154,
Author = {Chen, Yu and Lin, Qizhong and Guo, Huadong and Wei, Yongmin and Wang,
   Qinjun},
Book-Group-Author = {IEEE},
Title = {A SUITALBE SOLUTION FOR EXTRACTION OF ALTERATION ANOMALIES FROM THE
   REMOTE SENSING DATA: A CASE STUDY OF THE BAOGUTU PORPHYRY COPPER DEPOSIT
