Pages = {1212-1215},
Abstract = {The Cerro de Pasco area in central Peru comprises several metallogenic
   provinces containing a variety of deposit types, including Miocene and
   Oligocene polymetallic vein systems, Eocene stratabound polymetallic
   mineralization, Permian porphyry-style deposits, and orogenic gold
   associated with Ordovician metasedimentary units. The region's rugged
   topography and sparse vegetation make it well-suited for the application
   of remote sensing methodologies. This study focuses on identifying
   hydrothermal alteration zones through the analysis of ASTER satellite
   data and spectral signatures obtained from outcrop samples using an ASD
   TerraSpec. Four spectral techniques were applied: 1) RGB band
   combinations to map clay minerals, 2) band ratios to identify alteration
   assemblages, 3) SWIR spectral indices to corroborate mineralogical
   variations, and 4) Spectral Angle Mapper (SAM) analysis to integrate
   field ASD TerraSpec spectra with ASTER data. SAM confirmed and refined
   hydrothermal alteration halos, delineating eleven new exploration
   targets that include: seven highsulfidation systems that exhibit
   advanced and intermediate argillic alteration, three porphyry-related
   systems with phyllic, intermediate argillic, advanced argillic, and
   propylitic alteration, and one stratabound polymetallic system
   characterized by phyllic, propylitic alteration and carbonates. These
   results highlight the integration of remote sensing and field
   spectroscopy as a valuable exploration tool in structurally complex
   metallogenic settings.},
Type = {Proceedings Paper},
Research-Areas = {Geochemistry \& Geophysics; Geology; Mineralogy},
Cited-References = {Azcurra D, 2003, PROVINCIA RIOJA REPU, P815.
