@article{ WOS:000977743400001,
Author = {Amitrano, Donato and Cicala, Luca and De Mizio, Marco and Tufano,
   Francesco},
Title = {UAV Hyperspectral Characterization of Vegetation Using Entropy-Based
   Active Sampling for Partial Least Square Regression Models},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2023},
Volume = {13},
Number = {8},
Month = {APR},
Abstract = {Optimization of agricultural practices is key for facing the challenges
   of modern agri-food systems, which are expected to satisfy a growing
   demand of food production in a landscape characterized by a reduction in
   cultivable lands and an increasing awareness of sustainability issues.
   In this work, an operational methodology for characterization of
   vegetation biomass and nitrogen content based on close-range
   hyperspectral remote sensing is introduced. It is based on an
   unsupervised active learning technique suitable for the calibration of a
   partial least square regression. The proposed technique relies on an
   innovative usage of Shannon's entropy and allows for the set-up of an
   incremental monitoring framework from scratch aiming at minimizing field
   sampling activities. Experimental results concerning the estimation of
   grassland biomass and nitrogen content returned RMSE values of 2.05 t/ha
   and 4.68 kg/ha, respectively. They are comparable with the literature,
   mostly relying on supervised frameworks and confirmed the suitability of
   the proposed methodology with operational environments.},
Type = {Article},
DOI = {10.3390/app13084812},
Article-Number = {4812},
Keywords = {UAV; precision agriculture; hyperspectral imagery; active sampling;
   vegetation biomass; vegetation nitrogen content; partial least squares
   regression},
Keywords-Plus = {CHLOROPHYLL CONCENTRATION; VARIABLE IMPORTANCE; SPECTRAL INDEXES; RED
   EDGE; REFLECTANCE; NITROGEN; ALGORITHMS; GRASSLANDS; BIOMASS; CHAIN},
Research-Areas = {Chemistry; Engineering; Materials Science; Physics},
Cited-References = {Adao T, 2017, REMOTE SENS-BASEL, V9, DOI 10.3390/rs9111110.
   Afanador NL, 2014, CHEMOMETR INTELL LAB, V137, P162, DOI 10.1016/j.chemolab.2014.05.016.
