@article{ WOS:000987810800001,
Author = {Ma, Yingxuan and Tashpolat, Nigara},
Title = {Remote Sensing Monitoring of Soil Salinity in Weigan River-Kuqa River
   Delta Oasis Based on Two-Dimensional Feature Space},
Journal = {WATER},
Year = {2023},
