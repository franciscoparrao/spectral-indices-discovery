@article{ WOS:001523096500002,
Author = {Patle, Sheewani and Ghuge, Vidya V.},
Title = {Examining how land cover variability and urban fragmentation influence
   land surface temperature and thermal comfort for semi-arid cities},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2025},
Volume = {130},
Month = {JUL 15},
Abstract = {Urbanization leads to Land Use and Land Cover (LULC) shifts affecting
   land surface temperature (LST) and influences local to global climates,
   posing challenges to quality of life and thermal comfort, especially in
   developing countries. By adopting an Urban Fragmentation method, this
   research examines how changes in LULC influence LST, aiming to improve
   thermal comfort. A multi-city analysis approach was used with seasonal
   consideration in India's five semi-arid Koppen climate cities (Jaipur,
   Aurangabad, Jodhpur, Kota, and Solapur). Using Landsat 7 and 8
   imageries, Spectral indices, LST, Discomfort Index (DI), built-up area
   Fragmentation Index (FI), surface albedo, and shadow index are extracted
   using ArcGIS 10.6 software. Findings highlight that LST is modulated by
   land cover characteristics, where barren lands on the selected cities
   outskirts have high LST, in contrast to the cooling influence of
   vegetation and waterbodies. Areas with high SAVI (> 0.8) and MNDWI (>
   0.60) have shown the lowest LSTs. Built-up area in the urban core with
   an optimal FI (5.5 to 30) was found to have significant cooling benefits
   in the selected cities. Thermal discomfort was highest in summer,
   especially in highly fragmented urban zones (FI > 30), notably in
   Jaipur, Jodhpur, and Solapur. Changes in surface albedo reflect
   alterations in the landscape that intensify seasonal shifts in surface
   reflectivity. The regression models exhibit significant seasonal
   variability, as reflected by R-2 values ranging from 0.39 to 0.79. This
   research will provide insights into the influence of land cover
   characteristics on LST and thermal comfort patterns in warm and cold
   periods in hot semi-arid climates influenced by seasonal and
   geographical conditions.},
Type = {Article},
DOI = {10.1016/j.scs.2025.106540},
EarlyAccessDate = {JUN 2025},
Article-Number = {106540},
Keywords = {Land cover; Koppen climate; Land surface temperature; Spectral indices;
   Remote sensing},
Keywords-Plus = {HEAT-ISLAND; ACCURACY ASSESSMENT; LANDSCAPE STRUCTURE; WATER BODIES; USE
   DYNAMICS; JAIPUR CITY; VEGETATION; CLIMATE; IMPACT; INDEX},
