@incollection{ WOS:000342772000027,
Author = {Hunt, Jr., E. Raymond and Daughtry, Craig S. T. and Mirsky, Steven B.
   and Hively, W. Dean},
Book-Group-Author = {IEEE},
Title = {Remote Sensing with Unmanned Aircraft Systems for Precision Agriculture
   Applications},
