@article{ WOS:000515210700011,
Author = {Shi, Lamei and Zhang, Jiahua and Zhang, Da and Igbawua, Tertsea and Liu,
   Yuqin},
Title = {Developing a dust storm detection method combining Support Vector
   Machine and satellite data in typical dust regions of Asia},
Journal = {ADVANCES IN SPACE RESEARCH},
Year = {2020},
Volume = {65},
Number = {4},
Pages = {1263-1278},
Month = {FEB 15},
Abstract = {Enhancing the dust storm detection is a key part for the environmental
   protection, human healthy and economic development. The goal of this
   paper is to propose a new Support Vector Machine (SVM)-based method to
   automatically detect dust storms using remote sensing data. Existing
   methods dealing with this problem are usually threshold-based that are
   of great complexity and uncertainty. In this paper we propose a simple
   and reliable method combining SVM with MODIS L1 data and explore the
   optimal band combinations used as the feature vectors of SVM. The
   developed method was evaluated by MODIS and OMI data qualitatively and
   quantitatively on three study sites located in the Arabian Desert, Gobi
   Desert and Taklimakan Desert, and it was also compared to three other
   traditional methods based on their accuracy, complexity, reliability and
