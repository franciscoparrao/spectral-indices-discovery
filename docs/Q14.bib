@article{ WOS:000605393400001,
Author = {Skakni, Omar and Hlila, Rachid and Pour, Amin Beiranvand and Martin
   Martin, Manuel and Maate, Ali and Maate, Soufian and Muslim, Aidy M. and
   Hossain, Mohammad Shawkat},
Title = {Integrating remote sensing, GIS and in-situ data for structural
