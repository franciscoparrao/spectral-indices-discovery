@article{ WOS:001246259200035,
Author = {Wu Yan-hua and Zhao Heng-qian and Mao Ji-hua and Jin Qian and Wang
   Xue-fei and Li Mei-yu},
Title = {Study on Hyperspectral Inversion Model of Soil Heavy Metals in Typical
   Lead-Zinc Mining Areas},
Journal = {SPECTROSCOPY AND SPECTRAL ANALYSIS},
