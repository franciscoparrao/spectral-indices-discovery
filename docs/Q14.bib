@article{ WOS:001472246200001,
Author = {Liu, Hao and Chen, Junying and Bian, Jiang and Li, Zilong and Zhang,
   Wenjing and Yang, Ning and Du, Ruiqi and Qian, Long and Geng, Hongsuo
   and Chen, Yinwen and Zhang, Zhitao and Shi, Liangsheng},
Title = {Enhancing field-scale soil moisture content monitoring using UAV
   hyperspectral-derived multi-dimensional spectral response indices of
   crop comprehensive phenotypic traits},
Journal = {COMPUTERS AND ELECTRONICS IN AGRICULTURE},
Year = {2025},
Volume = {235},
Month = {AUG},
Abstract = {Accurate and timely estimation of soil moisture content (SMC) at the
   field scale is crucial for optimizing irrigation decisions. Although
   remote sensing has emerged as an effective method for monitoring SMC in
   farmland through crop phenotype observation, existing studies have not
   fully exploited the potential of phenotypic trait parameters (PTPs) in
   this context. To enhance the accuracy and reliability of SMC monitoring
   models, it is essential to systematically integrate PTPs and analyze
   their spectral response features. This study aims to improve maize SMC
   monitoring models by utilizing multi-dimensional spectral response
   features derived from crop PTPs. First, a comprehensive phenotypic trait
   index (CPTI) was developed using the fuzzy comprehensive evaluation
   (FCE) method. This index incorporates key PTPs, including the leaf area
   index (LAI), aboveground biomass (AGB), leaf chlorophyll content (LCC),
   and leaf water content (LWC). The weights of individual PTPs within the
   CPTI were adjusted based on their sensitivity to water stress, to
   establish a water-stress-specific comprehensive phenotypic trait index
   (CPTIws). Afterwards, fractional-order differentiation (FOD) and optimal
   band combination (OBC) were used to extract multi-dimensional spectral
   response features of each PTP. These features were then evaluated for
   their effectiveness in monitoring SMC using various machine learning
   models. The results show that: (1) CPTIws effectively integrates the
   spectral responses of PTPs, achieving an absolute Pearson correlation
   coefficient (|PCCs|) of 0.77 with SMC, higher than that of individual
   PTPs (|PCCs| = 0.42-0.60) and CPTI (|PCCs| = 0.72). (2) The combination
   of FOD and OBC enhances the spectral response of each PTP, increasing
   the |PCC| by an average of 0.30; (3) The highest SMC monitoring accuracy
   was achieved by inputting the multi-dimensional spectral response
   features of CPTIws in a stacked ensemble learning model (R2 = 0.84,RMSE
   = 0.014), outperforming the best individual PTP, AGB (R2 = 0.76, RMSE =
   0.021 cm center dot cm-3). In summary, multi-dimensional spectral
   response features derived from CPTIws, using UAV-based hyperspectral
   imagery, significantly improve the accuracy of field-scale SMC
   monitoring for maize. This study provides a solid scientific basis for
   accurately obtaining farmland SMC.},
Type = {Article},
DOI = {10.1016/j.compag.2025.110399},
EarlyAccessDate = {APR 2025},
Article-Number = {110399},
Keywords = {UAV hyperspectral imaging; Crop phenotyping; Soil moisture content
   (SMC); Fuzzy comprehensive evaluation (FCE); Multi-dimensional spectral
   response indices},
Keywords-Plus = {WATER},
