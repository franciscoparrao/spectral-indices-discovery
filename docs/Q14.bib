@article{ WOS:000402355700005,
Author = {Wei, Chuanwen and Huang, Jingfeng and Wang, Xiuzhen and Blackburn,
   George Alan and Zhang, Yao and Wang, Shusen and Mansaray, Lamin R.},
Title = {Hyperspectral characterization of freezing injury and its biochemical
   impacts in oilseed rape leaves},
Journal = {REMOTE SENSING OF ENVIRONMENT},
Year = {2017},
Volume = {195},
Pages = {56-66},
Month = {JUN 15},
Abstract = {Automatic detection and monitoring of freezing injury in crops is of
   vital importance for assessing plant physiological status and yield
   losses. This study investigates the potential of hyperspectral
   techniques for detecting leaves at the stages of freezing and
   post-thawing injury, and for quantifying the impacts of freezing injury
   on leaf water and pigment contents. Four experiments were carried out to
   acquire hyperspectral reflectance and biochemical parameters for oilseed
   rape plants subjected to freezing treatment. Principal component
   analysis and support vector machines were applied to raw reflectance,
   first and second derivatives (SDR), and inverse logarithmic reflectance
   to differentiate freezing and the different stages of post-thawing from
   the normal leaf state. The impacts on biochemical retrieval using
   particular spectral domains were also assessed using a multivariate
   analysis. Results showed that SDR generated the highest classification
   accuracy (>95.6\%) in the detection of post-thawed leaves. The optimal
   ratio vegetation index (RVI) generated the highest predictive accuracy
   for changes in leaf water content, with a cross validated coefficient of
   determination (R-2) of 0.85 and a cross validated root mean square error
   (RMSECV) of 2.4161 mg/cm(2). Derivative spectral indices outperformed
   multivariate statistical methods for the estimation of changes in
   pigment contents. The highest accuracy was found between the optimal RVI
   and the change in carotenoids content (R-cv(2) = 0.70 and RMSECV =
   0.0015 mg/cm(2)). The spectral domain 400-900 nm outperformed the full
   spectrum in the estimation of individual pigment contents, and hence
   this domain can be used to reduce redundancy and increase computational
   efficiency in future operational scenarios. Our findings indicate that
   hyperspectral remote sensing has considerable potential for
   characterizing freezing injury in oilseed rape, and this could form a
   basis for developing satellite remote sensing products for crop
   monitoring. (C) 2017 Elsevier Inc. All rights reserved.},
Type = {Article},
DOI = {10.1016/j.rse.2017.03.042},
Keywords = {Hyperspectral reflectance; Oilseed rape; Freezing injury; Detection;
   Estimation; Biochemical parameters},
Keywords-Plus = {SUPPORT VECTOR MACHINES; LEAF PIGMENT CONTENT; REMOTE-SENSING DATA;
