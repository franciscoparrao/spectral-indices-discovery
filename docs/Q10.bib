@article{ WOS:000903510100001,
Author = {Alarifi, Saad S. S. and Abdelkareem, Mohamed and Abdalla, Fathy and
   Abdelsadek, Ismail S. S. and Gahlan, Hisham and Al-Saleh, Ahmad. M. and
   Alotaibi, Mislat},
Title = {Fusion of Multispectral Remote-Sensing Data through GIS-Based Overlay
   Method for Revealing Potential Areas of Hydrothermal Mineral Resources},
Journal = {MINERALS},
Year = {2022},
Volume = {12},
Number = {12},
Month = {DEC},
Abstract = {Revealing prospective locations of hydrothermal alteration zones (HAZs)
   is an important technique for mineral prospecting. In this study, we
   used multiple criteria inferred from Landsat-8 OLI, Sentinel-2, and
   ASTER data using a GIS-based weighted overlay multi-criteria decision
   analysis approach to build a model for the delineating of hydrothermal
   mineral deposits in the Khnaiguiyah district, Saudi Arabia. The utilized
   algorithms revealed argillic, phyllic, and propylitic alteration
   characteristics. The HAZs map resulted in the identification of six
   zones based on their mineralization potential, providing a basis for
   potential hydrothermal mineral deposit assessment exploration, which was
   created by the fusion of mineral bands indicators designated very low,
   low, moderate, good, very good, and excellent and covers 31.36, 28.22,
   20.49, 10.99, 6.35, and 2.59\%. Based on their potential for
   hydrothermal mineral potentiality, the discovered zones match gossans
   related to sulfide mineral alteration zones, as demonstrated by previous
   studies.},
Type = {Article},
DOI = {10.3390/min12121577},
Article-Number = {1577},
Keywords = {mineral exploration; ASTER; OLI; Sentinel-2; GIS; Khnaiguiyah; Saudi
   Arabia},
