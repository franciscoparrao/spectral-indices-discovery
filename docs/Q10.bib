@article{ WOS:000785963000001,
Author = {Anifadi, A. and Sykioti, O. and Koutroumbas, K. and Vassilakis, E.},
Title = {A Novel Spectral Index for Identifying Ferronickel (Fe-Ni) Laterites
   from Sentinel 2 Satellite Data},
Journal = {NATURAL RESOURCES RESEARCH},
Year = {2022},
Volume = {31},
Number = {3},
Pages = {1203-1224},
Month = {JUN},
Abstract = {Field geological mapping is the initial step of preliminary research in
   mining. However, in the last decades, the rapid progress of remote
   sensing data processing and its use for reconnaissance of geological
   outcrops for the purpose of locating possible mining sites gained
   increasing attention due to the significant time and cost savings. In
   this study, a new methodology, focused on mapping ferronickel (Fe-Ni)
   laterite deposits by using Sentinel-2 satellite data, is introduced. It
   describes a novel spectral index (called laterite spectral index (LSI))
   that enhances laterite surface outcrops. To the best of our knowledge,
   LSI is the first spectral index tailored for this task, concerning
   minerals that are simultaneously rich in Fe and Ni. The LSI was applied
   on a continuum removed image by taking advantage of the spectral
   features present in two specific spectral areas of 490-560 nm and
   842-945 nm. The entire methodology was tested and validated on four
   different excavation sites in eastern Central Greece based on known
   drillholes. In all excavation sites, the proposed LSI compared favorably
   with other relative spectral indices proposed in the literature for the
   detection of Fe-bearing minerals or Fe-oxides.},
Type = {Article},
DOI = {10.1007/s11053-022-10055-6},
EarlyAccessDate = {APR 2022},
Keywords = {Fe-Ni laterite; Spectral index; Spectral signature; Sentinel 2; Remote
   sensing},
