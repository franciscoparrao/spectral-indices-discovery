@incollection{ WOS:000387962100066,
Author = {Kriegman, Sam and Szubert, Marcin and Bongard, Josh C. and Skalka,
   Christian},
Editor = {Handl, J and Hart, E and Lewis, PR and LopezIbanez, M and Ochoa, G and Paechter, B},
Title = {Evolving Spatially Aggregated Features from Satellite Imagery for
   Regional Modeling},
Booktitle = {PARALLEL PROBLEM SOLVING FROM NATURE - PPSN XIV},
Series = {Lecture Notes in Computer Science},
Year = {2016},
Volume = {9921},
Pages = {707-716},
Abstract = {Satellite imagery and remote sensing provide explanatory variables at
   relatively high resolutions for modeling geospatial phenomena, yet
   regional summaries are often desirable for analysis and actionable
   insight. In this paper, we propose a novel method of inducing spatial
   aggregations as a component of the machine learning process, yielding
   regional model features whose construction is driven by model prediction
   performance rather than prior assumptions. Our results demonstrate that
   Genetic Programming is particularly well suited to this type of feature
   construction because it can automatically synthesize appropriate
   aggregations, as well as better incorporate them into predictive models
   compared to other regression methods we tested. In our experiments we
   consider a specific problem instance and real-world dataset relevant to
   predicting snow properties in high-mountain Asia.},
Type = {Proceedings Paper},
