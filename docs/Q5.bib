@incollection{ WOS:001669941600034,
Author = {Chen, Pei-Yao and Wang, Chen and Ding, Ran and Fan, Jian-Sheng},
Editor = {Akinci, B and Berges, M and Jazizadeh, F and Menassa, CC and Yeoh, J},
Title = {AI-Based Formula Discovery for Civil Engineering},
Booktitle = {COMPUTING IN CIVIL ENGINEERING 2024: ARTIFICIAL INTELLIGENCE, AUTOMATION
   AND ROBOTICS, AND HUMAN-CENTERED INNOVATIONS},
Year = {2024},
Pages = {324-332},
Abstract = {AI-based computation in civil engineering exhibits high accuracy and
   efficiency. However, due to its black-box nature, the results are
   difficult to comprehend, impeding its application in safety-oriented
   engineering projects. This study introduces an intelligent formula
   discovery method based on dimensional analysis and engineering prior
   knowledge. Through intelligent computational techniques, it identifies
   key features influencing material and component performance from
   experimental data, generating design equations that are dimensionally
   balanced, physically meaningful, and mechanically interpretable. A
   formula intelligent generation model, considering dimensional
   constraints, is introduced to ensure mechanical rationality.
   Normalization methods for scenarios with multiple mechanical variables,
   as well as engineering feature segmentation algorithms based on spectral
   clustering and decision trees, are developed to enhance model stability
   and accuracy. The method's effectiveness is validated with reinforced
   cement-based materials' shear bearing capacity. Results demonstrate a
   5.9\% accuracy improvement compared to traditional symbolic regression
   methods. The intelligently generated formulas exhibit a 4.7\% increase
   in fitting correlation (R-2 = 0.90), showcasing excellent performance.
   Moreover, they possess dimensional correctness and strong engineering
   generalization capability compared to traditional symbolic regression
   methods. They contribute to revealing mechanisms and accelerating the
   translation process from experimental research to design methods for new
   materials and structures, displaying significant research and
   application value.},
Type = {Proceedings Paper},
Keywords = {Design formulas; Artificial intelligence; Symbolic regression;
   Mechanical interpretability; Civil engineering},
Research-Areas = {Automation \& Control Systems; Computer Science; Construction \&
   Building Technology; Engineering},
Cited-References = {Hu XW, 2023, J BUILD ENG, V73, DOI 10.1016/j.jobe.2023.106666.
