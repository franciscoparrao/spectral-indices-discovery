@article{ WOS:001717240100001,
Author = {Yan, Tong and Yin, Huamei and Wang, Lu and Ao, Xiaolong and Zhang,
   Jinxiao},
Title = {An interpretable machine learning framework for predicting
   small-molecule adsorption on Ni@g-C3N4 from vibrational spectra},
Journal = {SURFACES AND INTERFACES},
Year = {2026},
Volume = {87},
Month = {APR 15},
Abstract = {The study of molecules adsorbed on surfaces is crucial for understanding
   diverse chemical processes. Spectroscopy offers an efficient and
   non-destructive approach to probe the structural and energetic
   characteristics of surface adsorption states. However, conventional
   methods usually derive structural information from spectra and
   subsequently estimate adsorption properties through theoretical
   simulations or experimental correlations, which may lead to error
   propagation, information loss, and high computational or experimental
   cost. In this work, we develop a machine learning framework that
   establishes direct quantitative relationships between vibrational
   spectra and adsorption properties as well as structural parameters of
   small molecules on Ni@g-C3N4, a representative catalyst for the carbon
   dioxide reduction reaction (CO2RR). Extra Trees Regression (ETR)
   achieved the highest predictive accuracy, maintaining strong agreement
   with density functional theory (DFT) results across all target
   properties, and further exhibited good transferability to related
   systems. Moreover, symbolic regression provides interpretability and
   mechanistic insight into surface-adsorbate interactions. This study
   offers a quantitative, interpretable, and transferable framework for
   correlating vibrational spectra with catalytic properties, specifically
   establishing a direct spectral-property mapping for surface adsorption
   states that overcomes the limitations of conventional indirect analyses,
   thereby providing a novel strategy for the real-time characterization
   and rational design of interfacial processes in heterogeneous catalysis.},
Type = {Article},
DOI = {10.1016/j.surfin.2026.108936},
Article-Number = {108936},
Keywords = {Surface adsorption; Machine learning; Spectra-property relationships; CO
   2 reduction reaction (CO 2 RR); Heterogeneous catalysis},
