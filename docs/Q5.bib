@article{ WOS:001564134100005,
Author = {Sierra-Velez, Julian and Vial, Alexandre and Macias, Demetrio and
   Inchaussandague, Marina and Skigin, Diana},
Title = {Modeling the optical properties of biological structures using symbolic
   regression},
Journal = {PHYSICAL REVIEW E},
Year = {2025},
Volume = {112},
Number = {3},
Month = {SEP 3},
Abstract = {We present a machine learning approach based on symbolic regression to
   derive, from either numerically generated or experimentally measured
   spectral data, closed-form expressions that model the optical properties
   of biological materials. To evaluate the performance of our approach, we
   consider three case studies with the aim of retrieving the refractive
   index of the materials that constitute the biological structures
   considered. The results obtained show that, in addition to retrieving
   readable and dimensionally homogeneous dispersion models, the
   expressions found have a physical meaning and their algebraic form is
   similar to that of the models often used to characterize the dispersive
   behavior of transparent dielectrics in the visible region.},
Type = {Article},
DOI = {10.1103/w8jn-qs2z},
