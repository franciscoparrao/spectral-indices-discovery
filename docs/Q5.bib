@article{ WOS:000749206200002,
Author = {Xie, S. R. and Quan, Y. and Hire, A. C. and Deng, B. and DeStefano, J.
   M. and Salinas, I and Shah, U. S. and Fanfarillo, L. and Lim, J. and
   Kim, J. and Stewart, G. R. and Hamlin, J. J. and Hirschfeld, P. J. and
   Hennig, R. G.},
Title = {Machine learning of superconducting critical temperature from Eliashberg
   theory},
Journal = {NPJ COMPUTATIONAL MATERIALS},
Year = {2022},
Volume = {8},
Number = {1},
Month = {JAN 25},
Abstract = {The Eliashberg theory of superconductivity accounts for the fundamental
   physics of conventional superconductors, including the retardation of
   the interaction and the Coulomb pseudopotential, to predict the critical
   temperature T-c. McMillan, Allen, and Dynes derived approximate
   closed-form expressions for the critical temperature within this theory,
   which depends on the electron-phonon spectral function alpha F-2(omega).
   Here we show that modern machine-learning techniques can substantially
   improve these formulae, accounting for more general shapes of the alpha
   F-2 function. Using symbolic regression and the SISSO framework,
   together with a database of artificially generated alpha F-2 functions
   and numerical solutions of the Eliashberg equations, we derive a formula
   for T-c that performs as well as Allen-Dynes for low-T-c superconductors
   and substantially better for higher-T-c ones. This corrects the
   systematic underestimation of T-c while reproducing the physical
   constraints originally outlined by Allen and Dynes. This equation should
   replace the Allen-Dynes formula for the prediction of higher-temperature
   superconductors.},
Type = {Article},
DOI = {10.1038/s41524-021-00666-7},
