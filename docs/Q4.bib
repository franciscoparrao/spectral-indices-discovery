@article{ WOS:001708161700028,
Author = {Cao, Ying and Cheng, Qing and Xi, Zhipeng},
Title = {Multisource Remote Sensing Interpretation of Geological Lithology via
   Multigranularity Adaptive Learning},
Journal = {IEEE TRANSACTIONS ON GEOSCIENCE AND REMOTE SENSING},
Year = {2026},
Volume = {64},
Abstract = {Environmental-geological interactions lead to a fragmented spatial
   distribution of elements and homogenization among adjacent regions.
   Furthermore, single-source data suffer from limited feature
   representation, and multisource feature fusion faces the issue of
   spatial heterogeneity. These issues degrade the accuracy of deep
   learning-based interpretation methods relative to expert visual analysis
   and lead to boundary ambiguity in segmentation maps. To address these
   issues, we propose the multigranularity adaptive learning network
   (MGALNet), a unified framework designed for adaptive multisource data
   fusion and multiple geological lithology interpretation. MGALNet enables
   the joint utilization of multisource data to enrich lithology details
   and enhance feature representation, thus addressing boundary ambiguity
   segmentation. Specifically, the multigranularity feature extraction and
   fusion module (MGFEEM) mitigates spatial heterogeneity in multisource
   features via double-branch granularity extraction and adaptive feature
   fusion, ensuring consistent feature representation. To mitigate boundary
   ambiguity segmentation, the feature rectify module aggregates vertical
   and horizontal spatial contexts to refine spatial structural features,
   and the spatial feature enhancement module (SFEM) captures spatial
   dependencies across channels to strengthen boundary feature
   discrimination. Experiments on the constructed Geo-WQ and Geo-XZ
   datasets show that MGALNet surpasses state-of-the-art methods. It
   achieves an overall accuracy (OA) of 83.61\% and a mean intersection
   over union (mIoU) of 64.78\% on Geo-WQ, the OA of 84.18\% and mIoU of
   63.99\% on Geo-XZ. These results confirm that MGALNet effectively
   integrates multisource complementary information and achieves accurate
   lithological interpretation with improved computational efficiency. The
   code is available at https://github.com/Candy-CY/MGALNet},
Type = {Article},
DOI = {10.1109/TGRS.2026.3667275},
Article-Number = {4501514},
Keywords = {Geology; Remote sensing; Earth; Feature extraction; Artificial
   satellites; Accuracy; Sentinel-2; Rocks; Convolutional neural networks;
