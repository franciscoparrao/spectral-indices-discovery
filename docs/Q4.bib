@incollection{ WOS:001316158504121,
Author = {Velastegui-Montoya, Andres and Mora-Mejia, Samuel and Chuizaca-Espinoza,
   Isabel Adriana and Pena-Villacreses, Gina and Mishra, Vishal and
   Ochoa-Brito, I, Jose},
Book-Group-Author = {IEEE},
Title = {SUSTAINABLE DEVELOPMENT CHALLENGES IN THE ECUADORIAN AMAZON: A CASE
   STUDY OF LAND USE AFFECT AND LANDSLIDE RISKS INDUCED BY A HYDROPOWER
   PLANT},
Booktitle = {IGARSS 2024-2024 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM, IGARSS 2024},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2024},
Pages = {4178-4182},
Abstract = {Hydroelectric dams in the Upper Amazon contribute significantly to
   renewable energy generation. However, their construction can have
   negative impacts, such as altering ecosystems and displacing indigenous
   communities. In Ecuador, the Coca Codo Sinclair Power Plant (CHCCS) was
   built in 2016, but since 2020, landslides have been reported near the
   Coca River. This study aims to assess land use and land cover changes
   below the CHCCS using the Google Earth Engine platform to identify mass
   movements around the Coca River. This project was developed in three
   stages: 1) elaboration of cloud-free mosaics from Sentinel 2 satellite
   images, 2) classification of use and coverage of the scenario, and 3)
   analysis of mass movements around the Coca River. The results reveal
   three areas with the greatest soil alteration where the NDVI, NDSI and
   MNDWI indices provided to distinguish the different soil alterations.},
Type = {Proceedings Paper},
DOI = {10.1109/IGARSS53475.2024.10642788},
Keywords = {Google Earth Engine; LULC; Ecuadorian Amazon; Hydroelectric; Regressive
