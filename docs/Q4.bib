@article{ WOS:001116784000001,
Author = {Maniyar, Chintan B. and Rudresh, Megha and Callejas, Ileana A. and
   Osborn, Katie and Lee, Christine M. and Jay, Jennifer and Phillips,
   Myles and Auil Gomez, Nicole and Cherrington, Emil A. and Griffin,
   Robert and Evans, Christine and Rosado, Andria and Rosado, Samir and
   Felgate, Stacey L. and Evans, Claire and Martin-Arias, Vanesa and
   Mishra, Deepak R. and Marcello, Javier},
Title = {Spatio-Temporal Dynamics of Total Suspended Sediments in the Belize
   Coastal Lagoon},
Journal = {REMOTE SENSING},
Year = {2023},
Volume = {15},
Number = {23},
Month = {DEC},
Abstract = {Increased tourism in Belize over the last decade and the growth of the
   local population have led to coastal development and infrastructure
   expansion. Land use alteration and anthropogenic activity may change the
   sediment and nutrient loads in coastal systems, which can negatively
   affect ecosystems via mechanisms such as reducing photosynthetically
   active radiation fields, smothering sessile habitats, and stimulating
   eutrophication events. Accurate monitoring and prediction of water
   quality parameters such as Total Suspended Sediments (TSS), are
   essential in order to understand the influence of land-based changes,
   climate, and human activities on the coastal systems and devise
   strategies to mitigate negative impacts. This study implements machine
   learning algorithms such as Random Forests (RF), Extreme Gradient
   Boosting (XGB), and Deep Neural Networks (DNN) to estimate TSS using
   Sentinel-2 reflectance data in the Belize Coastal Lagoon (BCL) and
   validates the results using TSS data collected in situ. DNN performed
   the best and estimated TSS with a testing R2 of 0.89. Time-series
   analysis was also performed on the BCL's TSS trends using Bayesian
   Changepoint Detection (BCD) methods to flag anomalously high TSS
   spatio-temporally, which may be caused by dredging events. Having such a
   framework can ease the near-real-time monitoring of water quality in
   Belize, help track the TSS dynamics for anomalies, and aid in meeting
   and maintaining the sustainable goals for Belize.},
Type = {Article},
DOI = {10.3390/rs15235625},
Article-Number = {5625},
Keywords = {Belize coastal lagoon; total suspended sediments; machine learning;
   spatio-temporal analyses},
