@incollection{ WOS:001515777600147,
Author = {Katkar, Rushikesh and Vijaywargiya, Jayati and Ramiya, Anandakumar M.},
Book-Group-Author = {IEEE},
Title = {ASSESSING CHANGING LANDSLIDE RISKS IN WAYANAD, KERALA THROUGH TEMPORAL
   SUSCEPTIBILITY MAPPING},
Booktitle = {2024 IEEE INDIA GEOSCIENCE AND REMOTE SENSING SYMPOSIUM, INGARSS},
Year = {2024},
Pages = {512-515},
Abstract = {Landslide susceptibility mapping is crucial for understanding and
   mitigating the risks associated with natural disasters, especially in
   geologically sensitive regions like Wayanad, Kerala. In such regions,
   certain areas remain consistently vulnerable, while others have
   experienced an escalation in risk due to factors such as deforestation,
   infrastructure development, and increased precipitation. This study maps
   landslide susceptibility in Wayanad, Kerala, over three key periods:
   July 2023, December 2023, and July 2024, using Google Earth Engine
   (GEE), a combination of static datasets (such as SRTM DEM, Bhoonidhi for
   landslide locations, lineament, lithology, and FAO soil data), dynamic
   datasets (including IMERG for precipitation, SMAP for soil moisture, and
   Sentinel-2 for NDVI with Google Dynamic World dataset for land use and
   land cover). Furthermore, by analyzing temporal changes, the research
   identifies shifts in landslide susceptibility in the region and reveals
   a significant increase in high-risk areas by July 2024, compared to
   their susceptibility a year and six months earlier. The study provides
   insights into the dynamic nature of landslide risks and their
   correlation with changing parameters, emphasizing the need for
   continuous monitoring and adaptive disaster preparedness strategies.},
Type = {Proceedings Paper},
DOI = {10.1109/InGARSS61818.2024.10983924},
Keywords = {Landslide Susceptibility; Temporal Monitoring; Disaster Preparedness;
   GEE},
Research-Areas = {Geology; Remote Sensing},
