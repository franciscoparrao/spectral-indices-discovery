@article{ WOS:000725019100001,
Author = {Abdelkareem, Mohamed and Al-Arifi, Nassir},
Title = {Synergy of Remote Sensing Data for Exploring Hydrothermal Mineral
   Resources Using GIS-Based Fuzzy Logic Approach},
Journal = {REMOTE SENSING},
Year = {2021},
