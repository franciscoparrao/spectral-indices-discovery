@incollection{ WOS:000309699400170,
Author = {Barton, Mark D. and Kreiner, Douglas C. and Jensen, Eric P. and Girardi,
   James D.},
Editor = {Barra, F and Reich, M and Campos, E and Tornos, F},
Title = {Multiple igneous-related hydrothermal systems and related IOCG
   mineralization, near Copiapo, Chile},
Booktitle = {LET'S TALK ORE DEPOSITS, VOLS I AND II},
Year = {2011},
Pages = {519-521},
Abstract = {The composite, Early Cretaceous Copiapo batholith and adjacent, broadly
   coeval volcanic rocks host many IOCG systems notably Candelaria and the
   Punta del Cobre district. New geologic mapping (>200 km(2)) and U-Pb
   geochronology has elucidated the character and time-space development of
   hydrothermal alteration and its relationship to a complex igneous
   history. These observations demonstrate that each magmatic center
   generated its own hydrothermal system with voluminous sodic-calcic
   (Na-Ca) associations and variable, but widely recognized K-silicate
   suites. Shallow hydrolytic alteration is common. Hydrothermal
   characteristics correlate with the composition of coeval magmatism.
   Na-Ca (+/- Ca) is most intense with dioritic rocks and weakens inward
   from intrusive margins. Consistent with petrologic predictions,
   intrusion-hosted K-silicate styles vary: widespread K-Ca (+local
   hydrolytic) relates to upflow (cooling) of Na-Ca fluids; rarer, week
   porphyry-like K-Si reflects cooling of magmatic fluids and forms only
   with felsic plutons; stratabound types might reflect recharge. Lab
   studies show that magmas were calcalkaline, mantle-dominated, and
   emplaced in the uppermost crust. Most exsolved little fluid yet all
   circulated voluminous external brines (Sr-87/Sr-86(i)). Questions remain
   about metal sources and traps, however similar patterns in many
   Cordilleran and global IOCG districts suggest a common genesis.},
Type = {Proceedings Paper},
Keywords = {IOCG; alteration; Candelaria; Punta del Cobre; zoning},
