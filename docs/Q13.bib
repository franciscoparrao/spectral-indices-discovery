@incollection{ WOS:000282993400132,
Author = {Biel, Cecilia and Subias, Ignacio and Fanlo, Isabel and Acevedo, Daniel
   and Velasco, Francisco and Yusta, Inaki},
Editor = {Williams, PJ},
Title = {Hydrothermal Alteration at the Arroyo Rojo VMS Prospect (Tierra del
   Fuego, Argentina): Field mapping, mineralogical analysis and Short-Wave
   Infrared Spectroscopy},
Booktitle = {SMART SCIENCE FOR EXPLORATION AND MINING, VOL 1 AND 2},
Year = {2010},
Pages = {400-402},
Abstract = {The Arroyo Rojo prospect, located in the Fueguian Andes volcanic belt,
   has been explored for polymetallic massive sulphide mineralization.
   Jurassic hydrothermal activity produced intense alteration of rhyolites,
   ignimbrites and tuffs of the Early Jurassic Lemaire Formation. A
   detailed study of the mineralogy and architecture of hydrothermal
   alteration was achieved employing field mapping and drill logging,
   supported by short-wave infrared (PIMA) field spectroscopy, petrography,
   X-ray diffraction (XRD), scanning electron microscopy (SEM) and electron
   microprobe. The alteration zone has a lens-like shape about 300 m x 150
   m in size, with a E W strike. It consists of a mineralized central
   pervasive Mg-chlorite alteration. Outwards there is a phyllic halo
   consisting of a zonal sericitization, vein-type silicification
   (stringer) and pyritization.},
Type = {Proceedings Paper},
Keywords = {VMS; hydrothermal alteration; PIMA; Tierra del Fuego},
Research-Areas = {Geology; Mining \& Mineral Processing},
Cited-References = {BIEL C, 2007, MINERALOGICAL CHARAC.
