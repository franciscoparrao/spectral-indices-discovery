@incollection{ WOS:001316158502112,
Author = {Schodlolk, Martin and Frei, Michaela and Hahne, Kai and Neugschwentner,
   Bernhard},
Book-Group-Author = {IEEE},
Title = {UAV based hyperspectral mapping of a magnesite deposit in the Hochfilzen
   region, Austria},
Booktitle = {IGARSS 2024-2024 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM, IGARSS 2024},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2024},
Pages = {2110-2112},
Abstract = {Remote sensing data can be successfully applied in mineral resource
   prospecting and exploration. With the increasing number of remote
   sensing sensors and methods, the application of multi-scale remote
   sensing data has met a broad audience in the geological remote sensing
   community over the last few years. Multi-scale remote sensing data close
   the scale gap between distal (satellite) and proximal (laboratory)
   remote sensing data, offering both a general and detailed overview of
   the target and allowing a synergistic use.
   A multiscale approach for advanced mineral mapping based on EO data will
   be demonstrated for the Magnesite occurrences in the region Hochfilzen
   (Austria) in the framework of the MultiMiner Project {[}1]. Optical data
   are used for the detection, identification and characterisation of
   different occurrences of magnesite and dolomite.
   Here the Hyperspectral UAV approach is presented, including
   hyperspectral imaging data acquisition, as well as photogrammetric UAV
   data for DSM creation. Field analyses are acquired with the Ore Explorer
   hyperspectral point spectrometer for calibration and validation
   approaches. Rock samples are investigated in the laboratory using the
   SisuROCK hyperspectral core imaging station. The mineral(group)
   identification and characterisation are performed with either spectral
   feature fitting methods or mineral indices. Hyperspectral analyses show
   Mg-/Ca-distribution, different Feenrichment owing to wavelength shifts
   of the absorption maximum respectively. Results of the hyperspectral UAV
   survey at the Weissenstein open pit, validated with spectral ground
   truth and mineralogy are discussed. Challenges arise from the different
   spatial and spectral resolutions of the hyperspectral data.},
Type = {Proceedings Paper},
DOI = {10.1109/IGARSS53475.2024.10641275},
Keywords = {Exploration; VNIR-SWIR hyperspectral remote sensing; mineral
   identification; Magnesite; UAV},
Research-Areas = {Physical Geography; Geology; Remote Sensing; Imaging Science \&
   Photographic Technology},
Cited-References = {{[}Anonymous], 2023, US.
   {[}Anonymous], 2023, PARGE DROACOR 2023.
   {[}Anonymous], About us.
