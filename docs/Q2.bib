@article{ WOS:001490454900001,
Author = {Lavaei, Rasoul and Niroomand, Shojaeddin and Pour, Amin Beiranvand and
   Soleymani, Majid},
Title = {Integration of ASTER and PRISMA remote sensing satellite imagery for
   mapping lithology, alteration and structural features associated with
   the Kuh-e-Janja Cu-Au ± Mo porphyry deposit, SE Iran},
Journal = {REMOTE SENSING APPLICATIONS-SOCIETY AND ENVIRONMENT},
Year = {2025},
Volume = {38},
Month = {APR},
Abstract = {Multispectral and hyperspectral remote sensing satellite images have
   great capabilities to address the costly and complicated exploration
   challenges associated with Cu-Au f Mo porphyry deposits. In this study,
   ASTER and PRISMA satellite imageries were integrated for the mapping of
   alteration zones, lithological units, and structural features associated
   with the Kuh-e-Janja Cu-Au f Mo porphyry deposit, Sistan Suture Zone,
   southeast Iran. First, specific band ratios, principal component
   analysis (PCA) and directional filtering methods were applied to the
   ASTER data to map the geological features of the Kuh-e-Janja deposit
   from a regional perspective. In the next step, the spatial resolution of
   the PRISMA visible near-infrared (VNIR) and shortwave infrared (SWIR)
   bands was increased from 30 m to 5 m by applying the Gram-Schmidt
   pan-sharpening algorithm. Subsequently, the alteration minerals and
   structural features of the deposit were mapped at the local scale using
   Constrained Energy Minimization (CEM), Linear Spectral Unmixing (LSU)
   and directional filtering techniques implemented in the enhanced PRISMA
   bands. Finally, the remote sensing results were validated by a
   combination of field work, laboratory analysis and geostatistical
   methods. The results indicate that propylitic and silicic alteration is
   most prevalent in the hornfels and skarn units of the region, while
   potassic and phyllic alteration (zones of high mineralization potential)
   is associated with less argillic alteration in the intrusive masses. In
   addition, the faults and fold axes of the region generally trend
   north-south. This study has demonstrated the advantages of the enhanced
   spatial resolution of PRISMA images for spectral analysis of alteration
   minerals and highlighted the usefulness of the PRISMA panchromatic band
   for mapping structural features associated with Cu-Au f Mo porphyry
   deposits. Furthermore, the integration of ASTER and PRISMA datasets with
   field surveys proved to be a suitable tool for mapping lithology,
   alteration and structural features associated with Cu-Au f Mo porphyry
   deposits and mineral exploration in difficult and remote areas
   worldwide.},
Type = {Article},
DOI = {10.1016/j.rsase.2025.101578},
EarlyAccessDate = {MAY 2025},
Article-Number = {101578},
Keywords = {ASTER; PRISMA; Cu-Au f Mo porphyry deposit; alteration mapping; Mineral
   exploration; Kuh-e janja; Iran},
Keywords-Plus = {SISTAN SUTURE ZONE; HYDROTHERMALLY ALTERED ROCKS; SPACEBORNE THERMAL
