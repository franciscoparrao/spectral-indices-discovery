@incollection{ WOS:000233264200091,
Author = {Ranjbar, H and Ahmadi, O and Shayestehfar, MR},
Editor = {Cheng, Q and BonhamCarter, G},
Title = {Integration and analysis of geological, geophysical and remote sensing
   data for exploration of Cu mineralization in Dehaj (Kader) Area, Iran. A
   GIS approach},
Booktitle = {GIS AND SPATIAL ANALYSIS, VOL 1AND 2},
Year = {2005},
Pages = {545-550},
Abstract = {ASTER data is analyzed by using different image processing techniques
   such as band ratioing, principal component analysis, RGB to IHS
   transformation etc. The alteration map is prepared through Crosta
   technique. Airborne geophysical data (Th, K, U counts and total magnetic
   intensity map) is analyzed by using direct principal component analysis.
   A principal component is chosen to characterize the altered areas, i.e.,
   higher loadings of K, Th, U and higher loading of total magnetic
   intensity but with opposite signs. An image is prepared by using these
   eigenvector loadings. A photolineament factor value map is prepared by
   using ASTER filtered images. The geological map is also brought into a
   digital format and the intrusive bodies were extracted into a separate
   image. The forth principal component image of ASTER data, first
   principal component image of the geophysical data, photolineament factor
   value image and intrusive body image are co-registered and classified by
   using fuzzy classification method. A known hydrothermally altered area
   with copper mineralization is chosen as a training site. Through this
   method, the favorable areas are shown for further detailed exploration.},
Type = {Proceedings Paper},
Keywords-Plus = {ETM+ DATA; FUZZY},
