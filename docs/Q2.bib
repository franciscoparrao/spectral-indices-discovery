@article{ WOS:001694905500014,
Author = {Huynh, Tien Dat and Pham, Thuy Thanh and Hoang, Thi Thanh Thuy and Pham,
   Khanh Huyen},
Title = {Lithological mapping using Landsat data 9 in the Daknong province,
   Vietnam},
Journal = {INZYNIERIA MINERALNA-JOURNAL OF THE POLISH MINERAL ENGINEERING SOCIETY},
Year = {2025},
Number = {1},
Pages = {553-563},
Month = {JAN-JUN},
Abstract = {The study utilizes Landsat 9 data (OLI-2 and TIRS-2 sensors) to create a
   geological map of Dak Nong province, Vietnam. By applying spectral
   analysis methods (PCA, band ratios), image classification techniques
   (SAM, CEM), and integrating field surveys, the research identified four
   main geological units: Quaternary sediments, Jurassic sedimentary rocks,
   basalt, and Cretaceous granite. The results demonstrate that Landsat 9
   achieves high accuracy in geological mapping, particularly for basalt
   (with an error of only 0.68\%). However, its ability to distinguish
   sub-units and areas with complex surface coverage remains limited,
   requiring support from field surveys to improve reliability.},
Type = {Article},
