@article{ WOS:000577118900026,
Author = {Zong, Jingjing and Stewart, Robert R. and Dyaur, Nikolay},
Title = {Attenuation of Rock Salt: Ultrasonic Lab Analysis of Gulf of Mexico
   Coastal Samples},
Journal = {JOURNAL OF GEOPHYSICAL RESEARCH-SOLID EARTH},
Year = {2020},
Volume = {125},
Number = {7},
Month = {JUL},
Abstract = {In an effort to achieve higher-resolution imaging as well as detailed
   lithology descriptions, it is important to consider attenuation as an
   aid in compensating for seismic wave amplitude and phase distortions due
   to the viscoelastic properties of natural rocks. We have evaluated
   elastic-wave attenuation on a variety of Gulf of Mexico (GoM) rock salt
   samples (>95\% halite by weight) in the laboratory using the ultrasonic
   pulse-transmission technique and the spectral ratio (SR) method. Under
   conditions of 297 K (75 degrees F) and relative humidity of 46\%, the
   estimated P- and S-wave quality factors QP and QS range from 26 to 74
   and 29 to 44 in the unjacketed core samples, respectively. Increasing
   triaxial pressure elevates Q (decreases attenuation), possibly due to
   the crack closure and rock frame compaction. For example, a 40 MPa
   confining pressure increases QP to 275 at 297 K (75 degrees F).
   Elevating temperature does not show a significant effect on Q values
   until raised from 339 to 366 K (150 degrees F to 200 degrees F), during
   which QP drops sharply (attenuation increases). The attenuation
   mechanisms may include thermal cracking and grain boundary condition
   changes. We have determined well-constrained empirical relationships
   between Q and velocity (V) for both P- and S-waves. These measurements
   and empirical relationships can further inform us about salt properties
   and assist with images of and through salt bodies.},
Type = {Article},
DOI = {10.1029/2019JB019025},
Article-Number = {e2019JB019025},
Keywords = {rock salt; attenuation; Gulf of Mexico; ultrasonic pulse-transmission
   measurements; spectral ratio method; rock physics},
