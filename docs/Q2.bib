@article{ WOS:001514976400001,
Author = {McBride, John H. and Lambeck, Lex and Rey, Kevin A. and Nelson, Stephen
   T. and Keach, R. William},
Title = {Experimental Seismic Surveying in a Historic Underground Metals Mine},
Journal = {GEOSCIENCES},
Year = {2025},
Volume = {15},
Number = {6},
Month = {JUN 12},
Abstract = {Underground mine surveys present unique challenges, including the
   logistics of deploying an energy source, placing geophones in solid
   rock, managing reverberation from the adit, and ensuring safety. We
   present the results of seismic surveying at the historic Deer Trail Mine
   in south-central Utah (USA). The mine is located along the eastern side
   of the Tushar Range. The surveys utilised a narrow, mostly horizontal
   adit, 120-510 m below the ground surface. The country rock consists of
   highly fractured and mineralised Permian to Pennsylvanian quartzites,
   shales, and limestones. A short test of a 96-channel common midpoint
   (CMP) P-wave profile was conducted using an accelerated weight-dropper
   source. We supplemented the P-wave survey with tests of surface-wave
   dispersion and horizontal-vertical spectral ratio modelling for shallow
   S-wave structure. These tests confirmed the capability to map shallow,
   small-scale structure. A conventional CMP 264-channel survey with an
   explosive source covered 1728 m. A static recording array was used for
   both surveys with 4.5-Hz vertical geophones. The conventional CMP
   profile imaged horizontal and dipping reflectors down to about 2000 m,
   interpreted as lithologic variations in the bedrock. Our study
   demonstrates the potential for high-resolution seismic exploration in an
   unconventional and challenging setting to guide the exploitation of
   deeply buried mineral resources.},
Type = {Article},
DOI = {10.3390/geosciences15060221},
Article-Number = {221},
Keywords = {mining; tunnell; seismic; MASW; HVSR; Utah; Colorado Plateau},
