@article{ WOS:000517988100001,
Author = {Sadek, Mohamed F. and El-kalioubi, Baher A. and Ali-Bik, Mohamed W. and
   El Hefnawi, Mariam A. and Elnazer, Ahmad A.},
Title = {Utilizing Landsat-8 and ASTER data in geologic mapping of hyper-arid
   mountainous region: case of Gabal Batoga area, South Eastern Desert of
   Egypt},
Journal = {ENVIRONMENTAL EARTH SCIENCES},
Year = {2020},
Volume = {79},
Number = {5},
Month = {FEB 24},
Abstract = {Landsat-8 and ASTER images were utilized to derive geological
   information and mapping of a hyper-arid mountainous region. Principal
   component analyses and band rationing techniques in conjunction with
   petrography and field investigations enabled to produce a modified new
   geologic map of Gabal Batoga area, along the Red Sea coast of Egypt. The
   area is built by non-consanguineous diverse Pan-African basement rock
   units. These rock units are widely distributed in the Arabian-Nubian
   Shield. ASTER principal component images (PC2, PC5, PC7) and (PC2, PC3,
   PC8) as well as band ratio images (b4/b7, b3/b4, b2/b1) were effective
   in accurate lithological discrimination of the exposed rock units in the
   study area. The process was also enhanced and emphasized by Landsat-8
   principal component images (PC2, PC4, and PC7) and band ratio (b6/b2,
   b6/b7, b6/b5 x b4/b5). The used methodology and techniques can be
   applicable in many similar arid and hyper-arid areas in the
   Arabian-Nubian Shield and elsewhere.},
Type = {Article},
DOI = {10.1007/s12665-020-8845-4},
Keywords = {Hyper-arid mountainous; Pan-African basement rocks; Gabal Batoga;
   Mapping; Landsat-8; ASTER},
