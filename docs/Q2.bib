@article{ WOS:001658945100001,
Author = {Es-sabbar, Ismail and Toubri, Youssef and En-nabbadi, Reda and Raji,
   Otmane and Berkat, Nour Eddine and Ghadi, Taha and El Baroudi, Majid and
   Ouabid, Muhammad and Rezouki, Ibtissam and Sadki, Othman and Benzaazoua,
   Mostafa},
Title = {Natural hydrogen occurrences in Northwest Morocco: Evidence from
   subsurface data and soil gas surveys},
Journal = {INTERNATIONAL JOURNAL OF HYDROGEN ENERGY},
Year = {2026},
Volume = {204},
Month = {JAN 28},
Abstract = {In northwestern Morocco, surface geological and morphological data
   emphasize surface natural H2 occurrences. In the study area, exploration
   boreholes in the Maamora-Gharb Basin intersect Lower Paleozoic and
   Neoproterozoic basement. The overlying cover ranges from the Lower
   Triassic to the Plio-Quaternary. From a structural perspective, surface
   and seismic surveys reveal a fault network trending predominantly
   WNW-ESE to NE-SW across Maamora-Gharb and NE-SW in the Khemisset Basin.
   Furthermore, numerous sub-circular depressions (SCDs) were identified
   and mapped across the study area using vegetation and mineral indices
   derived from Sentinel-2 imagery. In situ soil-gas surveys at selected
   SCDs identified anomalously high H2 concentrations, reaching up to 1000
   ppmv, with peak values consistently occurring along the margins of the
   depressions. The spatial distribution of SCDs is suspected to be
   controlled primarily by underlying lithologies. Based on the borehole
   data and the resulting 3D geological model, the high density of SCDs in
   the Maamora and Sidi Bettache basins may be attributed to the absence of
   effective sealing lithologies. Likewise, their scarcity in the Gharb and
   Khemisset basins is likely related to the presence of low-permeability
   Rifan Nappe and the clay-evaporites sequences. Additionally, the
   alignment of numerous SCDs along major fault systems in the Maamora
   region and northern Sidi Bettache Basin suggests a potential structural
   control on their spatial distribution. This study confirms the
   occurrence of H2 seepage associated with SCDs and the studied geological
   framework providing a foundation for further investigations of the H2
   generating-system.},
Type = {Article},
DOI = {10.1016/j.ijhydene.2025.153344},
EarlyAccessDate = {JAN 2026},
Article-Number = {153344},
Keywords = {Natural hydrogen; Sub-circular depressions; Spatial distribution; Soil
   gas surveys},
