Author = {Okpoli, Cyril Chibueze and Ogbole, John Owoicho and Victor, Oyeshomo
   Anthony and Okanlawon, Gbadebo Olumide},
Title = {Mineral exploration of Iwo-Apomu Southwestern Nigeria using aeromagnetic
   and remote sensing},
