@article{ WOS:000460113200012,
Author = {Ma, Chi and Liu, Yang},
Title = {Discovery of a zinc-rich mineral on the surface of lunar orange
   pyroclastic beads},
Journal = {AMERICAN MINERALOGIST},
Year = {2019},
Volume = {104},
Number = {3},
Pages = {447-452},
Month = {MAR},
Abstract = {We present the first discovery of a Zn-rich mineral on the pristine
   surface of orange pyroclastic beads from Apollo sample 74220. This
   Zn-rich mineral is wide occurring, trigonal or hexagonal in shape, with
   a normalized composition of similar to 59 wt\% Zn, similar to 26 wt\% O
   (calculated), similar to 6 wt\% S, similar to 5 wt\% Na, and similar to
   4 wt\% Cl. The crystal morphology, homogeneity, and chemistry of
   individual grains are most consistent with gordaite, a zinc
   chlorohydroxosulfate mineral, showing an empirical formula of
   Na1.02Zn3.98{[}(SO4)(0.84)(OH)(0.30)](OH)(6){[}Cl-0.50(OH)(0.50)]center
   dot nH(2)O, albeit the exact amounts of OH and H2O are uncertain. The
   pristine 74220 sample used in this study was only directly exposed to
   air for a cumulative period of 18 days before our study. The same
   Zn-rich crystals, examined 12 to 15 months apart, show no visible
   physical and chemical changes. Thus, this zinc-rich mineral likely
   formed through rapid alteration (oxidation and hydration) by terrestrial
   air of the original vapor-deposited Zn, Cl, S, and Na-bearing solids.
   The composition of the zinc-rich mineral indicates that the vapor
   condensates consist of metallic Zn and metallic Na with either ZnS or
   native S, and either ZnCl2 or NaCl. This is the first direct evidence
   that metallic Zn and Na are key components in the vapor condensates of
   lunar volcanic gas, which implies lunar volcanic gas may be under higher
   pressure than previously thought, and the gas composition may be
   different than previously inferred. Our study is also relevant to the
   collection, handling, curation, and sample preparation of returned
   samples from other planetary bodies.},
Type = {Article},
DOI = {10.2138/am-2019-6896},
Keywords = {Lunar orange beads; volcanic gas; vapor condensates; the Moon; zinc-rich
   mineral; gordaite},
Keywords-Plus = {VOLCANIC GLASSES; WATER; GORDAITE; PRODUCTS; DEPOSITS; SAMPLES; COPPER},
