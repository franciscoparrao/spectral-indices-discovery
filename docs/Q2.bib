@incollection{ WOS:000282993400196,
Author = {Hancock, Sophie and Hitzman, Murray and Revil, Andre},
Editor = {Williams, PJ},
Title = {Characterizing Uranium Roll Front Deposits: Geophysical Tools For
   Exploration And Production},
Booktitle = {SMART SCIENCE FOR EXPLORATION AND MINING, VOL 1 AND 2},
Year = {2010},
Pages = {595-597},
Abstract = {Uranium roll front deposits will continue to be important for both
   global uranium supply and known reserves. To support exploration and
   production of these deposits, conceptual orebody geometries and zonation
   styles must be modeled beyond the typical resolution limits of
   delineation drilling and borehole logging. Electrical geophysical
   methods including self-potential, spectral induced polarization and
   direct-current resistivity are potentially powerful characterization
   tools. Geophysical methods can infer geologic information (contacts,
   structure, lithology, and facies data) and geochemical information
   (potentially identifying mineralization zones and location of the redox
   roll front interface). Hydrogeologic information required to plan
   sub-water table roll front production by In-Situ Recovery methods, can
   also be geophysically determined. Hydrogeologic aspects which can be
   defined include water table position and character, degree of aquifer
   saturation, hydraulic head, and transmissivity. Applied groundwater
   geophysics also aids interpretation of field pump test and drawdown
   data, allowing constraint of site specific hydrogeologic parameters. To
   varying extents the described geophysical techniques are currently being
   applied to other mineral exploration problems. Property scale field
   tests for the application of self-potential measurement of redox roll
   front properties are now required. Self-potential, induced polarization
   and resistivity hydrology applications are more established but require
   demonstration for roll front uranium use.},
Type = {Proceedings Paper},
Keywords = {Uranium roll front; In-Situ Recovery; self-potential; induced
   polarization; resistivity},
