@article{ WOS:000286181500007,
Author = {Pekov, I. V. and Zubkova, N. V. and Chukanov, N. V. and Zadov, A. E. and
   Grishin, V. G. and Pushcharovsky, D. Yu.},
Title = {Yegorovite,
   Na4{[}Si4O8(OH)4] •
   7H2O, a New Mineral from the Lovozero Alkaline Pluton, Kola
   Peninsula},
Journal = {GEOLOGY OF ORE DEPOSITS},
Year = {2010},
Volume = {52},
Number = {7},
Pages = {584-590},
Month = {DEC},
Abstract = {A new mineral, yegorovite, has been identified in the late hydrothermal,
   low-temperature assemblage of the Palitra hyperalkaline pegmatite at Mt.
   Kedykverpakhk, Lovozero alkaline pluton, Kola Peninsula, Russia. The
   mineral is intimately associated with revdite and megacyclite, earlier
   natrosilite, microcline, and villiaumite. Yegorovite occurs as coarse,
   usually split prismatic (up to 0.05 x 0.15 x 1 mm) or lamellar (up to
   0.05 x 0.7 x 0.8 mm) crystals. Polysynthetic twins and parallel
   intergrowths are typical. Mineral individuals are combined in bunches or
   chaotic groups (up to 2 mm); radial-lamellar clusters are less frequent.
   Yegorovite is colorless, transparent with vitreous luster. Cleavage is
   perfect parallel to (010) and (001). Fracture is splintery; crystals are
   readily split into acicular fragments. The Mohs hardness is similar to
   2. Density is 1.90(2) g/cm(3) (meas) and 1.92 g/cm(3) (calc). Yegorovite
   is biaxial (-), with alpha = 1.474(2), beta = 1.479(2), and gamma =
   1.482(2), 2V(meas) > 70 degrees, 2V(calc) = 75 degrees. The optical
   orientation is X boolean AND a similar to 15 degrees, Y = c, Z = b. The
   IR spectrum is given. The chemical composition determined using an
   electron microprobe (H2O determined from total deficiency) is (wt \%):
   23.28 Na2O, 45.45 SiO2, 31.27 H2Ocalc; the total is 100.00. The
   empirical formula is Na3.98Si4.01O8.02(OH)(3.98) center dot 7.205H(2)O.
   The idealized formula is Na-4{[}Si4O8(OH)(4)] center dot 7H(2)O.
   Yegorovite is monoclinic, space group P2(1)/c. The unit-cell dimensions
   are a = 9.874, b= 12.398, c = 14.897 angstrom, beta = 104.68 degrees, V=
   1764.3 angstrom(3), Z = 4. The strongest reflections in the X-ray powder
   pattern (d, angstrom (I, \%)({[}hkl]) are 7.21(70){[}002],
   6.21(72){[}012, 020], 4.696(44){[}022], 4.003(49){[}211],
   3.734(46){[}(2) over bar 13], 3.116(100){[}024, 040], 2.463(38){[}(4)
   over bar 02, (2) over bar 43]. The crystal structure was studied by
   single-crystal method, R-hkl = 0.0745. Yegorovite is a representative of
   a new structural type. Its structure consists of single chains of Si
   tetrahedrons {[}Si4O8(OH)(4)]infinity and sixfold polyhedrons of two
   types: {[}NaO(OH)(2)(H2O)(3)] and {[}NaO(OH)(H2O)(4)] centered by Na.
   The mineral was named in memory of Yu. K. Yegorov-Tismenko (1938-2007),
   outstanding Russian crystallographer and crystallochemist. The type
   material of yegorovite has been deposited at the Fersman Mineralogical
   Museum of Russian Academy of Sciences, Moscow.},
