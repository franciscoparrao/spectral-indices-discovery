@incollection{ WOS:000257018600038,
Author = {Zhao, Zhifang and Zhang, Yujun and Cheng, Qiuming and Chen, Jianping},
Editor = {Li, G and Jia, Z and Fu, Z},
Title = {Mineral alteration abnormity extraction from ETM data: Application in
   northwestern Yunnan, China},
Booktitle = {2008 PROCEEDINGS OF INFORMATION TECHNOLOGY AND ENVIRONMENTAL SYSTEM
   SCIENCES: ITESS 2008, VOL 4},
Year = {2008},
Pages = {180-184},
Abstract = {Mineral alteration abnormalities extractions based on ETM data have been
   made use in northwestern Yunnan, which belongs to Sanjiang area, a
   famous mineralization belt in China. Through the study on the spectral
   features of hydroxyl (OH-) and iron ions (Fe2+ or Fe3+) related to
   mineral alterations, mineral alteration extraction methods are improved
   and a related process is developed. Interfering factors to mineral
   alterations are vegetation, snow and shadow. The vegetation is masked by
   ETM band ratio 514, while snow and shadow are masked by ETM band ratio
   7/1. With these interfering factors masked, Principal Component
   Analysis, (PCA) of ETM bands 1, 4, 5 and 7 is adopted for OH- alteration
   extraction. PCA of ETM bands 1, 3, 4 and 5 are used for Fe2+ (Fe3+)
