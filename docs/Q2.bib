@article{ WOS:001541782100001,
Author = {Yaseen, Muhammad and Chen, Rujun and Ahmad, Jawad and Shah, Shahid Ali
   and Fahad, Shah and Anjum, Muhammad Naveed and Shah, Syed Tanvir},
Title = {Unlocking the Geoheritage Potential of Hingol National Park (HNP),
   Pakistan: Geological and Geomorphological Insights Through
   Multi-Satellite Remote Sensing Data and Field Geology Validation},
Journal = {GEOHERITAGE},
Year = {2025},
Volume = {17},
Number = {3},
Month = {AUG 2},
Abstract = {The Hingol National Park (HNP) is a noteworthy geoheritage site situated
   in Balochistan, Pakistan. It highlights geological diversity, unique
   landforms, and ecological importance, standing it as a candidate for
   possible geoheritage recognition. Geologically, HNP is distinguished for
   its complex tectonic setting influenced by the Eurasian, Arabian, and
   Indian plates. This has resulted in remarkable geological formations
   such as mud volcanoes, unique rock structures like the Princess of Hope
   and the Balochistan Sphinx, and various geological heritage features
   that are candidates for UNESCO World Heritage status. In this study,
   geological and geomorphological features were inferred and visualized
   using multi-source satellite imagery, including Sentinel-2B and
   Landsat-9 data. These datasets were analyzed for detailed geological
   mapping, structural interpretation, and geoheritage assessment,
   integrated with the existing map of HNP. Our results show that HNP has
   great prospects as an aspiring global geopark in Pakistan, especially
   for mud volcanoes. These volcanoes possess unique geological and
   cultural features of international values which is also evident from the
   analysis of Landsat 9 and sentinel-2B dataset with techniques of FCC
   (False Color composite), PCA (Principal component analysis), BRs (Band
   Ratios) and supervised image classifications (SIC). These analyses
   greatly helped to improve the surface geological mapping with
   integration of field observation within the HNP. The results validate
   strong correlations between lithological units and structural features,
   supporting a comprehensive geoheritage assessment. These analyses
   effectively highlight the significant geoheritage elements within Hingol
   National Park (HNP). Overall, this study underlines HNP's importance as
   a key asset for Pakistan, providing essential ecological conservation,
   valuable geological insights, and rich cultural significance.},
Type = {Article},
DOI = {10.1007/s12371-025-01161-x},
Article-Number = {118},
Keywords = {Geoheritage; Geology; Geomorphology; HNP; Sentinel-2B; Landsat-9 data;
   Field justification; Balochistan; Pakistan},
