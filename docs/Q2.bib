@article{ WOS:A1988N981200004,
Author = {KLECZKOWSKA, HE and BURACZEWSKA, I and SZUMIEL, I},
Title = {BENZAMIDE-INHIBITABLE ALTERATIONS IN SPECTRAL PROPERTIES OF CHROMATIN
   ACCOMPANY DNA-REPAIR IN UVC-EXPOSED L5178Y-CELLS},
Journal = {RADIATION AND ENVIRONMENTAL BIOPHYSICS},
Year = {1988},
Volume = {27},
Number = {3},
Pages = {213-218},
Abstract = {We examined the response of chromatin to increasing NaCl and MgCl2
   concentrations in UVC-irradiated L5178Y (LY) R and S cells, using the
   spectral index method (Dixon and Burkholder 1985). We have found an
   alteration in chromatin properties 1 h after UVC-irradiation of repair
