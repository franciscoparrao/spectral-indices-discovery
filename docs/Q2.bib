@article{ WOS:001708153300002,
Author = {Lahrach, Fatima-Ezzahrae and Ouzzaouit, Lalla Amina and Berkat, Nour
   Eddine and Jana, Loubna Ait and Qarbous, Abdelmounim and Boumehdi,
   Mohammed and Boudad, Larbi},
Title = {Geothermal potential of the Middle Atlas and the Saiss Basin using
   remote sensing: An approach based on hydrothermal alteration and land
   surface temperature},
Journal = {JOURNAL OF AFRICAN EARTH SCIENCES},
Year = {2026},
Volume = {238},
Month = {JUN},
Abstract = {This study examines the geothermal potential of the Middle Atlas and the
   Saiss Basin using remote sensing. The approach combines the analysis of
   land surface temperatures (LST), derived from Landsat 8-9 and MODIS
   imagery, and mapping of hydrothermal alterations based on mineral
   indices extracted from ASTER spectral bands. The results identify three
   main sectors of interest in the study area. In the Folded Middle Atlas,
   carbonate indices, calcite veins, and elevated land surface temperatures
   (LST) around the Skhounate-Marmoucha hot spring indicate active
   hydrothermal circulation. The Tabular Middle Atlas is characterized by
   thermal anomalies south of Khenifra and Azrou and in the northwestern
   Sefrou area, associated with mineral assemblages dominated by silica,
   clays, and carbonates. These assemblages may result from meteoric
   alteration of Triassic and Liassic formations and/or hydrothermal
   alteration linked to Plio-Quaternary basaltic volcanism. In the Saiss
   Basin, detected anomalies appear to be mainly controlled by lithological
   and climatic factors rather than deep geothermal processes. While these
   results serve as preliminary indicators, they demonstrate that remote
   sensing can play a valuable role in detecting potential geothermal
   zones. Nevertheless, confirming the nature of the anomalies and
   constraining the reservoir depth will require further investigations,
   including thin-section petrographic analysis, mineralogical studies,
   geochemical data, and geophysical surveys.},
Type = {Article},
DOI = {10.1016/j.jafrearsci.2026.106109},
Article-Number = {106109},
Keywords = {Remote sensing; Geothermal energy; Hydrothermal alteration; Land surface
   temperature; Middle Atlas; Saiss basin; Morocco},
