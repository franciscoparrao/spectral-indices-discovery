@incollection{ WOS:001669853200103,
Author = {Caiza, Evelyn and Llerena, Marcelo},
Editor = {Anderson, E and Graham, G},
Title = {Hydrothermal alteration zones estimated by ASTER satellite image and ASD
   TerraSpec on the eastern zone of Cerro de Pasco, Peru},
Booktitle = {18TH SGA BIENNIAL MEETING, 2025, VOL 3},
Year = {2025},
Pages = {1212-1215},
Abstract = {The Cerro de Pasco area in central Peru comprises several metallogenic
   provinces containing a variety of deposit types, including Miocene and
   Oligocene polymetallic vein systems, Eocene stratabound polymetallic
   mineralization, Permian porphyry-style deposits, and orogenic gold
   associated with Ordovician metasedimentary units. The region's rugged
   topography and sparse vegetation make it well-suited for the application
   of remote sensing methodologies. This study focuses on identifying
   hydrothermal alteration zones through the analysis of ASTER satellite
   data and spectral signatures obtained from outcrop samples using an ASD
   TerraSpec. Four spectral techniques were applied: 1) RGB band
   combinations to map clay minerals, 2) band ratios to identify alteration
   assemblages, 3) SWIR spectral indices to corroborate mineralogical
   variations, and 4) Spectral Angle Mapper (SAM) analysis to integrate
   field ASD TerraSpec spectra with ASTER data. SAM confirmed and refined
   hydrothermal alteration halos, delineating eleven new exploration
   targets that include: seven highsulfidation systems that exhibit
   advanced and intermediate argillic alteration, three porphyry-related
   systems with phyllic, intermediate argillic, advanced argillic, and
   propylitic alteration, and one stratabound polymetallic system
   characterized by phyllic, propylitic alteration and carbonates. These
   results highlight the integration of remote sensing and field
   spectroscopy as a valuable exploration tool in structurally complex
   metallogenic settings.},
Type = {Proceedings Paper},
Research-Areas = {Geochemistry \& Geophysics; Geology; Mineralogy},
Cited-References = {Azcurra D, 2003, PROVINCIA RIOJA REPU, P815.
   Marquetti C, 2004, S ASTER GEOSAT, P1.
   Ninomiya Y, 2005, REMOTE SENS ENVIRON, V99, P127, DOI 10.1016/j.rse.2005.06.009.
   Rodriguez R, 2011, GEOLOGIA CUADRANGULO, P164.
   Tommaso I, 2005, MAPEO ALTERACION HID, P1765.},
Number-of-Cited-References = {5},
Times-Cited = {0},
Unique-ID = {WOS:001669853200103},
}

@article{ WOS:000297349000005,
Author = {Rajendran, Sankaran and Hersi, Osman Salad and Al-Harthy, Abdulrahman
   and Al-Wardi, Mohammed and El-Ghali, Mohamed Ali and Al-Abri, Amani
   Humaid},
Title = {Capability of advanced spaceborne thermal emission and reflection
   radiometer (ASTER) on discrimination of carbonates and associated rocks
   and mineral identification of eastern mountain region (Saih Hatat
   window) of Sultanate of Oman},
Journal = {CARBONATES AND EVAPORITES},
Year = {2011},
Volume = {26},
Number = {4},
Pages = {351-364},
Month = {DEC},
Abstract = {The present study demonstrates the capability of multi-spectral data
   acquired from advanced spaceborne thermal emission and reflection
   radiometer (ASTER) satellite to explore the areas of massive carbonate
   deposits and associated rock formations for geological application. The
   extent of interdependence among VNIR, SWIR and TIR bands of ASTER
   spectral regions has been studied for discrimination of rock formations
   and identification of minerals of eastern mountain region (Saih Hatat
   window) of Sultanate of Oman and processed through digital image
   analysis and classification. Visual interpretation techniques have been
   employed to discriminate major quartz-rich silicates, carbonates and
   mafic ophiolite rock formations on the satellite image by carrying out
   subsequent image enhancement technique and principal component analysis
   (PCA). Color composite using nine VNIR and SWIR ASTER spectral bands by
   exposing the results of band ratios of (band 7 + band 9)/band 8 for
   limestone (CaCO3); (band 6 + band 8)/band 7 for dolomite (CaMgCO3); and
   band 2/band 1 for mafic-rich (Fe3+) rock formations differentiated the
   carbonates and ophiolite formations of the study region. The band ratios
   of 6/8 developed for quartz-rich silicates (shale, schist, sandstone,
   graywackes) of autochthonous Unit `A' of Late Proterozoic to Early
   Ordovician and Tertiary age, 9/7 for the carbonates (limestone and
   dolomite) of Autochthonous rock Unit `B' of Late Permian to Triassic age
   and 1/2 for mafic ophiolites (harzburgite, harzburgite with dunite) of
   Samail Nappe discriminated the different rock formations and increased
   the visual interpretations. It has well delineated the gray limestone
   and yellow dolomite of Autochthonous Unit `A'. The subsequent PCA
   realized on the 6 SWIR spectral bands enables very good validation and
   discrimination of quartz-rich silicates, carbonates and mafic ophiolite
   rock formations defined on previous image rationing techniques and
   existing geological map, and provides information comparable to
   surficial formations previously not well recognized. It is capable of
   distinguishing the ancient and recent alluvial fans consisting of clay,
   silt, sand and conglomerate formations of Tertiary age from the
   Autochthonous Unit `A'. Furthermore, the ASTER TIR spectral indices have
   been applied for assessing the effectiveness of TIR spectral bands on
   identification of quartz-rich silicates, carbonates and mafic-rich
   minerals and to evaluate the discriminated rock formations. The results
   agree well with existing geological maps and other published data. The
   study results show that the combination of visual interpretation,
   previous field knowledge and digital image processing techniques applied
   on the ASTER spectral regions have proved beneficial in studying
   carbonates and associated rock formations of eastern mountain region of
   Sultanate of Oman and can thus be used as a powerful tool to explore
   massive carbonate deposits or for geological mapping of other
   geographical regions where similar geological questions need to be
   resolved.},
Type = {Article},
DOI = {10.1007/s13146-011-0071-4},
Keywords = {ASTER; Discrimination; Mineral identification; Band ratio; PCA; Spectral
   indices; Silicates; Carbonates; Ophiolites; Saih Hatat window; Eastern
   Oman mountain region},
