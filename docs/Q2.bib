@article{ WOS:000933972300002,
Author = {Gao, Shuai and Peng, Hong and Song, Bing and Zhang, Jinxuan and Wu,
   Weixi and Vaughan, James and Zardo, Peter and Vogrin, John and Tulloch,
   Sylvia and Zhu, Zhonghua},
Title = {Synthesis of zeolites from low-cost feeds and its sustainable
   environmental applications},
Journal = {JOURNAL OF ENVIRONMENTAL CHEMICAL ENGINEERING},
Year = {2023},
Volume = {11},
Number = {1},
Month = {FEB},
Abstract = {Zeolites are one of the most widely used adsorbents, versatile for
   multiple purposes including the emerging areas of carbon capture and
   wastewater treatment. However, the scaling up of zeolite-based
   adsorption is challenged mainly by the high cost required for its
   synthesis. Successfully producing high-performance zeolite adsorbents
   from low-value or even waste raw materials such as mineral, industrial
   and agricultural wastes is alluring in that it will (i) reduce the costs
   for zeolite preparation and high-value applications and (ii) provide a
   value-adding means for managing various wastes. This review is thus
   prepared to (1) overview the state-of-art zeolite synthesis methods
   using low-value resources or waste streams and their corresponding
   methods, (2) understand the performances of various low-value ends
   derived zeolites for gas adsorption with a focus on their CO2 capturing
   capabilities compared to commercial synthetic zeolites, (3) assess the
   capabilities of these zeolites for wastewater treatment applications
   compared to commercial synthetic zeolites, and (4) provide perspectives
   for future studies. The conversion of low-cost feedstock or even wastes
   is plausible to produce valuable zeolites with performances comparable
   to commercial synthetic zeolites, calling for progress in developing
   greener routes for zeolite preparation, addressing the inconsistency of
   raw materials, and techno-economic assessments based on large-scale
   preparation and applications.},
Type = {Article},
DOI = {10.1016/j.jece.2022.108995},
EarlyAccessDate = {NOV 2022},
Article-Number = {108995},
