@article{ WOS:A1997WB74500008,
Author = {Sorokin, VI and Dadze, TP and Kashirtseva, GA},
Title = {Sulfide-sulfate relationships in the hydrothermal process},
Journal = {PETROLOGY},
Year = {1997},
Volume = {5},
Number = {1},
Pages = {57-66},
Month = {JAN-FEB},
Abstract = {Sulfide-sulfate zoning was analyzed using the thermodynamic approach
   within the framework of a local-equilibrium model for the simplified
   Ba-Ca-Fe-Na-Cl-S-H2O system over the temperature range 50-550 degrees C
   and pressures ranging from the water vapor saturation curve to 1000 bar.
   As the results of thermodynamic analysis indicated, the principal factor
   in the origin of a sulfide-sulfate zoning is temperature. The anhydrite
   zone was replaced by the sulfide zone at a temperature below 360 degrees
   C. The mineral indicators for the zonation (anhydrite --> pyrrhotite -->
   pyrite --> barite) form sulfur concentration above the clarke (> 0.1 m)
   and require sulfur addition in the system. A pressure decrease did not
   considerably affect the development of the anhydrite field, but it
   resulted in some decrease of the fields of sulfide phases. The oxygen
   fugacity in the system ranged from the QMF to NNO buffers. As
   temperature decreased below 350 degrees C, the system tended to evolve
   from the NNO to QMF buffer.},
Type = {Article; Proceedings Paper},
Research-Areas = {Geochemistry \& Geophysics; Mineralogy},
