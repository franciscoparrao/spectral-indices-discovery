@incollection{ WOS:000519270605209,
Author = {Pour, Amin Beiranvand and Park, Tae-Yoon S. and Park, Yongcheol and
   Hong, Jong Kuk and Pradhan, Biswajeet},
Book-Group-Author = {IEEE},
Title = {Fusion of DPCA and ICA algorithms for mineral detection using Landsat-8
   spectral bands},
Booktitle = {2019 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING SYMPOSIUM (IGARSS
   2019)},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2019},
Pages = {6067-6070},
Abstract = {Fusion of Directed Principal Component Analysis (DPCA) and Independent
   Component Analysis (ICA) algorithms was applied to some selected
   Landsat-8 mineral indices for mapping gossan and clay-rich zones for
   Zn-Pb exploration in the Franklinian Basin of North Greenland. This
   region contains a unique potential for exploration of world-class zinc
   deposits. Numerous potential zones for Zn-Pb deposits were identified
   using the fusion technique of DPCA/ICA. Their identification was based
   on detecting alteration mineral patterns consist of ferric iron, ferrous
   iron and clay minerals within a background of sedimentary rocks using
   Landsat-8 spectral bands. Several zones of gossan and clay mineral
   assemblages were identified in the trough sequences of the Citronen
   Fjord, Peary Land that may represent potential undiscovered CD Zn-Pb
   deposits and warrant further investigation. This investigation indicates
   that satellite remote sensing mapping techniques can aid in identifying
   unknown/undiscovered Zn-Pb sulfide deposits in the High Arctic
   Franklinian Basin by targeting the location of alteration zones that are
   feasible location for mineral occurrences.},
