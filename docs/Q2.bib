@article{ WOS:000823014100003,
Author = {Avila-Barrientos, Lenin and Yegres-Herrera, Luis A. and Flores-Estrella,
   Hortencia and Gonzalez-Fernandez, Antonio},
Title = {Estimation of shallow VP and
   VS models in La Reforma Caldera, Baja California Sur,
   Mexico, using H/V ratios. Preliminary results},
Journal = {JOURNAL OF APPLIED GEOPHYSICS},
Year = {2022},
Volume = {204},
Month = {SEP},
Abstract = {We evaluate the subsoil conditions at La Reforma caldera, located inside
   the Tres Virgenes Volcanic Complex in Baja California Sur, Mexico, using
   the Horizontal to Vertical Spectral Ratios (HVSR) method. The spatial
   distribution of the dominant frequencies has a complex pattern, which
   could be related to the heterogeneities of the zone. There is a good
   correlation between the inverted velocity models and the caldera
   lithology proposed in early studies. Our results show significant
   contrast between V-P and V-S, resulting in high V-P/V-S ratios. These
   high V-P/V-S ratios suggest a water-saturated material and define a
   possible water central pathway in La Reforma caldera. The V-P/V-S values
   obtained for La Reforma caldera are different from those found in the
   rest of the Tres Virgenes volcanic complex.},
Type = {Article},
DOI = {10.1016/j.jappgeo.2022.104736},
