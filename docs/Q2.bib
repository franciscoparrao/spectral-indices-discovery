Title = {Geology and genesis of EI-Dob tungsten ore deposit (North Eastern
   Desert, Egypt): Insights from fieldwork, petrography and remote sensing},
Booktitle = {MINERAL RESOURCES TO DISCOVER, VOLS 1-4},
Year = {2017},
Pages = {1527-1530},
Abstract = {EI-Dob ore deposit is one of twelve tin-tungsten mineral occurrences
   located in the Egyptian basement complex. Detailed fieldwork,
   petrography and remote sensing investigations were performed to map the
   area and to shed light on the genesis of the tungsten mineralization.
   The area is covered by syn-orogenic granodiorite, intruded by gabbro and
   late- to post-orogenic monzogranite and alkali-feldspar granite. The
   mineralization occurs as wolframite-bearing quartz veins, associated
   with greisen alteration zones, cutting through the granodiorite and
   monzogranite. The wolframite occurs as large, prismatic cm-size
   crystals, which are often concentrated and radially oriented in large
   nodules with up to 20 cm radius. Various image enhancement techniques,
   such as band combinations, band ratios, principle component analysis and
   minimum noise fraction, have been applied on ASTER and ETM+ datasets to
   perform detailed lithological and hydrothermal alteration mapping on the
   area. The mineralization is hosted by two alteration zones, which are
   spatially associated with the alkali-feldspar granite. Likely, during
   the post-orogenic extensions and magmatism, a magmatic-hydrothermal
   fluid was released, along with the incompatible tungsten, from the
   differentiating granitic melt phase. Intense interaction between this
   fluid and the surrounding granodiorite and monzogranite developed the
   greisen hydrothermal alteration zones and facilitated fluid cooling and
   the W mineralization.},
Type = {Proceedings Paper},
Keywords-Plus = {ASTER},
Research-Areas = {Geology; Mineralogy},
Cited-References = {Hassan M.A., 1990, GEOLOGY EGYPT, P201, DOI 10.1201/9780203736678-12.
   Hulsbosch N, 2016, GEOCHIM COSMOCHIM AC, V175, P299, DOI 10.1016/j.gca.2015.11.020.
   Rajendran S, 2013, ORE GEOL REV, V53, P470, DOI 10.1016/j.oregeorev.2013.02.008.
   Rowan LC, 2003, ECON GEOL BULL SOC, V98, P1019, DOI 10.2113/98.5.1019.
   Stern RJ, 2004, DEV PREC G, V13, P95.
   STERN RJ, 1994, ANNU REV EARTH PL SC, V22, P319, DOI 10.1146/annurev.ea.22.050194.001535.
   Takla MA, 1976, B FS CAIRO U CAIRO E, V49, P415.},
Number-of-Cited-References = {7},
Times-Cited = {0},
Unique-ID = {WOS:000439764100378},
}

@incollection{ WOS:001669853200110,
Author = {Sorrentino, Anna and Tavani, Stefano and Casarotto, Bruno and Massironi,
   Matteo and Corrado, Francesca and Carminati, Eugenio and Marchesini,
   Barbara and Mondillo, Nicola},
Editor = {Anderson, E and Graham, G},
Title = {Proximal hyperspectral sensing of mineralized outcrops in open pit
   mines: the Allumiere-Tolfa epithermal system (Central Italy) case study},
Booktitle = {18TH SGA BIENNIAL MEETING, 2025, VOL 3},
Year = {2025},
Pages = {1239-1242},
Abstract = {The present study aims to investigate lithocaps associated with the
   Plio-Pleistocene epithermal system of the Allumiere-Tolfa district,
   located north of Rome (Central Italy), through multi-scale hyperspectral
   sensing. In the study area, post-volcanic hydrothermal activity led to a
   widespread, structurally-controlled alteration, spanning from residual
   silicate advanced argillic to intermediate argillic zones, overprinted
   by supergene alteration.
   Hyperspectral scenes were acquired at the Allumiere open pit
   alunite-kaolinite mine and Tolfa kaolinite mine. The images were scanned
   using tripod-mounted Headwall Photonics cameras, capturing reflectance
   data across the Visible-Near-Infrared (VNIR) to Shortwave-Infrared range
   (SWIR), between 400 and 2500 nm, and validated through laboratory
   imaging spectroscopy on twenty-four ground samples. The identification
   and characterization of optically active hydrothermal and supergene
   alteration minerals was carried out using polynomial fitting and band
   ratios. The absorption features of Fe-oxy-hydroxides (i.e., hematite and
   goethite), di- and tri-octahedral phyllosilicates, and sulfates (e.g.,
   smectites, kaolin-group, and alunite-group minerals) were mapped. The
   adopted method allowed the discrimination of kaolinite and dickite
   polytypes, and the investigation of alunite chemical composition (Na/K
   ratio). This approach provided significant insights into the geometry of
   the alteration mineral assemblages, providing insight into the spatial
   relationship between the alteration facies and ore-controlling tectonic
   structures.},
Type = {Proceedings Paper},
Research-Areas = {Geochemistry \& Geophysics; Geology; Mineralogy},
Cited-References = {Cudahy T, 2008, P2007364 COMM SCI IN.
