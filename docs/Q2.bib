@article{ WOS:001385938400012,
Author = {Guzel, Firdevs and Sarp, Gulcan},
Title = {Evaluation of the tectonic activity of faults with mineral alterations:
   a case of the East Anatolian Fault-Palu segment, Türkiye},
Journal = {BULLETIN OF THE MINERAL RESEARCH AND EXPLORATION},
Year = {2024},
Volume = {175},
Abstract = {Palu segment is a part of the East Anatolian Fault Zone (EAFZ), the most
   important active left-lateral strike-slip fault system in Turkey, and
   there are different mineral alterations in this zone. The study tested
   the spatial relationship between tectonic activity and mineral
   alterations with the Getis-Ord Gi{*} statistic in and around the Palu
   segment. Mineral alterations at the pixel level were determined Energy
   Minimization (CEM), Mixed Tuned Matched Filter (MTMF) methods. According
   to the results, the spatial distribution of alteration minerals extend
   parallel to tectonically active fault lines and/or partially bounded by
   faults in the area. RBD, Mineral Indices, CROSTA, CEM, and MTMF image
   processing algorithms applied in the study gave consistent results in
   the spatial determination and mapping of mineral alterations. At 99\%
   and 95\% confidence intervals, statistically significant cold spot
   clusters indicate the proximity of alterations to faults concentrated
   around fault lines. This degree of clustering of mineral alterations
   indicates regions with high alteration rates close to fault lines and
   areas with tectonic activity along fault lines.},
Type = {Article},
DOI = {10.19111/bulletinofmre.1518855},
