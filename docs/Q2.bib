@article{ WOS:000379283700014,
Author = {Mansouri, Edris and Feizi, Faranak},
Title = {INTRODUCING Au POTENTIAL AREAS, USING REMOTE SENSING AND GEOCHEMICAL
   DATA PROCESSING USING FRACTAL METHODS IN CHARTAGH, WESTERN AZERBIJAN -
   IRAN},
Journal = {ARCHIVES OF MINING SCIENCES},
Year = {2016},
Volume = {61},
Number = {2},
Pages = {397-414},
Abstract = {The studied area - Chartagh - is located in the East of Azerbaijan
   gharbi Province, Iran. In this paper, geology map, ASTER satellite
   images were used and after processing these images with ENVI softwares,
   geochemical data analysis consisting of lithogeochemical samples, within
   geological field observations. On ASTER data; using a number of selected
   methods including band ratio, Minimum Noise Fraction (MNF) and Spectral
   Angle Maper (SAM) distinguished alternation zones. Geochemical anomalies
   were separated by number - size (N-S) fractal method. (N-S) fractal
   method was utilized for High intensive Au, As and Ag anomalies.},
Type = {Article},
DOI = {10.1515/amsc-2016-0029},
Keywords = {Alteration zones; ASTER; Geochemical data; Chartagh; Iran},
Keywords-Plus = {MINERALIZED ZONES; THERMAL EMISSION; YUNNAN-PROVINCE; ANOMALIES;
   SEPARATION; DEPOSIT; MODELS; CU},
