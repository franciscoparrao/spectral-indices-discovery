@article{ WOS:001275919700005,
Author = {Jha, Prakash and Das, Pranab and Ray, Dwijesh},
Title = {Bleaching of Dhandraul sandstone and spectral characterization of
   Dhandraul (Vindhyan) iron oxide concretions},
Journal = {JOURNAL OF INDIAN GEOPHYSICAL UNION},
Year = {2024},
Volume = {28},
Number = {1},
Month = {JAN},
Abstract = {Picturesque and amazing, regional red color variations are present in
   the Dhandraul sandstone, Vindhyan Supergroup. It suggests fluid based
   alteration of Dhandraul sandstone on a regional scale. Landsat 7 ETM+
   images spectral enhancement i.e., band ratio operation indicates
   bleaching of Dhandraul sandstone on large scale. The spatial extent of
   bleaching of red sandstone indicates a large paleo-reservoir of
   hydrocarbons in the Dhandraul sandstone. The absence of any potential
   cap rock for capturing hydrocarbon, may have led to the stored
   hydrocarbon getting escaped into the atmosphere during uplift and
   erosion of rock in geological past. The moving Fe bearing
   hydrocarbon-rich reducing fluid mixes and interacts with oxidizing fluid
   that result in precipitation of iron oxide cementations in the pore
   spaces of the sediment. Repetitive precipitation results in formation of
   iron oxide concretions. The FTIR spectroscopy of iron oxide concretions
   confirm presence of quartz (778, 796.67, 799.56, 1099 and 1167 cm(-1) ),
   hematite (452.3, 529.3, 530.1, 526.6, 781, 799.56, 912.44 cm(-1) ) and
   goethite (452.3 and 649 cm(-1) ) in the Dhandraul iron oxide
   concretions. The Raman peaks for quartz are observed at 128, 129, 131,
   204, 265, 357, 407, 408, 409, 410, 462, 465, 466 cm(-1) , for the
   hematite 222, 223, 224, 227, 287, 291, 296, 485, 494 601, 609, 610, 612,
   656, 666, 1306, 1307, 1319, 1322, 1321 cm(-1) and for the goethite at
   166, 246 and 400 cm-1 in the concretions. Electron microprobe study of
   concretions show that concentration of FeO T in hematite varies from
   81.57 to 85.47 wt\% and in goethite from 60.66 to 70.12 wt\%.
   Backscatter Electron (BSE) images of the iron oxide concretions indicate
   concentric bands of concretions are iron enriched whereas, the
   concretion core is comparatively iron depleted. These terrestrial iron
   oxide concretions have striking similarities with hematite spherules
   present in the Burns Formation, Meridiani Planum, Mars.},
Type = {Article},
Keywords = {Dhandraul sandstone; Diagenetic concretions; Landsat 7 ETM+ images
   spectral enhancement; FTIR spectroscopy; Raman spectroscopy; Martian
   hematite spherules},
Keywords-Plus = {MERIDIANI-PLANUM; BURNS FORMATION; HEMATITIC CONCRETIONS; DIAGENETIC
