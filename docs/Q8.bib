@article{ WOS:000395761900003,
Author = {Plenge, Megan F. and Engel, Annette S. and Omelon, Christopher R. and
   Bennett, Philip C.},
Title = {Thermophilic Archaeal Diversity and Methanogenesis from El Tatio Geyser
   Field, Chile},
Journal = {GEOMICROBIOLOGY JOURNAL},
Year = {2017},
Volume = {34},
Number = {3},
Pages = {220-230},
Abstract = {The hydrothermal fluid chemistry at El Tatio Geyser Field (ETGF) in
   northern Chile suggests that biogenic CO2-CH4 cycling may play an
   important role in water chemistry, and relatively low sulfate (0.6-1mM)
   and high molecular hydrogen (H-2) concentrations (67-363nM) suggest that
   methanogenic Archaea are present in ETGF microbial mats. In this study,
   C-13 analysis of dissolved inorganic carbon and methane was not
   indicative of biogenic methane production (C-13(CH4) values ranging from
   -15 parts per thousand to -5.3 parts per thousand); however,
   methanogenic Archaea were successfully cultured from each of the
   hydrothermal sites sampled. Sanger sequencing using universal Archaea
   primers identified putative methanogenic orders with varying metabolic
   capabilities, including Methanobacteriales, Methanomicrobiales and
   Methanosarcinales.},
Type = {Article},
DOI = {10.1080/01490451.2016.1168496},
