@article{ WOS:000745678300001,
Author = {Marin-Camacho, Pedro and Velasco-Tapia, Fernando and Bernard-Romero,
   Ruben and Weber, Bodo and Gonzalez-Guzman, Renee},
Title = {New geochemical evidence constraining the water-rock-gas interaction on
   geothermal fluids of the Queretaro Graben, northern Trans-Mexican
   Volcanic Belt},
Journal = {JOURNAL OF SOUTH AMERICAN EARTH SCIENCES},
Year = {2022},
Volume = {114},
Month = {MAR},
Abstract = {This study examines the water-rock-gas interaction of the Los Geysers
   geothermal system in the northern TransMexican Volcanic Belt (TMVB).
   Physico-chemical parameters, delta C-13 of total dissolved inorganic
   carbon (TDIC), and Rare Earth Elements (REE) composition on 14 thermal
   water discharges are reported and discussed. Waters had temperatures
   ranging from 40 degrees C to 98 degrees C, pH from 7.4 to 9.2, and total
   dissolved solids from 598 mg L-1 to 992 mg L-1. Signals of thermophilic
   biota, mainly diatom frustules, were found in the suspended particulate
   matter of spring waters. The range of delta C-13(TDIC) was between -7.55
   parts per thousand and -4.13 parts per thousand (avg. -7.10 parts per
   thousand). Although potentially affected by secondary processes, the
   dissolved C species of the studied waters likely have a predominant
   deep, mantle-related component. The lanthanoids concentrations (Sigma
   REE) were variable over practically one order of magnitude, with average
   values between 1463 pmol L-1 for Ce and 9 pmol L-1 for Lu. PostArchean
   Australian Shale (PAAS)-normalized patterns showed a slight enrichment
   in middle lanthanides, numerically expressed as {[}Sm/La] N and
   {[}Sm/Yb]N, ranging from 1.43 to 2.06 and 0.84 to 2.03, respectively. We
   propose that the overall signature of the REE is inherited during the
   regional migration of the liquid and from the primary aquifer. Moreover,
   PHREEQC computer code was run to calculate the dominant REE complexing
   ligands in the geothermal system at different temperatures. Our
   calculations indicate that F- complexes dominate over CO3 species at
   outlet temperatures, but oxyhydroxide complexes (REE-O2H, REE-O-2(-),
   and REE-O.) act as sinks after leaching from the source rock. The
   Nd-143/Nd-144 ratio of one of the studied samples was measured (0.512320
   +/- 0.000019; epsilon Nd = 6.20 +/- 0.37, 2s.e.). The conceptual model
   in this paper highlights a mixing waters process between geothermal
   waters and cold shallow waters in the Queretaro Graben.},
