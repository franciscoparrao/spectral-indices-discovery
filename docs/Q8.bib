@incollection{ WOS:000172263500247,
Author = {Dadea, C and Fanfani, L and Keegan, TJ and Farago, M and Thornton, I},
Editor = {Cidu, R},
Title = {Sequential extraction in stream sediments from the Loa basin (Northern
   Chile)},
Booktitle = {WATER-ROCK INTERACTION, VOLS 1 AND 2},
Year = {2001},
Pages = {1055-1058},
Abstract = {Sediments from the Rio Loa have arsenic concentration in the range
   400-11300 mg/kg. In order to evaluate the environmental contamination in
   the Loa basin a five-step sequential extraction procedure was applied to
   12 stream sediment samples. This method gives a good estimation of metal
   bioavailability, which is an indicator of the real environmental risk.
   Arsenic is predominantly bound to Fe-Mn oxy-hydroxides as adsorbed
   species probably removed from the river water. Arsenic that is bound to
   Fe-Mri oxides does not seem to be readily mobile, unless significant
   changes in Eh-pH conditions take place in the environment. The main
   arsenic source is the El Tatio geothermal field. The porphyry-copper
   belt of Chuquicamata is a possible, but unlikely source.},
