@article{ WOS:001160517300001,
Author = {Sosa, Yair Mauad and Molina, Romina Soledad and Spagnotto, Silvana and
   Melchor, Ivan and Manquez, Alejandro Nunez and Crespo, Maria Liz and
   Ramponi, Giovanni and Petrino, Ricardo},
Title = {Seismic Event Detection in the Copahue Volcano Based on Machine
   Learning: Towards an On-the-Edge Implementation},
Journal = {ELECTRONICS},
Year = {2024},
Volume = {13},
Number = {3},
Month = {FEB},
Abstract = {This study focused on seismic event detection in a volcano using machine
   learning by leveraging the advantages of software/hardware co-design for
   a system on a chip (SoC) based on field-programmable gate array (FPGA)
   devices. A case study was conducted on the Copahue Volcano, an active
   stratovolcano located on the border between Argentina and Chile.
   Volcanic seismic event processing and detection were integrated into a
   PYNQ-based implementation by using a low-end SoC-FPGA device. We also
   provide insights into integrating an SoC-FPGA into the acquisition node,
   which can be valuable in scenarios where stations are deployed solely
   for data collection and holds the potential for the development of an
   early alert system.},
Type = {Article},
DOI = {10.3390/electronics13030622},
