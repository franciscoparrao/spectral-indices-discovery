@article{ WOS:000445984300003,
Author = {Munoz-Saez, Carolina and Manga, Michael and Hurwitz, Shaul},
Title = {Hydrothermal discharge from the El Tatio basin, Atacama, Chile},
Journal = {JOURNAL OF VOLCANOLOGY AND GEOTHERMAL RESEARCH},
Year = {2018},
Volume = {361},
Pages = {25-35},
Month = {JUL 15},
Abstract = {El Tatio in northern Chile is one of the best-studied geothermal fields
   in South America. However, there remain open questions about the mass
   and energy budgets, water recharge rates and residence time in the
   subsurface, origin of dissolved solutes, and processes affecting the
   phase and chemical composition of groundwater and surface water. We
   measured and sampled surface manifestations of the geothermal system
   (geysers, perpetual spouters, mud pools/volcanoes, and non-eruptive hot
   springs) and meteoric water. From the isotopic composition we infer that
   the thermal water has a meteoric origin that is different from the
   composition of local meteoric water. The absence of detectable tritium
   in thermal waters indicates that most of the recharge occurred pre-1950.
   Boiling and steam separation from the deep reservoir appear to be the
   main subsurface processes affecting the thermal fluids. A large amount
   of heat is lost to the atmosphere by evaporation from surface water and
   by steam emitted from erupting geysers. Using the chloride inventory
   method, we estimate thermal water discharge to be 218 to 234 L/s, and
   the advective heat flow to be 120 to 170 MW. (C) 2018 Elsevier B.V. All
   rights reserved.},
Type = {Article},
DOI = {10.1016/j.jvolgeores.2018.07.007},
Keywords = {Geothermal; Hydrogeology; Stable isotopes; Chloride inventory; Phase
   separation; Geyser},
