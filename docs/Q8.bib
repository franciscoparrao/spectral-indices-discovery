@incollection{ WOS:001070410603057,
Author = {Letelier, Juvenal A.},
Editor = {Ortega-Sanchez, M},
Title = {Reservoir Architecture of El Tatio-La Torta Geothermal Field in Northern
   Chile: Groundwater Management in Geothermal Field Operations and Its
   Impact on Natural Geysers},
Booktitle = {PROCEEDINGS OF THE 39TH IAHR WORLD CONGRESS},
Year = {2022},
Pages = {3077-3085},
Abstract = {In this work, I present a new conceptual model for the reservoir
   architecture of the El Tatio-La Torta geothermal system in northern
   Chile. From the recent structural model for the chilean altiplano, a
   complex and large reservoir system below El Tatio and La Torta is
   proposed, which is composed of a three -level reservoir system at
   different temperatures, connected by the intersection of NW-striking
   left-lateral and N -striking thrust faults. Also, a physical explanation
   of the mechanisms controlling the upflow below La Torta is presented,
   mentioning the possible location of the main catchment area and an
   explanation for the apparent hydraulic disconnection at El Tatio
   observed by pressure interference tests, which is coherent with the
   proposed structural setting for the geothermal field. This model offers
   an up-to-date representation of fluid circulation and heat transfer
   modes at different scales for this geothermal system in the Central
   Andes, illustrating potential problems related to hypothetical
   geothermal operations and groundwater management in the most wonderful
   geothermal field in South America.},
Type = {Proceedings Paper},
DOI = {10.3850/IAHR-39WC2521716X20221157},
Keywords = {Far-to-near field scale model; Reservoir system; Rayleigh-Darcy
