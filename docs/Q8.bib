@incollection{ WOS:000172263500265,
Author = {Romero, L and Alonso, H and Espinoza, S and Campano, P and Fanfani, L
   and Cidu, R and Lorrai, M and Lopez, L and Ferreyra, RE},
Editor = {Cidu, R},
Title = {Arsenic and boron contamination in the Loa basin (northern Chile)},
Booktitle = {WATER-ROCK INTERACTION, VOLS 1 AND 2},
Year = {2001},
Pages = {1127-1130},
Abstract = {In order to evaluate the environmental situation of the Loa basin, water
   samples were taken at strategic points along the river and its major
   tributaries. The water in the whole basin is quite saline and heavily
   contaminated by arsenic and boron, with values up to 300 and 80 times
   higher than the respective guidelines suggested by the WHO for drinking
   water. This contamination is more marked along the tributary Salado,
   which originates from the geothermal field of El Tatio, and in the
   medium and lower course, where the contamination derived from the Salado
   is increased by interaction with sedimentary rocks, contaminated
   sediments, lack of dilution, and strong evaporation.},
Type = {Proceedings Paper},
Research-Areas = {Geochemistry \& Geophysics; Environmental Sciences \& Ecology; Geology;
   Water Resources},
