@article{ WOS:000364894400024,
Author = {Chiodini, Giovanni and Cardellini, Carlo and Lamberti, Maria Clara and
   Agusto, Mariano and Caselli, Alberto and Liccioli, Caterina and
   Tamburello, Giancarlo and Tassi, Franco and Vaselli, Orlando and Caliro,
   Stefano},
Title = {Carbon dioxide diffuse emission and thermal energy release from
   hydrothermal systems at Copahue-Caviahue Volcanic Complex (Argentina)},
Journal = {JOURNAL OF VOLCANOLOGY AND GEOTHERMAL RESEARCH},
Year = {2015},
Volume = {304},
Pages = {294-303},
Month = {OCT 1},
Abstract = {The north-western sector of Caviahue caldera (Argentina), close to the
   active volcanic system of Copahue, is characterized by the presence of
   several hydrothermal sites that host numerous fumarolic emissions,
   anomalous soil diffuse degassing of CO2 and hot soils. In March 2014,
   measurements of soil CO2 fluxes in 5 of these sites (namely, Las
   Maquinas, Las Maquinitas I, Las Maquinitas II, Anflteatro, and Termas de
   Copahue) allowed an estimation that similar to 165 t of deeply derived
   CO2 is daily released. The gas source is likely related to a relatively
   shallow geothermal reservoir containing a single vapor phase as also
   suggested by both the geochemical data from the 3 deep wells drilled in
   the 1980s and gas geoindicators applied to the fumarolic discharges. Gas
   equilibria within the H-C-O gas system indicate the presence of a large,
   probably unique, single phase vapor zone at 200-210 degrees C feeding
   the hydrothermal manifestations of Las Maquinas, Las Maquinitas land II
   and Termas de Copahue. A natural thermal release of 107 MW was computed
   by using CO2 as a tracer of the original vapor phase. The magmatic
   signature of the incondensable fumarolic gases, the wide expanse of the
   hydrothermal areas and the remarkable high amount of gas and heat
   released by fluid expulsion seem to be compatible with an active
   magmatic intrusion beneath this portion of the Caviahue caldera. (C)
