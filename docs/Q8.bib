@incollection{ WOS:001234906200052,
Author = {Lohmeier, Stephanie and Lehmann, Bernd and Hodgkin, Andrew and
   Schneider, Albrecht},
Editor = {Christie, AB},
Title = {Banded quartz veinlets: evidence of silica precursors at the Cerro
   Maricunga/Fenix gold deposit, Maricunga belt, northern Chile},
Booktitle = {16TH SGA BIENNIAL MEETING, 2022, VOL 1},
Year = {2022},
Pages = {204-207},
Abstract = {Banded quartz veinlets are the characteristic feature in transitional
   porphyry-epithermal deposits of the Maricunga belt in northern Chile,
   where they are the main gold carrier. They are composed of quartz
   recrystallized from a silica gel precursor reflected by botryoidal and
   elongated quartz crystals in both light and dark bands. Vapor-only fluid
   inclusions and nanoscale magnetite crystals are arranged in feathery,
   flamboyant, ghost-sphere, and moss-like boiling textures, all indicative
   of recrystallization. The abundance of vapor-only fluid inclusions
   points to vigorous conditions during veinlet formation with repetitive
   flashing, and precipitation of dense silica gel due to supersaturation,
   followed by coagulation, dehydration and recrystallization.},
Type = {Proceedings Paper},
Keywords-Plus = {SLEEPER DEPOSIT; COPPER-DEPOSIT; SYSTEMS; TEXTURES; GEOLOGY},
Research-Areas = {Geology; Mineralogy; Mining \& Mineral Processing},
