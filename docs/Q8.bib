@article{ WOS:000258589100018,
Author = {Garcia-Valles, M. and Fernandez-Turiel, J. L. and Gimeno-Torrente, D.
   and Saavedra-Alonso, J. and Martinez-Manent, S.},
Title = {Mineralogical characterization of silica sinters from the El Tatio
   geothermal field, Chile},
Journal = {AMERICAN MINERALOGIST},
Year = {2008},
Volume = {93},
Number = {8-9},
Pages = {1373-1383},
Month = {AUG-SEP},
Abstract = {Silica sinters, deposited from alkali chloride waters in the El Tatio
   ggeothermal field in northern Chile (22 degrees 20'S, 68 degrees 01'W),
   have been characterized by XRD, SEM, TG-DTA, and FTIR. The dominant
   silica phase is opal-A. Minor contents of opal-A/-CT and opal-CT are
   also present together with halite (NaCl), sylvite (KCl), and
   realgar(AsS). Accessory phases include teruggite
   {[}Ca4MgAs2B12O22(OH)(12)center dot 12(H2O)], sassolite (H3BO3) and
   detrital quartz (SiO2). FWHM values reflect the immature nature of the
   Studied opal-A. DTA heating experiments of opal-A show cristobalite
   crystallization at similar to 1000 degrees C, whereas DTA cooling
   experiments show the beta -> alpha-cristobalite transformation at
   similar to 200 degrees C. The total weight loss is related to changes in
   the sinter microtextures, mineral phases, and organic matter contents.
   FTIR spectra show the effects of silica maturation as consequence of the
   loss of trapped and absorbed water attached to silanols.},
