@incollection{ WOS:001669851400012,
Author = {Castellote, Leticia Gonzalez and Holley, Elizabeth},
Editor = {Anderson, E and Graham, G},
Title = {Alunite characterization of high sulfidation epithermal deposits in the
   Vicuna District, Argentina-Chile},
Booktitle = {18TH SGA BIENNIAL MEETING, 2025, VOL 2},
Year = {2025},
Pages = {389-392},
Abstract = {The Vicuna District is located along the Argentina-Chile international
   border, within the metallogenic belt of the same name, connecting the
   Maricunga belt in the north and El Indio belt in the south. This study
   focuses on the Filo del Sol (FDS) and Lunahuasi (LN) Cu-Au-Ag projects,
   hosted in high sulfidation epithermal and porphyry environments. Both
   projects occur along a NNE structural-alteration trend that extends over
   13 km, share similar host-rock and alteration pattern, but differ on
   main mineralization styles. In general, at FDS, chalcocite, covellite,
   enargite, pyrite and, chalcopyrite with Au and Ag mineralization is
   disseminated. Conversely, at LN the mineralization forms massive veins
   with pyrite and enargite plus Au and Ag. Multiple occurrences of alunite
   are documented along the NNE structurally controlled trend. Alunite
   morphology and geochemistry have been attributed to different formation
   environments, including hydrothermal and supergene. At depth some
   alunite is associated with high sulfidation state sulfides, whereas
   other alunite preceded the mineralization. This ongoing study documents
   mineralogical, geochemical and geochronological features of alunite
   occurrences at FDS and LN. These observations provide initial clues to
   understand the relationship between mineralization and alteration
   patterns that later might vector mineral exploration in the district.},
Type = {Proceedings Paper},
Keywords-Plus = {INDIO-PASCUA BELT; GOLD DEPOSIT},
Research-Areas = {Geochemistry \& Geophysics; Geology; Mineralogy},
Cited-References = {Bissig T, 2001, INT GEOL REV, V43, P312, DOI 10.1080/00206810109465016.
   Charchaflié D, 2007, ECON GEOL, V102, P171, DOI 10.2113/gsecongeo.102.2.171.
   Deyell CL, 2005, CHEM GEOL, V215, P185, DOI 10.1016/j.chemgeo.2004.06.038.
   Holley EA, 2016, ECON GEOL, V111, P311, DOI 10.2113/econgeo.111.2.311.
   Sato AM, 2015, J S AM EARTH SCI, V63, P48, DOI 10.1016/j.jsames.2015.07.005.
   Panteleyev A, 2001, Serie Contribuciones Tecnicas, Recursos Minerales, V11.
   Perelló J, 2023, ECON GEOL, V118, P1261, DOI 10.5382/econgeo.5029.
   Sillitoe RH, 2019, ECON GEOL, V114, P407, DOI 10.5382/econgeo.4645.
   VILA T, 1991, ECON GEOL BULL SOC, V86, P1238, DOI 10.2113/gsecongeo.86.6.1238.},
Number-of-Cited-References = {9},
