   Lavalle, Teresa L. and Urbieta, Sofia and Donati, Edgardo R.},
Editor = {Guiliani, N and Demergasso, C and Quatrini, R and Remonsellez, F and DavisBelmar, C and Levican, G and Parada, P and Barahona, C and Zale, R},
Title = {How flexible are the prokaryote consortia in the extreme habitat of the
   Copahue Geothermal system?},
Booktitle = {INTEGRATION OF SCIENTIFIC AND INDUSTRIAL KNOWLEDGE ON BIOHYDROMETALLURGY},
Series = {Advanced Materials Research},
Year = {2013},
Volume = {825},
Pages = {3+},
Abstract = {Microbial consortia taken from an extreme environment were grown at
   different temperatures and enrichment media. The consortia response to
   environmental changes was evaluated in order to investigate their
   metabolic flexibility. The molecular technique, DGGE (denaturing gel
   gradient electrophoresis) was carried out to evaluate the biodiversity.
   The results show that each consortium was able to grow according to the
   available resources, demonstrating their flexibility. A selective
   development was detected when growing conditions were similar to those
   found in the natural environment even though some species were able to
   grown even in conditions far away from those present in the sampling
   sites.},
Type = {Proceedings Paper},
DOI = {10.4028/www.scientific.net/AMR.825.3},
Keywords = {flexibility; acidophiles; thermophiles; bioleaching; diversity indexes;
