@article{ WOS:A1994NT17400006,
Author = {MCKEE, EH and ROBINSON, AC and RYBUTA, JJ and CUITINO, L and MOSCOSO, RD},
Title = {AGE AND SR ISOTOPIC COMPOSITION OF VOLCANIC-ROCKS IN THE MARICUNGA BELT,
   CHILE - IMPLICATIONS FOR MAGMA SOURCES},
Journal = {JOURNAL OF SOUTH AMERICAN EARTH SCIENCES},
Year = {1994},
Volume = {7},
Number = {2},
Pages = {167-177},
Month = {APR},
Abstract = {K-Ar and Ar-40/Ar-39 dating of volcanic rocks from the Maricunga belt of
   north-central Chile indicate that igneous activity took place throughout
   most of Miocene time at various places in the 150 by 30 km belt. No
   migration patterns of volcanism appear in the Miocene rocks of the belt.
   Volcanic activity ceased by the end of the Miocene. All the Miocene
   volcanic rocks studied am calcic andesites to dacites with about 62\%
   SiO2, 18\% Al2O3, 4\% Fe2O3 (total), and 2\% K2O. Initial Sr-87/Sr-86
   (Sr) values fall into two groups, one of lower values around 0.7050 to
   the west and the other of higher values around 0.7060 to the east. It is
   postulated that the two Sr(i) groups reflect two adjoining coherent
   lower-crustal magma sources of possibly different age and subtly
   different composition that form part of the western edge of the South
   American craton.},
Type = {Article},
DOI = {10.1016/0895-9811(94)90006-X},
Research-Areas = {Geology},
Number-of-Cited-References = {0},
Times-Cited = {21},
Unique-ID = {WOS:A1994NT17400006},
}

@article{ WOS:000522452900028,
Author = {Reich, Martin and Roman, Nelson and Barra, Fernando and Morata, Diego},
Title = {Silver-Rich Chalcopyrite from the Active Cerro Pabellon Geothermal
   System, Northern Chile},
Journal = {MINERALS},
Year = {2020},
Volume = {10},
Number = {2},
Month = {FEB},
Abstract = {Active subaerial geothermal systems are regarded as modern analogues of
   low- to intermediate-sulfidation epithermal Au-Ag deposits, where minor
   amounts of Cu are mostly present as chalcopyrite. Although trace element
   data concerning sulfides are scarce in active geothermal systems at
   convergent settings, studies in several other environments have
   demonstrated that chalcopyrite is a relevant host of Ag and other trace
   elements. Here, we focus on the active Cerro Pabellon geothermal system
   in the Altiplano of northern Chile, where chalcopyrite-bearing samples
   were retrieved from a 561 m drill core that crosscuts the high-enthalpy
   geothermal reservoir at depth. A combination of EMPA and LA-ICP-MS data
   shows that chalcopyrite from Cerro Pabellon is silver-rich (Ag > 1000
   ppm) and hosts a wide range of trace elements, most notably Se, Te, Zn,
   Sb, As, and Ni, which can reach 100 s of ppm. Other elements detected
   include Co, Pb, Cr, Ga, Ge, Sn, Cd, and Hg but are often present in low
   concentrations (<100 ppm), whereas Au, Bi, Tl, and In are generally
   below 1 ppm. Chalcopyrite shows a distinct geochemical signature with
   depth, with significantly higher Ag concentrations in the shallow sample
   (494 m) and increasing Cd and In contents towards the bottom of the
   studied drill core (549 m). These differences in the trace element
   contents of chalcopyrite are interpreted as related to temperature
   gradients during the waning stages of boiling at Cerro Pabellon,
   although further studies are still needed to assess the precise
   partitioning controls. Our data provide evidence that chalcopyrite may
   play a relevant role as a scavenger of certain metals and a monitor of
   fluid changes in hydrothermal systems.},
Type = {Article},
DOI = {10.3390/min10020113},
Article-Number = {113},
Keywords = {chalcopyrite; silver; trace elements; geothermal systems; epithermal
   Au-Ag; Cerro Pabellon; Chile},
Keywords-Plus = {MASSIVE-SULFIDE DEPOSIT; TRACE-ELEMENTS; INVISIBLE SILVER;
