@incollection{ WOS:001669851400025,
Author = {Franco, Jose and Bocanegra, Luciano and Paleczek, Piotr and Arribas,
   Antonio},
Editor = {Anderson, E and Graham, G},
Title = {Geology, Mineral Alteration and Mineralization of the Santa Cecilia
   Porphyry Au-Cu Deposit, Maricunga Belt, Northern Chile},
Booktitle = {18TH SGA BIENNIAL MEETING, 2025, VOL 2},
Year = {2025},
Pages = {439-442},
Abstract = {The Santa Cecilia porphyry Au-Cu deposit, located in the Maricunga Belt
   of northern Chile, exhibits a complete porphyry copper system alteration
   column, ranging from deep potassic alteration to shallow advanced
   argillic and silicic assemblages. This study aims to refine ore
   distribution within the alteration zones, primarily in the Cerro del
   Medio sector, while ongoing studies continue in the Pircas and Gemelos
   sectors. Santa Cecilia lies adjacent to the Caspiche deposit (1,091 Mt @
   0.55 g/t Au), separated by a 250-m-wide valley, and formed during the
   latest Oligocene (similar to 25 Ma). The results define four main
   alteration zones at Cerro del Medio starting with potassic
   (biotite-magnetite), chlorite-white mica (chlorite-muscovite-albite),
   white mica (quartz-muscovite-albite), and a lithocap
   (quartz-pyrophyllite, quartz-alunite, vuggy residual quartz).
   Copper-gold mineralization at Cerro del Medio is genetically linked to
   porphyry intrusions and the Quebrada Seca formation, with hydrothermal
   alteration dated around 25 Ma. The system displays a vertically zoned
   alteration pattern typical of porphyry deposits, transitioning from deep
   potassic to shallow advanced argillic assemblages. Three mineralization
   stages are recognized, with the highest copper grades associated with
   early magnetite-chalcopyrite veinlets in the biotitemagnetite zone.
   Geological similarities with the Caspiche deposit suggest a shared
   magmatic origin.},
Type = {Proceedings Paper},
Research-Areas = {Geochemistry \& Geophysics; Geology; Mineralogy},
Cited-References = {Hedenquist JW, 2022, ECON GEOL, V117, P609, DOI 10.5382/econgeo.4880.
   Kay S.M., 1994, International Geology Review, V36, P1079, DOI {[}10.1080/00206819409465506, DOI 10.1080/00206819409465506].
   Lohmeier S, 2022, ECON GEOL, V117, P25, DOI 10.5382/econgeo.4856.
   Mpodozis M, 2018, GEOLOGIA AREA CERRO, Vn200.
   SILLITOE RH, 1991, ECON GEOL BULL SOC, V86, P1261, DOI 10.2113/gsecongeo.86.6.1261.
   Sillitoe RH, 2013, ECON GEOL, V108, P585, DOI 10.2113/econgeo.108.4.585.
   Sillitoe RH, 2010, ECON GEOL, V105, P3, DOI 10.2113/gsecongeo.105.1.3.},
Number-of-Cited-References = {7},
Times-Cited = {0},
