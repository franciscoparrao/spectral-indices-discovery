@article{ WOS:001454929900001,
Author = {Singh, Swati and Martha, Tapas R. and Das, Iswar C. and Sreenivas, K.
   and Chauhan, Prakash},
Title = {Comparison of Airborne and Spaceborne Hyperspectral Data for
   Lithological Discrimination Within the Eastern Dharwar Craton},
Journal = {JOURNAL OF THE INDIAN SOCIETY OF REMOTE SENSING},
Year = {2025},
Volume = {53},
Number = {10},
Pages = {3475-3490},
Month = {OCT},
Abstract = {We analysed three open-source hyperspectral datasets, i.e., spaceborne
   EnMAP, PRISMA, and airborne AVIRIS NG, for lithological mapping in the
   Eastern Dhawar Craton, Karnataka, India. AVIRIS NG offers superior
   spatial and spectral resolution but is limited in geographic coverage,
   necessitating the use of spaceborne sensors. We employed a three-step
   method for comparative analysis based on data quality, dimensionality
   and spectral characteristics. In the data quality analysis, AVIRIS NG
   exhibited a high signal-to-noise ratio (SNR), followed by PRISMA and
   EnMAP, however, PRISMA experiences a higher number of bad bands than
   EnMAP. Dimensionality assessment using Minimum Noise Fraction (MNF)
   indicated that both spaceborne sensors had fewer than 20 MNF bands with
   eigenvalues over 1, while AVIRIS NG had more than 20. Finally, the
   spectral analysis in the range of 400-2400 nm depicts that the EnMAP
   outperformed PRISMA in endmember identification and spectral map
   agreement when compared to AVIRIS NG-derived maps. The absorption
   features of major minerals of the rock units like Mg Hornblende,
   Chlorite and Calcite are identified at 2309 nm, 2280 nm and 2175 nm for
   AVIRIS NG data is closely comparable with USGS spectra. All three
   sensors successfully identified major lithological units, such as
   Amphibolite, Granite, Gneisses and Metabasalts, with AVIRIS NG
   additionally detecting cross-cutting Dolerite dikes. While spaceborne
   sensors have limitations compared to airborne systems, they can
   effectively supplement wider lithological and mineral mapping covering
   large area. The EnMAP performs better in the spectral domain for this
   area, making it suitable supplementary data for mineral explorations.},
Type = {Article},
DOI = {10.1007/s12524-025-02172-5},
EarlyAccessDate = {MAR 2025},
Keywords = {AVIRIS NG; EnMAP; PRISMA; Lithology mapping},
