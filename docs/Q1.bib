Title = {ANALYSIS OF MOST SIGNIFICANT BANDS AND BAND RATIOS FOR DISCRIMINATION OF
   HYDROTHERMAL ALTERATION MINERALS},
Booktitle = {2019 10TH WORKSHOP ON HYPERSPECTRAL IMAGING AND SIGNAL PROCESSING -
   EVOLUTION IN REMOTE SENSING (WHISPERS)},
Series = {Workshop on Hyperspectral Image and Signal Processing},
Year = {2019},
Abstract = {Band ratios are one of the most common features for discrimination and
   identification of minerals using remotely sensed data. The band ratios
   to be used are determined mainly by spectral analysis and trial
   experiments. In the present work, we systematically examine the best
   features and best band ratios using Bhattacharyya distance based optimal
   band analysis. The experiments indicate that the ASTER nine bands and
   band ratios within the wavelength range of 2200 nm to 2300 nm are
   significant for hydrothermal alteration minerals.},
