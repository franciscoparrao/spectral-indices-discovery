@incollection{ WOS:000227006900169,
Author = {Kennedy-Bowdoin, T and Silver, EA and Martini, BA and Pickles, WL},
Book-Group-Author = {ieee},
Title = {Chemical and structural dynamics of a geothermal system - Hyperspectral
   imaging and field observations, Dixie Meadows, Nevada},
Booktitle = {IGARSS 2004: IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING SYMPOSIUM
   PROCEEDINGS, VOLS 1-7: SCIENCE FOR SOCIETY: EXPLORING AND MANAGING A
   CHANGING PLANET},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2004},
Pages = {645-648},
Abstract = {In an ongoing Project to relate surface hydrothermal alteration to
   structurally controlled geothermal aquifers, we mapped a 16 km swath of
   the eastern front of the Stilhvater Range using Hyperspectral fault and
   mineral mapping techniques. The Dixie Valley Fault system produces a
   large fractured aquifer heating Pleistocene aged groundwater to a
   temperature of 285degrees C at 5-6 km. Periodically over the last
   several thousand years, seismic events have facilitated flow of heated
   fluids to the surface, leaving a rich history of hydrothermal alteration
   in the Stillwater Mountains. At Dixie Hot Springs, the potentiometric
   surface of the aquifer intersects the surface, and 75degrees C waters
   flow into the valley. We find a high concentration of alunite,
   kaolinite, and dickite on the exposed fault surface directly adjacent to
   a series of active fumaroles on the range front fault. This assemblage
   of minerals implies interaction with water temperatures in excess of
   200degrees C. Field spectra support the location of the high temperature
   mineralization. Fault mapping using a Digital Elevation Model in
   combination with mineral lineation and Field studies show that complex
   fault interactions in this region are improving permeability in the
   region leading to unconfined fluid flow to the surface. Seismic studies
   conducted 10 km to the south, at Dixie Hot Springs, show that the range
   front fault dips 25-30degrees to the southeast {[}1]. At Dixie Meadows
   the fault dips 35degrees southeast showing that this region is part of
   the low angle normal fault system that produced the Dixie Valley
   Earthquake in 1954 (M=6.8). We conclude that this unusually low angle
   faulting may have been accommodated by the presence of heated fluids
   increasing pore pressure is within the fault zone. We also find that
   younger synthetic faulting is occurring at more typical high angles. In
   an effort to present these findings visually, we created a
   cross-section, illustrating out, interpretation of the subsurface
   structure and the hypothesized locations of increased permeability. The
   success of these methods at Dixie Meadois's will greatly improve our
   understanding of other Basin and Range geothermal systems.},
Type = {Proceedings Paper},
Keywords = {hydrothermal; alteration; minerals; hyperspectral; Dixie Valley; remote
   sensing; geothermal; prospecting; hot springs; Dixie Meadows},
Research-Areas = {Geology; Instruments \& Instrumentation; Remote Sensing; Imaging Science
   \& Photographic Technology},
Cited-References = {Abbott RE, 2001, J GEOPHYS RES-SOL EA, V106, P4169, DOI 10.1029/2000JB900385.
   ABERS GA, 1997, J GEOPHYS RES, V102, P15.
   Anderson E.M., 1942, The Dynamics of Faulting.
