@article{ WOS:001619264400002,
Author = {Lebedeva, Ekaterina V. and Baldina, Elena A. and Anikina, V, Nadezhda
   and Kotenkov, Alexey V.},
Title = {Activity of modern slope processes under conditions of gas-hydrothermal
   manifestations: the Geysernaya and Shumnaya river valleys (Kamchatka,
   Russia) case study},
Journal = {CATENA},
Year = {2026},
Volume = {262},
Month = {JAN},
Abstract = {There is substantial evidence of landslide activity in thermal fields of
   volcanic regions; however, detailed studies on this topic remain scarce.
   This study aimed to assess the contribution of the hydrothermal
   component to the activation of slope processes. We compared slope
   process activity on the sides of two river valleys under similar natural
   conditions: the Geysernaya River valley, affected by gas-hydrothermal
   manifestations, and the Shumnaya River valley, lacking such influence.
   ArcticDEM data, geological maps, thermal survey results, and field
   observations were used to compare valley fragments. High spatial
   resolution satellite images from the mid-1960s and from 2016 to 2022
   were analysed to identify patches of slope process development in both
   valleys. Image interpretation, calculation of morphometric
   characteristics, and bare patch area measurements were conducted using
   the ArcGIS software package. Quantitative assessments of slope
   conditions and their changes within selected morphometrically
   substantiated fragments of both valleys were obtained for two time
   slices separated by approximately six decades. The results were
   validated by aerial visual observations, UAV and field surveys. The
   analysis revealed that the total area of active slope patches in
   gas-hydrothermal zones significantly exceeded that in comparable
   segments without hydrothermal activity under similar natural conditions.
   In the Shumnaya River valley, the proportion of patches with active
   slope processes did not change significantly over the 57-year period,
   whereas in the areas exposed to gas-hydrothermal influence in the
   Geysernaya River valley it increased by 10-17 \%. These findings
   indicate that gas-hydrothermal manifestations are an important driver of
   ongoing geomorphological processes on valley slopes in the studied
   volcanic region.},
Type = {Article},
DOI = {10.1016/j.catena.2025.109606},
EarlyAccessDate = {NOV 2025},
Article-Number = {109606},
Keywords = {Landslides; Thermal manifestations; Morphometric analysis; Image
   interpretation; Hydrothermal alteration; Valley enlargement},
Keywords-Plus = {KRONOTSKY NATURE-RESERVE; CATASTROPHIC LANDSLIDES; EVENTS},
Research-Areas = {Geology; Agriculture; Water Resources},
