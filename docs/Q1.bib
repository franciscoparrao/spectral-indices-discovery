@incollection{ WOS:000282993400210,
Author = {Laukamp, Carsten and Cudahy, Tom and Cleverley, James and Oliver, Nick},
Editor = {Williams, PJ},
Title = {Alteration Zoning of Igneous Complexes in the Eastern Fold Belt of the
   Mount Isa Inlier/Australia},
Booktitle = {SMART SCIENCE FOR EXPLORATION AND MINING, VOL 1 AND 2},
Year = {2010},
Pages = {638-640},
Abstract = {Hyperspectral remote sensing data from the Eastern Fold Belt (Mount Isa
   Inlier, Australia) were compared with petrographic and geochemical
   studies to map spatial extension and compositional variations of
   Proterozoic granitoids as well as hydrothermal alteration patterns in
   surrounding metasedimentary rocks. Detailed spatial analysis of the
   spectral data shows an almost circular alteration zoning in the Mallee
   Gap Granite, which was emplaced during a late phase of the
   Mesoproterozoic Williams event. A combination of hyperspectral images,
   such as white mica, kaolin and MgOH products, can be used to map the
   alteration zoning. The formation of the endoskam is presumably related
   to autometasomatic alteration during a late phase of the emplacement.
   The intrusion of the Mallee Gap Granite has a major local control on the
   hydrothermal alteration of this area. Hyperspectral data give
   implications on the influence of single intrusions on the
   Mesoproterozoic hydrothermal alteration of the Eastern Fold Belt, which
   was concurrent with the formation of major IOCGs in this area.},
Type = {Proceedings Paper},
Keywords = {Mount Isa Inlier; Williams Naraku Batholith; hydrothermal alteration;
   IOCG},
Keywords-Plus = {NORTHWEST QUEENSLAND; EVOLUTION; SYSTEM},
Research-Areas = {Geology; Mining \& Mineral Processing},
Cited-References = {Cudahy T, 2008, Commonwealth Scientific and Industrial Research Organization Report P2007/364, P2006, DOI {[}10.13140/RG.2.1.2828.1844, DOI 10.13140/RG.2.1.2828.1844].
