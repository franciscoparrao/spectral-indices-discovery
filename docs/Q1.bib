@article{ WOS:001709736400001,
Author = {Khebbi, Hicham and Lhachmi, Ali and Elbasbas, Abdelaziz and Sadki,
   Othman and Magoua, Mohamed and Himyari, Saloua Mnissar and Abouabila,
   Younes and Ibouh, Hassan and Alaoui, Ilham M'Hamdi},
Title = {Alteration and lineament mapping using PRISMA, ASTER, and Sentinel-2A to
   identify Cu mineralization in the ouarzazate group (Anti-Atlas, Morocco)},
Journal = {JOURNAL OF AFRICAN EARTH SCIENCES},
Year = {2026},
Volume = {238},
Month = {JUN},
Abstract = {The Marghout, Issougrid and Amane Tazougart sectors are located
   approximately 10 km southeast of the city of Ouarzazate, in the central
   Anti-Atlas. The analysis of hyperspectral PRISMA imagery has
   demonstrated the capability of satellite data to identify hydrothermal
   alterations associated with copper mineralization in the Ouarzazate
   region and to generate high-resolution mineral potential maps. Sentinel
   and ASTER data, combined with GIS techniques, have enabled precise
   mapping of tectonic lineaments. The adopted methodology combines ASTER,
   Sentinel-2A, and PRISMA satellite data with field spectroscopy to
   identify hydrothermal alteration minerals related to copper
   mineralization. After image corrections and processing, alteration and
   structural maps were produced. These results were validated through
   field, petrographic, and spectral analysis to evaluate the metallogenic
   potential. The lithology is mainly composed of Ediacaran volcanic rocks,
   dominated by andesites and rhyolites with minor ignimbrites and rare
   dioritic to microgranite intrusions. Frequent rhyolitic and andesitic
   dykes, along with volcano-detrital interbeds, reflect intermittent
   volcanic activity. These formations are affected by brittle deformation
   along NE-SW, ESE-WNW, and N-S trends, and host copper mineralization
   occurring as disseminations and veinlets within the andesites. This work
   aims to investigate copper and silver mineralization through indirect
   approaches, particularly hyperspectral and multispectral imagery. The
   remote sensing results obtained from ASTER, Sentinel-2A, and PRISMA
   imagery were validated through comprehensive fieldwork and spectral
   analysis. The spectral features identified in the satellite data were
   cross-verified with field-acquired rock spectra and compared against
   reference spectra from the USGS spectral library. This integrated
   approach demonstrates the high reliability of combining multispectral
   datasets with hyperspectral data for mineral exploration. It further
   emphasizes the strong potential of these remote sensing techniques for
   detecting hydrothermal alterations and guiding mineral exploration in
   the remote and rugged terrains of the Central Anti-Atlas belt.},
Type = {Article},
DOI = {10.1016/j.jafrearsci.2026.106064},
Article-Number = {106064},
Keywords = {PRISMA; ASTER; Sentinel-2a; Mining exploration; Mineral alteration;
   Lineaments; Anti-Atlas central; Volcano-sedimentary; Morocco},
