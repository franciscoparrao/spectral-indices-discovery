@article{ WOS:001335666600001,
Author = {Khedr, Mohamed Zaki and Ghoneim, Mohamed H. and Hagag, Weal and
   Hauzenberger, Christoph and Tamura, Akihiro and Ichiyama, Yuji and
   Takazawa, Eiichi and Kahal, Ali Y. and Abdelrahman, Kamal and Zamzam,
   Sara and Morishita, Tomoaki and El-Awady, Amr},
Title = {Petrogenesis and tectonic evolution of mineralized mafic intrusions in
   the Eastern Desert of Egypt: Implications for gold-sulfide genesis},
Journal = {ORE GEOLOGY REVIEWS},
Year = {2024},
Volume = {173},
Month = {OCT},
Abstract = {The whole-rock chemistry, mineral chemistry, and remote sensing data of
   the Atud-Um Khasila Neoproterozoic mafic intrusions in the Eastern
   Desert of Egypt show two different mafic plutons: (1) the
   metagabbro-diorite complex; and (2) the G. Atud gabbros. Both of these
   contain two types of Cu-Ni-Fe-sulfide mineralizations. Multispectral
   remotely sensed images of Landsat 8 OLI/TIRS, Sentinel 2-B, and ASTER1T
   were used to give an overview of hydrothermal alteration signatures and
   distinguish different lithological units. The G. Atud gabbros are
   intruded into the metagabbro-diorite complex and consist mainly of
   olivine gabbros, while the metagabbro-diorite complex comprises
   metagabbros, diorites, and quartz diorites. They were formed under high
   fO(2) (Delta FMQ= +1.43 to + 0.33) with a higher crystallization
   temperature (similar to 900-1100 degrees C) and pressure (similar to 6.0
   kbar on average) at 18 km depth relative to associated metagabbros. Like
   magmatic sulfides in mafic intrusions, the G. Atud gabbros contain
   disseminated grains of pyrrhotite, pentlandite, chalcopyrite, and
