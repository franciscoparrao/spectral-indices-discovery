@article{ WOS:001517293500001,
Author = {Ghoneim, Sobhi M. and Wang, Changcheng and Abdelrahman, Kamal and Ali,
   Hala F.},
Title = {Mapping alteration zones at Kab Amiri area, Egypt: New insights from the
   EnMAP hyperspectral satellite data},
Journal = {JOURNAL OF AFRICAN EARTH SCIENCES},
Year = {2025},
Volume = {228},
Month = {AUG},
Abstract = {This study demonstrates the capabilities of the Environmental Mapping
   and Analysis Program (EnMAP) German hyperspectral satellite in
   hydrothermal alteration mapping. Several techniques were employed to
   improve the retrieval accuracy of surface reflectance from EnMAP level
   2A data. These included eliminating bad bands, reducing spatial noise,
   and spectral smoothing using Savitzky-Golay filtering. The enhancements
   improved the interpretability of the EnMAP-derived spectral profiles
   leading to more accurate mineral identification and delineation.
   Advanced processing techniques were adopted involving intense spectral
   analyses, minimum wavelength mapping, and deciphering mixed pixel
   spectra based on the depths of absorption at relevant wavelengths.
   Various data clusters with deep absorption features were retrieved over
   the entire EMAP data range from 420 to 2450 nm. Data clusters at
   critical wavelengths were linked to diagnostic alteration minerals such
   as muscovite at 2200 and 2345 nm, epidote and chlorite at 2345 and 2255
   nm, kaolinite at 2200 and 2165 nm, goethite at 500 nm, and actinolite at
   2314 nm. Additionally, the interactive 2D scatter plots were employed
   effectively to decipher minerals in mixed-pixel spectra using the
   critical spectral parameters of the mixture components. The mineral
   mixtures in the study area included muscovite-chlorite,
   epidote-chlorite, and kaolinitechlorite. Several highly potential
   mineralized localities were highlighted within the investigated case
   study area. The findings were validated by correlation against the known
   mineralization sites, fieldwork and lab spectroscopic analyses,
   demonstrating the EnMAP's data potential for precise and efficient
   mineral exploration.},
Type = {Article},
DOI = {10.1016/j.jafrearsci.2025.105666},
EarlyAccessDate = {MAY 2025},
Article-Number = {105666},
Keywords = {EnMAP hyperspectral data; Minimum wavelength mapping; Alteration zones;
   Kab Amiri; Egypt},
