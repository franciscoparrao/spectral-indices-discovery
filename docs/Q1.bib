@article{ WOS:001432228000001,
Author = {Siagne, Ziandjede Herve and Kouamelan, Alain Nicaise and Digbeu,
   Wilfried and Aifa, Tahar and Houssou, N'Guessan Nestor and N'dri, Koffi
   Alexis and Gbele, Ouattara},
Title = {Integration of airborne gamma-ray spectrometry and remote sensing data
   for mapping of gold-bearing structures in the Doropo region,
   Northeastern Côte d'Ivoire (Southern part of West African Craton)},
Journal = {ALL EARTH},
Year = {2025},
Volume = {37},
Number = {1},
Pages = {1-14},
Month = {DEC 31},
Abstract = {The integration of airborne gamma-ray spectrometry (AGRS) and remote
   sensing data into geographic information systems during this study,
   carried out in the Doropo region, aims to identify and characterise the
   prospective zones of gold potential. The analysis of these different
   datasets showed good results on the probable new gold mineralisation
   location. Furthermore, the Landsat 8 OLI data processing highlighted
   mainly structural trends oriented NW-SE, NE-SW and E-W, which were
   recognised in the field as fractures, shear zones and faults. Recent
   AGRS has shown that the lithologies of the area exhibit high enrichment
   in potassium (K) and medium to low in thorium (Th) and uranium (U). The
   hydrothermal alteration areas defined from the K/eTh, F-parameter and
   ternary K-K/eTh-K/eU maps, can be correlated with both strongly or
   weakly magnetic bodies and known gold occurrences in the Doropo region.
   These alteration zones straddle deeply rooted structures such as faults,
   shear zones and fractures. All these planar structures are oriented
   NW-SE, NE-SW and E-W. The correlation between these geological
   structures and delineated alterations suggests that gold mineralisation
   in the northeast C \& ocirc;te d'Ivoire are structurally controlled and
   provided new targets for gold potential that might be thoroughly
   explored in future exploration activities.},
Type = {Article},
DOI = {10.1080/27669645.2025.2465074},
