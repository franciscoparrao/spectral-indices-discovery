@incollection{ WOS:000177297200225,
Author = {Cudahy, TJ and Wilson, J and Hewson, R and Linton, P and Harris, P and
   Sears, M and Okada, K and Hackwell, JA},
Book-Group-Author = {IEEE
   IEEE},
Title = {Mapping variations in plagioclase felspar mineralogy using airborne
   hyperspectral TIR imaging data},
Booktitle = {IGARSS 2001: SCANNING THE PRESENT AND RESOLVING THE FUTURE, VOLS 1-7,
   PROCEEDINGS},
Series = {IEEE International Symposium on Geoscience and Remote Sensing (IGARSS)},
Year = {2001},
Pages = {730-732},
Abstract = {The Na-Ca chemistry of plagioclase felspar was measured and mapped
   remotely using airborne hyperspectral thermal infrared (TIR) SEBASS
   image data collected from a well-exposed porphyry system near Yerington,
   Nevada. This followed correction of the airborne SEBASS data for
   instrument and atmospheric effects and temperature-emissivity separation
   and was validated through associated field and laboratory studies. The
   later found a linear correlation between the relative intensities of the
   plagioclase muFTIR emissivity spectral features at 9.6 and 10.0 mum and
   the XRD dspacing of the felspar 111/130 hk1 reflection, both of which
   are sensitive to the Na-Ca chemistry of plagioclase. The SEBASS derived
   felspar mineralogy maps clearly show variations in Na-Ca plagioclase
   felspar chemistry related to the nature of the host rock and any
   superimposed hydrothermal alteration.},
