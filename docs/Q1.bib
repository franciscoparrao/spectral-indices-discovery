@incollection{ WOS:000425944200052,
Author = {Laakso, K. and Peter, J. M. and Rivard, B. and Gloaguen, R.},
Book-Group-Author = {IEEE},
Title = {COMBINED HYPERSPECTRAL AND LITHOGEOCHEMICAL ESTIMATION OF ALTERATION
   INTENSITIES IN A VOLCANOGENIC MASSIVE SULFIDE DEPOSIT HYDROTHERMAL
   SYSTEM: A CASE STUDY FROM NORTHERN CANADA},
Booktitle = {2016 8TH WORKSHOP ON HYPERSPECTRAL IMAGE AND SIGNAL PROCESSING:
   EVOLUTION IN REMOTE SENSING (WHISPERS)},
Year = {2016},
Abstract = {The most intense hydrothermally altered rocks in volcanogenic massive
   sulfide (VMS) deposit systems occur in the stratigraphically underlying
   feeder zone and rocks immediately adjacent to mineralization. This
   alteration zone is typically much larger than the mineralization itself,
   and hence the ability to detect such alteration by optical remote
   sensing can be invaluable for mineral exploration. Our investigation
   focuses on assessing the applicability of hyperspectral data to
   determine trends in hydrothermal alteration intensity in and around the
   Izok Lake VMS deposit in northern Canada. To this end, we linked
   hydrothermal alteration intensity information based on two indices, the
   Ishikawa (AI) and chlorite-carbonate-pyrite (CCPI), to hyperspectral
   field and laboratory data in three dimensions. Our results suggest that
   chlorite group minerals display variable chemical composition across the
   study area that broadly correlates with hydrothermal alteration
   intensity.},
Type = {Proceedings Paper},
Keywords = {Hyperspectral; VMS; hydrothermal; alteration index; mineral exploration},
Research-Areas = {Physical Geography; Remote Sensing},
Cited-References = {Barrett T.J., 1994, Alteration and alteration processes associated with ore-forming systems, P433.
