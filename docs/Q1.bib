@article{ WOS:001546308400001,
Author = {Motlagh, Mohammad Javad Nekoee and Mojeddifar, Saeed and Soltani, Faraz},
Title = {Identifying Areas of High Potential Feldspar Deposit Using ASTER Data in
   the Delijan Area, Markazi Province, Iran},
Journal = {MINING METALLURGY \& EXPLORATION},
Year = {2025},
Volume = {42},
Number = {5, SI},
Pages = {3351-3362},
Month = {OCT},
Abstract = {Sodium-rich feldspars may be regarded as valuable resources. Argillic
   alteration is a key exploratory indicator for feldspar deposits.
   Argillic zones are a sort of hydrothermal alteration resulting from the
   chemical weathering of feldspars. This alteration is characterized by
   clay indicator minerals like illite and kaolinite. The discovery of
   argillic alterations can serve as an exploratory signal for feldspar
   reserves, and their detection is feasible using satellite image
   processing. The research site is situated in Markazi province, east of
   Delijan city. This region constitutes a minor part of the Central Iran
   Zone and is situated beneath the Urmia-Dokhtar volcanic zone. The most
   significant alterations in the Delijan region comprise argillic,
   albitic, silicic, propylitic, jasperoid, and iron oxide. This study used
   ASTER satellite images to identify alterations. Various methods were
   employed to analyze the ASTER data, including selective principal
   component analysis (PCA), false color composition (FCC) and relative
   absorption depth (RBD). Remote sensing research indicated propylitic
   alteration in the northwest and argillic alteration in the eastern
   section of the Sineqan region. To validate the results, a site visit and
   XRD studies confirmed these alterations.},
Type = {Article},
DOI = {10.1007/s42461-025-01324-y},
EarlyAccessDate = {AUG 2025},
Keywords = {Remote sensing; ASTER; Feldspars; Argillic alteration; Delijan; Sineqan},
