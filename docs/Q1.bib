@article{ WOS:000286803000001,
Author = {Laukamp, Carsten and Cudahy, Thomas and Cleverley, James S. and Oliver,
   Nicholas H. S. and Hewson, Rob},
Title = {Airborne hyperspectral imaging of hydrothermal alteration zones in
   granitoids of the Eastern Fold Belt, Mount Isa Inlier, Australia},
Journal = {GEOCHEMISTRY-EXPLORATION ENVIRONMENT ANALYSIS},
Year = {2011},
Volume = {11},
Number = {1},
Pages = {3-24},
Month = {FEB},
Abstract = {Hyperspectral remote sensing data from the Eastern Fold Belt, Mount Isa
   Inlier, Australia were compared with petrographic and geochemical
   studies to map the spatial extension and compositional variations of
   Proterozoic granitoids and endoskarns as well as hydrothermal alteration
   patterns in adjoining metasedimentary successions.
   Detailed spatial analysis of spectral remote sensing data shows an
   almost circular alteration zoning in the Mallee Gap Granite, which was
   emplaced during a late phase of the Mesoproterozoic Williams event. A
   combination of hyperspectral images, such as white mica, kaolin and MgOH
   products, were used to map the alteration zoning. The formation of the
   endoskarn is presumably related to autometasomatism and interaction with
   fluids released from the country rocks during a late phase of the
   emplacement. The intrusion of the Mallee Gap Granite has only a local
   control on the hydrothermal alteration, but high potassic granites of
   the southern Mount Angelay Granite might have expelled oxidized
   mineralizing fluids and possibly had a major impact on regional scale
   alteration. Hyperspectral remote sensing data may be used to estimate
   the imprint of single igneous bodies on the Mesoproterozoic hydrothermal
   evolution of the Eastern Fold Belt and are important for the study of
   ore-forming hydrothermal processes in general.},
Type = {Article},
DOI = {10.1144/1467-7873/09-231},
Keywords = {Hyperspectral imaging; hydrothermal alteration; granitoids; Mount Isa
   Inlier; IOCG},
Keywords-Plus = {ANGELAY IGNEOUS COMPLEX; CLONCURRY DISTRICT; NW QUEENSLAND; NORTHWEST
