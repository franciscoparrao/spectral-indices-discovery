@article{ WOS:001440147700001,
Author = {Mahdi, Ali M. and Youssef, Ahmed M. and Gabr, Safwat S. and Diab, Hassan
   I. and Alarifi, Saad S. and Andras, Peter and Eldosouky, Ahmed M.},
Title = {Exploring potential mineral deposits: Integrating airborne magnetic and
   remote sensing data in North-eastern Desert, Egypt},
Journal = {ADVANCES IN SPACE RESEARCH},
Year = {2025},
Volume = {75},
Number = {6},
Pages = {4472-4489},
Month = {MAR 15},
Abstract = {This study demonstrates the effectiveness of integrating Magnetic and
   Advanced Spaceborne Thermal Emission and Reflection Radiometer (ASTER)
   remote sensing data to identify hydrothermal alteration zones and
   structural features associated with gold mineralization in Egypt's
   Fatira region. We employed the Center for Exploration-Targeting (CET)
   porphyry and grid enhancement methodologies on Magnetic data. Band
   ratios with constrained energy-minimization (CEM) techniques were
   applied to ASTER data. Newly identified altered zones are detected.
   Shuttle Radar Topography Mission-Digital Elevation Model (SRTM-DEM) data
   aids in locating regions conducive to mineralized hydrothermal fluid
   migration. Statistical analyses reveal predominant directional trends in
   the study area. Gold mineralization is linked to NE-trending severely
   fractured felsite dikes and contacts between granitic intrusions and
   highly sheared metavolcanic rocks. These findings resemble documented
   mineralized deposits, providing valuable insights for future mineral
   prospecting in the region and globally in areas with similar geological
   characteristics. Integrating aeromagnetic with ASTER remote sensing data
   in our study offers an approach to link surface potential zones of
   mineralogy with subsurface structures. This integration provides a
   detailed understanding of geology and enhances exploration in
   underexplored provinces. (c) 2024 COSPAR. Published by Elsevier B.V. All
   rights are reserved, including those for text and data mining, AI
   training, and similar technologies.},
Type = {Article},
DOI = {10.1016/j.asr.2024.12.043},
EarlyAccessDate = {MAR 2025},
Keywords = {Aeromagnetic; ASTER; band ratio; CET-porphy ry; alteration zones},
Keywords-Plus = {OROGENIC-GOLD DEPOSITS; AEROMAGNETIC DATA; CRUSTAL EVOLUTION;
   CONSTRAINTS; IMAGERY; AREA},
