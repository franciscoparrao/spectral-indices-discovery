@incollection{ WOS:000382974000041,
Author = {Pour, Amin Beiranvand and Hashim, Mazlan},
Editor = {Singh, M and Mansor, MF and Suparta, W and Bahari, SA and Shariff, ARM},
Title = {Regional Hydrothermal Alteration Mapping Using Landsat-8 Data},
Booktitle = {2015 INTERNATIONAL CONFERENCE ON SPACE SCIENCE AND COMMUNICATION
   (ICONSPACE)},
Series = {International Conference on Space Science and Communication},
Year = {2015},
Pages = {199-202},
Abstract = {This study presents the applicability of recently launched Landsat-8
   data for hydrothermal alteration and lithological mapping. Sar Cheshmeh
   copper mining district in the southeastern part of the Urumieh-Dokhtar
   volcanic belt, SE Iran has been selected as a case study. Several
   Red-green-Blue (RGB) color combination images and specialized band
   ratios were developed. Band ratios derived from image spectra (4/2, 6/7,
   5 and 10 in RGB) allows the identification of altered rocks,
   lithological units and vegetation. Fieldwork and laboratory analysis
   verified the image processing results. Thermal infrared bands of
   Landsat-8 significantly improved the quality and availability of thermal
   infrared remote sensing data for lithological mapping. The achievements
   of this investigation should have considerable implications for
   geologists to utilize Landsat-8 OLUTIRS data for geological purposes in
   the future.},
Type = {Proceedings Paper},
Keywords = {Landsat-8 data; Sar Cheshmeh copper mining district; ASTER; Hydrothermal
   alteration mapping},
Research-Areas = {Engineering; Telecommunications},
Cited-References = {Ariza A., 2013, LANDSAT DATA CONTINU, P3.
   Inzana J, 2003, J AFR EARTH SCI, V37, P59, DOI 10.1016/S0899-5362(03)00071-X.
   Pour A.B., 2011, Int. J. Phys. Sci, V6, P7657, DOI DOI 10.5897/IJPS11.417.
   Sabins FF, 1999, ORE GEOL REV, V14, P157, DOI 10.1016/S0169-1368(99)00007-4.},
Number-of-Cited-References = {4},
Times-Cited = {2},
