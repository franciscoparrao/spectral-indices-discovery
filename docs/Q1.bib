@article{ WOS:000500530100161,
Author = {Tripathi, Mahesh Kumar and Govil, H.},
Title = {Evaluation of AVIRIS-NG hyperspectral images for mineral identification
   and mapping},
Journal = {HELIYON},
Year = {2019},
