@incollection{ WOS:000251802300005,
Author = {Babovic, Vladan},
Editor = {Navarro, PG and Playan, E},
Title = {Data-driven knowledge discovery: Four roads to vegetation-induced
   roughness formulae},
Booktitle = {NUMERICAL MODELLING OF HYDRODYNAMICS FOR WATER RESOURCES},
Series = {Proceedings and Monographs in Engineering Water and Earth Sciences},
Year = {2008},
Pages = {77-94},
Abstract = {The paper describes the process of induction of equations for the
   description of vegetation-induced roughness from several angles.
   Firstly, it describes two approaches for obtaining theoretically
   well-founded analytical expressions for vegetation resistance. The first
   of the two is based on simplified assumptions for the vertical flow
   profile through and over vegetation, whereas the second is based on an
   analytical solution to the momentum balance for flow through and over
   vegetation. In addition to analytical expressions the paper also
   outlines a numerical 1-DV k-epsilon turbulence model which includes
   several important features related to influence plants exhibit on the
   flow. Last but not least, the paper presents a novel way of applying
   genetic programming to the results of the 1-DV model, in order to obtain
   an expression for roughness based on synthetic data. The resulting
   expressions are evaluated and compared with an independent data set of
   flume experiments.},
Type = {Proceedings Paper},
Keywords-Plus = {OPEN-CHANNEL FLOW; HYDRAULIC RESISTANCE},
