@article{ WOS:000875753800001,
Author = {Abel, Steve A. and Constantin, Andrei and Harvey, Thomas R. and Lukas,
   Andre},
Title = {Cosmic Inflation and Genetic Algorithms},
Journal = {FORTSCHRITTE DER PHYSIK-PROGRESS OF PHYSICS},
Year = {2023},
Volume = {71},
Number = {1},
Month = {JAN},
Abstract = {Large classes of standard single-field slow-roll inflationary models
   consistent with the required number of e-folds, the current bounds on
   the spectral index of scalar perturbations, the tensor-to-scalar ratio,
   and the scale of inflation can be efficiently constructed using genetic
   algorithms. The setup is modular and can be easily adapted to include
   further phenomenological constraints. A semi-comprehensive search for
   sextic polynomial potentials results in similar to
   O(300,000)\$\textbackslash{}sim \textbackslash{}mathcal \{O\}(300,000)\$
   viable models for inflation. The analysis of this dataset reveals a
   preference for models with a tensor-to-scalar ratio in the range 0.0001
   <= r <= 0.0004\$0.0001\textbackslash{}le r\textbackslash{}le 0.0004\$.
   We also consider potentials that involve cosine and exponential terms.
   In the last part we explore more complex methods of search relying on
   reinforcement learning and genetic programming. While reinforcement
   learning proves more difficult to use in this context, the genetic
   programming approach has the potential to uncover a multitude of viable
   inflationary models with new functional forms.},
Type = {Article},
DOI = {10.1002/prop.202200161},
EarlyAccessDate = {OCT 2022},
Keywords = {artificial intelligence; cosmic inflation; genetic algorithms},
Keywords-Plus = {UNIVERSE SCENARIO; FLUCTUATIONS; GENERATION; FLATNESS; HORIZON; MODELS},
Research-Areas = {Physics},
Cited-References = {AbdusSalam S, 2020, J HIGH ENERGY PHYS, DOI 10.1007/JHEP08(2020)047.
   Abel S., 2021, NANKAI S MATH DIALOG.
   Abel S., MATH PACKAGE GENETIC.
   Abel S., POWER GENETIC ALGORI.
   Abel S, 2022, FORTSCHR PHYS, V70, DOI 10.1002/prop.202200034.
