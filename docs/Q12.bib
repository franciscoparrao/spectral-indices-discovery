@article{ WOS:000289183300007,
Author = {Puente, Cesar and Olague, Gustavo and Smith, Stephen V. and Bullock,
   Stephen H. and Hinojosa-Corona, Alejandro and Gonzalez-Botello, Miguel
   A.},
Title = {A Genetic Programming Approach to Estimate Vegetation Cover in the
   Context of Soil Erosion Assessment},
Journal = {PHOTOGRAMMETRIC ENGINEERING AND REMOTE SENSING},
Year = {2011},
Volume = {77},
Number = {4},
Pages = {363-376},
Month = {APR},
Abstract = {This work describes a genetic programming (GP) approach that creates
   vegetation indices (VI's) to automatically detect the sum of healthy,
   dry, and dead vegetation. Nowadays, it is acknowledged that VI's are the
   most popular method for extracting vegetation information from satellite
   imagery. In particular, erosion models like the ``Revised Universal Soil
   Loss Equation{''} (RUSLE) can use VI's as input to measure the effects
   of the RUSLE soil cover factor (C). However, the results are generally
   incomplete, because most indices recognize only healthy vegetation. The
   aim of this study is to devise a novel approach for designing new VI's
   that are better correlated with C, using field and satellite
   information. Our approach consists on stating the problem in terms of
   optimization through GP learning, building novel indices by iteratively
   recombining a set of numerical operators and spectral channels until the
   best composite operator is found. Experimental results illustrate the
   efficiency and reliability of our approach in contrast with traditional
   indices like those of the NDVI and SA vi family. This study provides
   evidence that similar problems related to soil erosion assessment could
   be analyzed with our proposed methodology.},
Type = {Article},
DOI = {10.14358/PERS.77.4.363},
