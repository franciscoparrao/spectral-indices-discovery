@incollection{ WOS:000167110800115,
Author = {D'Addio, G and Pinna, GD and Maestri, R and Acanfora, D and Ranaudo, E
   and Furgi, G and Rengo, F},
Book-Group-Author = {IEEE
   IEEE},
Title = {Changes induced by tilting on Poincare plots and symbolic dynamic
   patterns of HRV compared to spectral indexes in post-MI and normal
   subjects},
Booktitle = {COMPUTERS IN CARDIOLOGY 2000, VOL 27},
Series = {Computers in Cardiology Series},
Year = {2000},
Volume = {27},
Pages = {449-452},
Abstract = {Short-term HRV analysis in supine and tilting conditions is commonly
   performed using linear methods. while nonlinear techniques are usually
   applied to longterm time series.
   We investigated in post-MI patients and normal subjects the changes
   induced by tilting on quantitative indexes derived from Poincare plots
   and symbolic dynamics patterns and compared these changes to those
   observed using classical spectral parameters.
   We found that Poincare indexes provide move sensitive information than
   spectral indexes in the assessment of changes of cardiac autonomic
   outflow following the tilting maneuver in post-MI patients and although
   symbolic dynamics indexes were not able to detect these changes, they
   clearly indicated a structurally different pattern of HRV between normal
   and pathological subjects.},
Type = {Proceedings Paper},
DOI = {10.1109/CIC.2000.898554},
Keywords-Plus = {HEART-RATE-VARIABILITY; FAILURE},
